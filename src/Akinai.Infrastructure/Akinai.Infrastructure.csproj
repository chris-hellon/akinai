<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akinai.Domain\Akinai.Domain.csproj" />
    <ProjectReference Include="..\Akinai.Shared\Akinai.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.38.0" />
    <PackageReference Include="BlazorUtils.EasyApi" Version="2.2.0" />
    <PackageReference Include="BlazorUtils.EasyApi.Server" Version="2.2.0" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="PuppeteerSharp" Version="25.3.4" />
    <PackageReference Include="QuestPDF" Version="2024.12.2" />
    <PackageReference Include="Stripe.net" Version="52.1.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.14" />
    <!--
      Not used directly. Microsoft.Data.SqlClient, which arrives via EF Core's SQL Server
      provider, depends on 9.0.11 — a version carrying two advisories, one of them high
      severity (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). A direct reference is the only
      way to lift a transitive dependency, and this is the one package left that needed it
      after the move off RC1.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\Modal\" />
  </ItemGroup>

  <!-- PDF fonts are fetched, not committed (see ../fetch-fonts.sh). The script
       skips files it already has, so this is a no-op after the first build.
       ContinueOnError: a developer with no network still gets a working build,
       just an English-only PDF. -->
  <Target Name="FetchPdfFonts" BeforeTargets="BeforeBuild">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../fetch-fonts.sh&quot; &quot;$(MSBuildThisFileDirectory)Fonts&quot;" ContinueOnError="true" Condition="'$(OS)' != 'Windows_NT'" />
  </Target>

  <ItemGroup>
    <None Include="Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
