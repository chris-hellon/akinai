@page "/bank-import"

@inject ICall<ImportBankStatement, ImportResultDto> ImportStatementCall
@inject ICall<GetBankTransactions, PaginatedResponse<BankTransactionDto>> GetTransactionsCall
@inject ICall<MatchTransaction> MatchTransactionCall
@inject ICall<IgnoreTransaction> IgnoreTransactionCall
@inject ICall<GetSuggestedMatches, List<TransactionMatchDto>> GetSuggestionsCall
@inject ICall<CreateExpenseFromTransaction, Guid> CreateExpenseFromTransactionCall
@inject ICall<GetClients, PaginatedResponse<ClientDto>> GetClientsCall
@inject ICall<GetProjects, PaginatedResponse<ProjectDto>> GetProjectsCall
@inject ICall<GetMatchableInvoices, List<InvoiceOptionDto>> GetMatchableInvoicesCall
@inject ICall<DeleteBankTransaction> DeleteBankTransactionCall
@inject ICall<ClearBankTransactions, int> ClearBankTransactionsCall
@inject ICall<GetBankTransactionCurrencies, List<string>> GetCurrenciesCall
@inject NavigationManager Nav

<PageTitle>Bank Import - Akinai</PageTitle>

<PlanGate Feature="@(e => e.BankImport)"
          Title="Bank import is a Pro feature"
          Description="Import a bank statement and Akinai lines each transaction up against your open invoices.">
    <div class="space-y-6">
        <PageHeader Title="Bank Import"
                    Description="Import bank statements and match transactions to invoices."
                    Breadcrumbs="@(new List<PageHeader.BreadcrumbItem> { new("Finance", "/finance"), new("Bank Import") })">
            <Actions>
                @if (_response is { TotalCount: > 0 })
                {
                    <button type="button" @onclick="ClearTransactionsAsync"
                            class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-gray-600 dark:text-slate-300 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-600 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-700 hover:border-gray-300 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        @(HasActiveFilters ? "Delete filtered" : "Delete all")
                    </button>
                }
                <label class="cursor-pointer">
                    <InputFile OnChange="HandleFileUpload" accept=".csv,.tsv,.txt,.ofx,.qfx,.xls,.xlsx,.xlsm" class="hidden" disabled="@_isUploading" />
                    <span class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-xl transition-colors @(_isUploading ? "opacity-60 cursor-not-allowed" : "")">
                        @if (_isUploading)
                        {
                            <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                            <span>Importing…</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                            </svg>
                            <span>Import Statement</span>
                        }
                    </span>
                </label>
            </Actions>
        </PageHeader>


        @if (_importResult != null)
        {
            <Card>
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-10 h-10 bg-emerald-100 dark:bg-emerald-900/30 rounded-xl flex items-center justify-center">
                        <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100">Import Complete</h3>
                        <div class="mt-2 grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
                            <div>
                                <span class="text-gray-500 dark:text-slate-400">Total:</span>
                                <span class="ml-1 font-medium text-gray-900 dark:text-slate-100">@_importResult.TotalTransactions</span>
                            </div>
                            <div>
                                <span class="text-gray-500 dark:text-slate-400">Imported:</span>
                                <span class="ml-1 font-medium text-emerald-600 dark:text-emerald-400">@_importResult.ImportedTransactions</span>
                            </div>
                            <div>
                                <span class="text-gray-500 dark:text-slate-400">Auto-matched:</span>
                                <span class="ml-1 font-medium text-primary-600 dark:text-primary-400">@_importResult.AutoMatchedTransactions</span>
                            </div>
                            <div>
                                <span class="text-gray-500 dark:text-slate-400">Skipped:</span>
                                <span class="ml-1 font-medium text-gray-600 dark:text-slate-400">@_importResult.SkippedDuplicates</span>
                            </div>
                        </div>
                        @if (_importResult.Errors.Any())
                        {
                            <div class="mt-3 p-3 bg-red-50 dark:bg-red-900/20 rounded-lg">
                                <p class="text-sm font-medium text-red-700 dark:text-red-400">Errors:</p>
                                <ul class="mt-1 list-disc list-inside text-sm text-red-600 dark:text-red-400">
                                    @foreach (var error in _importResult.Errors.Take(5))
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    <button @onclick="() => _importResult = null" class="text-gray-400 hover:text-gray-600 dark:hover:text-slate-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </Card>
        }

        <!-- Filters -->
        <SearchBar Placeholder="Search transactions..." Value="@_searchTerm" ValueChanged="OnSearchChanged">
            <DatePicker TValue="DateOnly?" Value="_fromDate" ValueChanged="OnFromDateChanged" Placeholder="From date" Class="w-full sm:w-40" />
            <DatePicker TValue="DateOnly?" Value="_toDate" ValueChanged="OnToDateChanged" Placeholder="To date" Class="w-full sm:w-40" />
            <Select TValue="string" Value="_selectedStatus" ValueChanged="OnStatusChanged" Searchable="false" Class="w-full sm:w-44"
                    Options="@(new List<SelectOption<string>> {
                        new("", "All Status"),
                        new("unmatched", "Needs review"),
                        new("matched", "Matched to invoice"),
                        new("expense", "Recorded as expense"),
                        new("ignored", "Ignored")
                    })" />
            <Select TValue="string" Value="_selectedDirection" ValueChanged="OnDirectionChanged" Searchable="false" Class="w-full sm:w-36"
                    Options="@(new List<SelectOption<string>> {
                        new("", "In & out"),
                        new("in", "Money in"),
                        new("out", "Money out")
                    })" />
            @if (_currencies.Count > 1)
            {
                <Select TValue="string" Value="_selectedCurrency" ValueChanged="OnCurrencyChanged" Searchable="false" Class="w-full sm:w-40"
                        Options="@(new List<SelectOption<string>> { new("", "All currencies") }.Concat(_currencies.Select(c => new SelectOption<string>(c, c))).ToList())" />
            }
        </SearchBar>

        @if (_isLoading)
        {
            <LoadingTable Rows="5" Columns="6" />
        }
        else if (_response == null || !_response.Items.Any())
        {
            <EmptyState Title="No transactions found"
                        Message="@(HasActiveFilters ? "No transactions match your filters." : "Import a bank statement to get started.")"
                        IconType="EmptyState.EmptyStateIcon.Briefcase" />
        }
        else
        {
            <DataTable TItem="BankTransactionDto"
                       Items="_response.Items"
                       CurrentPage="_response.Page"
                       TotalCount="_response.TotalCount"
                       PageSize="_response.PageSize"
                       ItemName="transactions"
                       OnPageChanged="OnPageChanged"
                       OnPageSizeChanged="OnPageSizeChanged">
                <HeaderTemplate>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Date</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Description</th>
                    <th scope="col" class="px-6 py-4 text-right text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Amount</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Match</th>
                    <th scope="col" class="relative px-6 py-4"><span class="sr-only">Actions</span></th>
                </HeaderTemplate>
                <RowTemplate Context="transaction">
                    <tr class="group hover:bg-gray-50/50 dark:hover:bg-[#2f2924]/50 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-gray-900 dark:text-slate-100">@transaction.TransactionDate.ToString("MMM d, yyyy")</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm text-gray-900 dark:text-slate-100 max-w-xs truncate">@transaction.Description</div>
                            @if (!string.IsNullOrEmpty(transaction.Reference))
                            {
                                <div class="text-xs text-gray-500 dark:text-slate-400">Ref: @transaction.Reference</div>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            <span class="text-sm font-semibold @(transaction.Amount >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                @(transaction.Amount >= 0 ? "+" : "")@CurrencyExtensions.GetSymbol(transaction.Currency)@transaction.Amount.ToString("N2")
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (transaction.IsIgnored)
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-400">Ignored</span>
                            }
                            else if (transaction.IsMatched)
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">Matched</span>
                            }
                            else if (transaction.IsExpensed)
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-primary-50 text-primary-700 dark:bg-primary-900/30 dark:text-primary-400">Expense</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">Needs review</span>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (transaction.IsExpensed && transaction.ExpenseId.HasValue)
                            {
                                <a href="@($"expenses/{transaction.ExpenseId}")" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">View expense</a>
                            }
                            else if (transaction.IsMatched && !string.IsNullOrEmpty(transaction.MatchedInvoiceNumber))
                            {
                                <a href="@($"invoices/{transaction.MatchedInvoiceId}")" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">
                                    @transaction.MatchedInvoiceNumber
                                </a>
                                @if (!string.IsNullOrEmpty(transaction.MatchConfidence))
                                {
                                    <span class="ml-1 text-xs text-gray-500 dark:text-slate-400">(@transaction.MatchConfidence)</span>
                                }
                            }
                            else if (transaction.IsIgnored && !string.IsNullOrEmpty(transaction.IgnoreReason))
                            {
                                <span class="text-xs text-gray-500 dark:text-slate-400">@transaction.IgnoreReason</span>
                            }
                            else
                            {
                                <span class="text-sm text-gray-400 dark:text-slate-500">-</span>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            <div class="flex items-center justify-end gap-1">
                                @if (!transaction.IsMatched && !transaction.IsIgnored && !transaction.IsExpensed)
                                {
                                    @if (transaction.Amount < 0)
                                    {
                                        <IconButton OnClick="() => ShowExpenseModal(transaction)" Title="Record as expense">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                                            </svg>
                                        </IconButton>
                                    }
                                    else
                                    {
                                        <IconButton OnClick="() => ShowMatchModal(transaction)" Title="Match to invoice">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                                            </svg>
                                        </IconButton>
                                    }
                                    <IconButton OnClick="() => IgnoreTransactionAsync(transaction)" Title="Ignore">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                        </svg>
                                    </IconButton>
                                }
                                <IconButton OnClick="() => DeleteTransactionAsync(transaction)" Variant="IconButton.IconButtonVariant.Danger" Title="Delete">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </IconButton>
                            </div>
                        </td>
                    </tr>
                </RowTemplate>
                <CardTemplate Context="transaction">
                    <div class="p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-sm font-semibold text-gray-900 dark:text-slate-100 truncate">@transaction.Description</span>
                                    @if (transaction.IsIgnored)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-400">Ignored</span>
                                    }
                                    else if (transaction.IsMatched)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">Matched</span>
                                    }
                                    else if (transaction.IsExpensed)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-primary-50 text-primary-700 dark:bg-primary-900/30 dark:text-primary-400">Expense</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">Needs review</span>
                                    }
                                </div>
                                <div class="mt-1 text-xs text-gray-500 dark:text-slate-400">
                                    @transaction.TransactionDate.ToString("MMM d, yyyy")
                                    @if (!string.IsNullOrEmpty(transaction.Reference))
                                    {
                                        <span> &middot; Ref: @transaction.Reference</span>
                                    }
                                </div>
                                @if (transaction.IsMatched && !string.IsNullOrEmpty(transaction.MatchedInvoiceNumber))
                                {
                                    <div class="mt-1 text-xs">
                                        <a href="@($"invoices/{transaction.MatchedInvoiceId}")" class="text-primary-600 dark:text-primary-400 hover:underline">@transaction.MatchedInvoiceNumber</a>
                                        @if (!string.IsNullOrEmpty(transaction.MatchConfidence))
                                        {
                                            <span class="ml-1 text-gray-500 dark:text-slate-400">(@transaction.MatchConfidence)</span>
                                        }
                                    </div>
                                }
                                else if (transaction.IsIgnored && !string.IsNullOrEmpty(transaction.IgnoreReason))
                                {
                                    <div class="mt-1 text-xs text-gray-500 dark:text-slate-400">@transaction.IgnoreReason</div>
                                }
                            </div>
                            <div class="text-right shrink-0">
                                <div class="text-base font-semibold @(transaction.Amount >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                    @(transaction.Amount >= 0 ? "+" : "")@CurrencyExtensions.GetSymbol(transaction.Currency)@transaction.Amount.ToString("N2")
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-gray-50 dark:border-[#2f2924] flex items-center justify-end gap-1">
                            @if (!transaction.IsMatched && !transaction.IsIgnored && !transaction.IsExpensed)
                            {
                                @if (transaction.Amount < 0)
                                {
                                    <button @onclick="() => ShowExpenseModal(transaction)" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-primary-700 dark:text-primary-300 bg-primary-50 dark:bg-primary-900/30 rounded-lg">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
                                        Record expense
                                    </button>
                                }
                                else
                                {
                                    <button @onclick="() => ShowMatchModal(transaction)" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-primary-700 dark:text-primary-300 bg-primary-50 dark:bg-primary-900/30 rounded-lg">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                                        Match invoice
                                    </button>
                                }
                                <IconButton OnClick="() => IgnoreTransactionAsync(transaction)" Title="Ignore">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                    </svg>
                                </IconButton>
                            }
                            <IconButton OnClick="() => DeleteTransactionAsync(transaction)" Variant="IconButton.IconButtonVariant.Danger" Title="Delete">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </IconButton>
                        </div>
                    </div>
                </CardTemplate>
            </DataTable>
        }
    </div>
</PlanGate>

<!-- Match Modal -->
@if (_showMatchModal && _selectedTransaction != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-500/75 dark:bg-slate-900/75 transition-opacity" @onclick="CloseMatchModal"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative w-full max-w-2xl overflow-hidden text-left bg-white dark:bg-slate-800 shadow-xl rounded-lg">
                <div class="px-6 py-5 border-b border-gray-100 dark:border-slate-700">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Match Transaction</h3>
                    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">
                        @_selectedTransaction.Description - @CurrencyExtensions.GetSymbol(_selectedTransaction.Currency)@_selectedTransaction.Amount.ToString("N2")
                    </p>
                </div>

                <div class="px-6 py-4 space-y-4">
                    @if (_isLoadingSuggestions)
                    {
                        <div class="flex justify-center py-8">
                            <LoadingSpinner />
                        </div>
                    }
                    else
                    {
                        @if (_suggestions.Any())
                        {
                            <div>
                                <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wide mb-2">Suggested matches</p>
                                <div class="space-y-2 max-h-56 overflow-y-auto">
                                    @foreach (var suggestion in _suggestions)
                                    {
                                        <button @onclick="() => MatchToInvoiceAsync(suggestion.InvoiceId)"
                                                class="w-full p-3 text-left bg-gray-50 dark:bg-slate-700 hover:bg-gray-100 dark:hover:bg-slate-600 rounded-xl transition-colors">
                                            <div class="flex items-start justify-between gap-3">
                                                <div class="min-w-0">
                                                    <div class="flex items-center gap-2">
                                                        <span class="font-medium text-gray-900 dark:text-slate-100">@suggestion.InvoiceNumber</span>
                                                        <span class="px-2 py-0.5 text-xs rounded-full @GetConfidenceClass(suggestion.MatchConfidence)">@suggestion.MatchConfidence</span>
                                                    </div>
                                                    <p class="text-sm text-gray-600 dark:text-slate-400 truncate">@suggestion.ClientName</p>
                                                </div>
                                                <div class="text-right shrink-0">
                                                    <p class="font-semibold text-gray-900 dark:text-slate-100">@CurrencyExtensions.GetSymbol(suggestion.Currency)@suggestion.InvoiceTotal.ToString("N2")</p>
                                                    <p class="text-xs text-gray-500 dark:text-slate-400">Due @suggestion.DueDate.ToString("MMM d")</p>
                                                </div>
                                            </div>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        <div>
                            <p class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wide mb-2">Or match to any invoice</p>
                            @if (_matchableInvoices.Any())
                            {
                                <Select TValue="Guid?" @bind-Value="_selectedMatchInvoiceId" Placeholder="Search for an invoice…"
                                        Options="@(_matchableInvoices.Select(inv => new SelectOption<Guid?>(inv.Id, $"{inv.InvoiceNumber} · {inv.ClientName}", $"{CurrencyExtensions.GetSymbol(inv.Currency)}{inv.Total:N2} · {inv.Status}")).ToList())" />
                                <label class="flex items-center gap-2 mt-3 cursor-pointer select-none">
                                    <input type="checkbox" checked="@_markInvoicePaid" @onchange="e => _markInvoicePaid = e.Value is true" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                                    <span class="text-sm text-gray-700 dark:text-slate-300">Mark this invoice as paid</span>
                                </label>
                            }
                            else
                            {
                                <p class="text-sm text-gray-500 dark:text-slate-400">No open invoices to match against.</p>
                            }
                        </div>
                    }
                </div>

                <div class="px-6 py-4 bg-gray-50 dark:bg-slate-700/50 flex justify-end gap-3">
                    <button type="button" @onclick="CloseMatchModal" class="btn-secondary">Cancel</button>
                    <button type="button" @onclick="MatchSelectedInvoiceAsync" disabled="@(_selectedMatchInvoiceId is null)"
                            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-xl transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                        Match invoice
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Expense Modal -->
@if (_showExpenseModal && _selectedTransaction != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-500/75 dark:bg-slate-900/75 transition-opacity" @onclick="CloseExpenseModal"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative w-full max-w-lg overflow-visible text-left bg-white dark:bg-slate-800 shadow-xl rounded-lg">
                <div class="px-6 py-5 border-b border-gray-100 dark:border-slate-700">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">Record as expense</h3>
                    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">
                        @_selectedTransaction.Description &middot; @CurrencyExtensions.GetSymbol(_selectedTransaction.Currency)@Math.Abs(_selectedTransaction.Amount).ToString("N2") &middot; @_selectedTransaction.TransactionDate.ToString("MMM d, yyyy")
                    </p>
                </div>
                <div class="px-6 py-5 space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Category</label>
                        <Select TValue="string" @bind-Value="_expenseCategory" Options="@_categoryOptions" />
                    </div>
                    <label class="flex items-center gap-3 cursor-pointer select-none">
                        <input type="checkbox" checked="@_expenseBillable" @onchange="OnBillableToggled" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                        <span class="text-sm font-medium text-gray-700 dark:text-slate-300">Billable to a client</span>
                    </label>
                    @if (_expenseBillable)
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Client</label>
                                <Select TValue="Guid?" Value="_expenseClientId" ValueChanged="OnExpenseClientChanged" Placeholder="Select client"
                                        Options="@(_clients.Select(c => new SelectOption<Guid?>(c.Id, c.Name)).ToList())" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Project</label>
                                <Select TValue="Guid?" @bind-Value="_expenseProjectId" Placeholder="No project"
                                        Options="@(new List<SelectOption<Guid?>> { new(null, "No project") }.Concat(_projects.Where(p => p.ClientId == _expenseClientId).Select(p => new SelectOption<Guid?>(p.Id, p.Name))).ToList())" />
                            </div>
                        </div>
                    }
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Notes</label>
                        <textarea @bind="_expenseNotes" rows="2" class="form-control resize-none" placeholder="Optional notes…"></textarea>
                    </div>
                </div>
                <div class="px-6 py-4 bg-gray-50 dark:bg-slate-700/50 flex justify-end gap-3">
                    <button type="button" @onclick="CloseExpenseModal" class="btn-secondary">Cancel</button>
                    <button type="button" @onclick="CreateExpenseAsync" disabled="@_isSavingExpense"
                            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-xl transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
                        @if (_isSavingExpense)
                        {
                            <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                        }
                        Create expense
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<ErrorAlert Message="@_errorMessage" />


@code {
    private PaginatedResponse<BankTransactionDto>? _response;
    private ImportResultDto? _importResult;
    private bool _isLoading = true;
    private bool _isUploading;
    private string _searchTerm = "";
    private string _selectedStatus = "";
    private string _selectedDirection = "";
    private string _selectedCurrency = "";
    private int _currentPage = 1;
    private int _pageSize = 50;
    private List<string> _currencies = new();
    private string? _errorMessage;

    private bool _showMatchModal;
    private BankTransactionDto? _selectedTransaction;
    private List<TransactionMatchDto> _suggestions = new();
    private bool _isLoadingSuggestions;
    private List<InvoiceOptionDto> _matchableInvoices = new();
    private Guid? _selectedMatchInvoiceId;
    private bool _markInvoicePaid = true;

    private DateOnly? _fromDate;
    private DateOnly? _toDate;

    // Expense modal
    // Bank connection (open banking)

    private bool _showExpenseModal;
    private bool _isSavingExpense;
    private string _expenseCategory = "Other";
    private string _expenseNotes = "";
    private bool _expenseBillable;
    private Guid? _expenseClientId;
    private Guid? _expenseProjectId;
    private List<ClientDto> _clients = new();
    private List<ProjectDto> _projects = new();

    private static readonly List<SelectOption<string>> _categoryOptions =
        Enum.GetValues<ExpenseCategory>()
            .Select(c => new SelectOption<string>(c.ToString(), c.GetDisplayName()))
            .ToList();

    private async Task ShowExpenseModal(BankTransactionDto transaction)
    {
        _selectedTransaction = transaction;
        _expenseCategory = ExpenseCategoryRules.Suggest(transaction.Description).ToString();
        _expenseNotes = "";
        _expenseBillable = false;
        _expenseClientId = null;
        _expenseProjectId = null;
        _errorMessage = null;
        _showExpenseModal = true;
        if (_clients.Count == 0)
            await LoadClientsAndProjects();
    }

    private async Task LoadClientsAndProjects()
    {
        try
        {
            var clients = await GetClientsCall.Call(new GetClients { Page = 1, PageSize = 1000, ActiveOnly = true });
            _clients = clients?.Items ?? new();
            var projects = await GetProjectsCall.Call(new GetProjects { Page = 1, PageSize = 1000 });
            _projects = projects?.Items ?? new();
        }
        catch { /* selects just stay empty */ }
    }

    private void OnBillableToggled(ChangeEventArgs e)
    {
        _expenseBillable = e.Value is true;
        if (!_expenseBillable) { _expenseClientId = null; _expenseProjectId = null; }
    }

    private void OnExpenseClientChanged(Guid? clientId)
    {
        _expenseClientId = clientId;
        _expenseProjectId = null;
    }

    private void CloseExpenseModal() => _showExpenseModal = false;

    private async Task CreateExpenseAsync()
    {
        if (_selectedTransaction is null) return;
        _isSavingExpense = true;
        _errorMessage = null;
        try
        {
            await CreateExpenseFromTransactionCall.Call(new CreateExpenseFromTransaction
            {
                Id = _selectedTransaction.Id,
                Category = _expenseCategory,
                Notes = string.IsNullOrWhiteSpace(_expenseNotes) ? null : _expenseNotes,
                IsBillable = _expenseBillable,
                ClientId = _expenseBillable ? _expenseClientId : null,
                ProjectId = _expenseBillable ? _expenseProjectId : null
            });
            _showExpenseModal = false;
            await LoadTransactions();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to create expense: {ex.Message}";
        }
        finally
        {
            _isSavingExpense = false;
        }
    }

    private bool HasActiveFilters => !string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_selectedStatus)
        || !string.IsNullOrEmpty(_selectedDirection) || !string.IsNullOrEmpty(_selectedCurrency)
        || _fromDate is not null || _toDate is not null;

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
        await LoadCurrencies();
    }

    private async Task LoadCurrencies()
    {
        try { _currencies = await GetCurrenciesCall.Call(new GetBankTransactionCurrencies()) ?? new(); }
        catch { _currencies = new(); }
    }

    private static string ConnStatusClass(string status) => status switch
    {
        "Linked" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
        "Pending" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
        "Expired" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
        "Error" => "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400",
        _ => "bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-400"
    };

    private async Task LoadTransactions()
    {
        _isLoading = true;
        try
        {
            // "Needs review" = not matched, not expensed, not ignored.
            bool? isMatched = _selectedStatus switch { "matched" => true, "unmatched" => false, _ => (bool?)null };
            bool? isExpensed = _selectedStatus switch { "expense" => true, "unmatched" => false, _ => (bool?)null };
            bool? isIgnored = _selectedStatus switch { "ignored" => true, "unmatched" => false, _ => (bool?)null };

            _response = await GetTransactionsCall.Call(new GetBankTransactions
            {
                Page = _currentPage,
                PageSize = _pageSize,
                Search = _searchTerm,
                IsMatched = isMatched,
                IsIgnored = isIgnored,
                IsExpensed = isExpensed,
                FromDate = _fromDate,
                ToDate = _toDate,
                Direction = string.IsNullOrEmpty(_selectedDirection) ? null : _selectedDirection,
                Currency = string.IsNullOrEmpty(_selectedCurrency) ? null : _selectedCurrency
            });
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load transactions: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        _isUploading = true;
        _errorMessage = null;
        try
        {
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            var format = extension switch
            {
                ".csv" or ".tsv" or ".txt" => "CSV",
                ".ofx" or ".qfx" => "OFX",
                ".xls" or ".xlsx" or ".xlsm" => "XLSX",
                _ => throw new Exception("Unsupported file format. Please upload a CSV, OFX/QFX, or Excel (.xls/.xlsx) file exported from your bank.")
            };

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            _importResult = await ImportStatementCall.Call(new ImportBankStatement
            {
                FileContent = ms.ToArray(),
                FileName = file.Name,
                FileFormat = format,
                Currency = "USD"
            });

            _currentPage = 1;
            await LoadTransactions();
            await LoadCurrencies();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to import statement: {ex.Message}";
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        _currentPage = 1;
        await LoadTransactions();
    }

    private async Task OnStatusChanged(string value)
    {
        _selectedStatus = value;
        await OnFilterChanged();
    }

    private async Task OnSearchChanged(string value)
    {
        _searchTerm = value;
        await OnFilterChanged();
    }

    private async Task OnDirectionChanged(string value)
    {
        _selectedDirection = value;
        await OnFilterChanged();
    }

    private async Task OnCurrencyChanged(string value)
    {
        _selectedCurrency = value;
        await OnFilterChanged();
    }

    private async Task OnPageSizeChanged(int value)
    {
        _pageSize = value;
        await OnFilterChanged();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadTransactions();
    }

    private async Task ShowMatchModal(BankTransactionDto transaction)
    {
        _selectedTransaction = transaction;
        _showMatchModal = true;
        _suggestions = new();
        _isLoadingSuggestions = true;
        _selectedMatchInvoiceId = null;
        _markInvoicePaid = true;

        try
        {
            _suggestions = await GetSuggestionsCall.Call(new GetSuggestedMatches { Id = transaction.Id });
            _matchableInvoices = await GetMatchableInvoicesCall.Call(new GetMatchableInvoices()) ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load invoices: {ex.Message}";
        }
        finally
        {
            _isLoadingSuggestions = false;
        }
    }

    private void CloseMatchModal()
    {
        _showMatchModal = false;
        _selectedTransaction = null;
    }

    private async Task MatchToInvoiceAsync(Guid invoiceId, bool markPaid = true)
    {
        if (_selectedTransaction == null) return;

        try
        {
            await MatchTransactionCall.Call(new MatchTransaction
            {
                Id = _selectedTransaction.Id,
                InvoiceId = invoiceId,
                MarkInvoiceAsPaid = markPaid
            });

            CloseMatchModal();
            await LoadTransactions();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to match transaction: {ex.Message}";
        }
    }

    private async Task MatchSelectedInvoiceAsync()
    {
        if (_selectedMatchInvoiceId is Guid id)
            await MatchToInvoiceAsync(id, _markInvoicePaid);
    }

    private async Task DeleteTransactionAsync(BankTransactionDto transaction)
    {
        try
        {
            await DeleteBankTransactionCall.Call(new DeleteBankTransaction { Id = transaction.Id });
            await LoadTransactions();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete transaction: {ex.Message}";
        }
    }

    private async Task ClearTransactionsAsync()
    {
        var scope = HasActiveFilters
            ? "all transactions matching the current filters"
            : "ALL imported transactions";
        var confirmed = await ModalService.ShowAsync<bool>(
            typeof(DeleteConfirmationModal),
            "Delete transactions",
            new Dictionary<string, object>
            {
                { "ItemName", scope },
                { "WarningMessage", "This permanently removes the bank transactions. Any invoices already marked paid or expenses already created stay as they are." }
            },
            new ModalOptions { Size = ModalSize.Small });
        if (!confirmed) return;

        try
        {
            await ClearBankTransactionsCall.Call(new ClearBankTransactions
            {
                FromDate = _fromDate,
                ToDate = _toDate,
                Status = string.IsNullOrEmpty(_selectedStatus) ? null : _selectedStatus,
                Direction = string.IsNullOrEmpty(_selectedDirection) ? null : _selectedDirection,
                Currency = string.IsNullOrEmpty(_selectedCurrency) ? null : _selectedCurrency
            });
            _currentPage = 1;
            await LoadTransactions();
            await LoadCurrencies();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete transactions: {ex.Message}";
        }
    }

    private async Task OnFromDateChanged(DateOnly? value)
    {
        _fromDate = value;
        await OnFilterChanged();
    }

    private async Task OnToDateChanged(DateOnly? value)
    {
        _toDate = value;
        await OnFilterChanged();
    }

    private async Task IgnoreTransactionAsync(BankTransactionDto transaction)
    {
        try
        {
            await IgnoreTransactionCall.Call(new IgnoreTransaction
            {
                Id = transaction.Id,
                Reason = "Manually ignored"
            });

            await LoadTransactions();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to ignore transaction: {ex.Message}";
        }
    }

    private static string GetConfidenceClass(string confidence) => confidence switch
    {
        "High" => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
        "Medium" => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
        "Low" => "bg-gray-100 text-gray-700 dark:bg-slate-700 dark:text-slate-400",
        _ => "bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-400"
    };
}
