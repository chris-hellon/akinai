@page "/settings/business"

@inject ICall<GetBusinessProfile, BusinessProfileDto> GetBusinessProfileCall
@inject ICall<SaveBusinessProfile> SaveBusinessProfileCall
@inject ICall<GetBusinessLogo, byte[]?> GetBusinessLogoCall
@inject ICall<SaveBusinessLogo> SaveBusinessLogoCall
@inject ICall<DeleteBusinessLogo> DeleteBusinessLogoCall
@inject EntitlementState Entitlements

<PageTitle>Business Profile - Akinai</PageTitle>

<div class="space-y-6">
    <PageHeader Title="Business Profile"
                Description="Configure your company details for invoices."
                Breadcrumbs="@(new List<PageHeader.BreadcrumbItem> { new("Settings", "/settings"), new("Business Profile") })" />

    @if (_isLoading)
    {
        <LoadingSpinner Padding="py-20" />
    }
    else
    {
        <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" class="space-y-6">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <div class="@(_isError ? "bg-red-50 dark:bg-red-900/30 border-red-200 dark:border-red-800 text-red-700 dark:text-red-300" : "bg-emerald-50 dark:bg-emerald-900/30 border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300") p-4 border rounded-xl text-sm">
                    @_statusMessage
                </div>
            }

            <!-- Company Information -->
            <Card Title="Company Information">
                <div class="space-y-4">
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <label for="CompanyName" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Company Name <span class="text-red-500">*</span></label>
                            <InputText @bind-Value="Input.CompanyName" id="CompanyName"
                                class="form-control"
                                placeholder="Your Company Ltd" />
                            <ValidationMessage For="() => Input.CompanyName" class="mt-1.5 text-xs text-red-600 dark:text-red-400" />
                        </div>
                        <div>
                            <label for="TradingName" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Trading Name</label>
                            <InputText @bind-Value="Input.TradingName" id="TradingName"
                                class="form-control"
                                placeholder="If different from company name" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <label for="Email" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Business Email <span class="text-red-500">*</span></label>
                            <InputText @bind-Value="Input.Email" id="Email" type="email"
                                class="form-control"
                                placeholder="billing@yourcompany.com" />
                            <ValidationMessage For="() => Input.Email" class="mt-1.5 text-xs text-red-600 dark:text-red-400" />
                        </div>
                        <div>
                            <label for="Phone" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Phone</label>
                            <InputText @bind-Value="Input.Phone" id="Phone"
                                class="form-control"
                                placeholder="+1 (555) 000-0000" />
                        </div>
                    </div>

                    <div>
                        <label for="Website" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Website</label>
                        <InputText @bind-Value="Input.Website" id="Website"
                            class="form-control"
                            placeholder="https://www.yourcompany.com" />
                    </div>
                </div>
            </Card>

            <!-- Address -->
            <Card Title="Business Address">
                <div class="space-y-4">
                    <div>
                        <label for="Street" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Street Address</label>
                        <InputText @bind-Value="Input.Street" id="Street"
                            class="form-control"
                            placeholder="123 Business Street" />
                    </div>

                    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                        <div>
                            <label for="City" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">City</label>
                            <InputText @bind-Value="Input.City" id="City"
                                class="form-control" />
                        </div>
                        <div>
                            <label for="State" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">State/Province</label>
                            <InputText @bind-Value="Input.State" id="State"
                                class="form-control" />
                        </div>
                        <div>
                            <label for="PostalCode" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Postal Code</label>
                            <InputText @bind-Value="Input.PostalCode" id="PostalCode"
                                class="form-control" />
                        </div>
                        <div>
                            <label for="Country" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Country</label>
                            <InputText @bind-Value="Input.Country" id="Country"
                                class="form-control" />
                        </div>
                    </div>
                </div>
            </Card>

            <!-- Tax & Registration -->
            <Card Title="Tax & Registration">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label for="TaxNumber" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Tax Number / VAT ID</label>
                        <InputText @bind-Value="Input.TaxNumber" id="TaxNumber"
                            class="form-control"
                            placeholder="GB123456789" />
                    </div>
                    <div>
                        <label for="RegistrationNumber" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Company Registration Number</label>
                        <InputText @bind-Value="Input.RegistrationNumber" id="RegistrationNumber"
                            class="form-control"
                            placeholder="12345678" />
                    </div>
                </div>
            </Card>

            <!-- Actions -->
            <div class="flex items-center justify-end">
                <PrimaryButton ButtonType="submit" Text="Save Changes" IsLoading="_isSaving" />
            </div>
        </EditForm>

        @* Its own card, outside the form: the logo has a dedicated endpoint and
           saves the moment a file is chosen, so it must not wait on — or be
           reset by — the profile's "Save Changes". Gated to Pro, because a
           branded invoice is a paid feature. *@
        <Card Title="Company Logo">
            @if (_logoEntitled)
            {
                <div class="flex flex-col sm:flex-row sm:items-center gap-5">
                    <div class="w-32 h-32 shrink-0 rounded-xl border border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800 flex items-center justify-center overflow-hidden">
                        @if (_logoDataUrl is not null)
                        {
                            <img src="@_logoDataUrl" alt="Company logo" class="max-w-full max-h-full object-contain" />
                        }
                        else
                        {
                            <svg class="w-10 h-10 text-gray-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        }
                    </div>

                    <div class="flex-1 space-y-2">
                        <p class="text-sm text-gray-600 dark:text-slate-400">
                            Shown on your invoices and estimates when the template has the logo enabled. PNG, JPG, SVG or WebP, up to 2&nbsp;MB.
                        </p>
                        <div class="flex flex-wrap items-center gap-3">
                            <label class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white rounded-lg brand-mark cursor-pointer @(_logoBusy ? "opacity-60 pointer-events-none" : "")">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                                </svg>
                                <span>@(_logoDataUrl is null ? "Upload logo" : "Replace")</span>
                                <InputFile OnChange="OnLogoSelected" accept="image/png,image/jpeg,image/svg+xml,image/webp" class="hidden" />
                            </label>
                            @if (_logoDataUrl is not null)
                            {
                                <button type="button" @onclick="RemoveLogoAsync" disabled="@_logoBusy"
                                        class="text-sm text-red-600 dark:text-red-400 hover:underline disabled:opacity-50">
                                    Remove
                                </button>
                            }
                            @if (_logoBusy)
                            {
                                <span class="text-xs text-gray-400 dark:text-slate-500">Saving…</span>
                            }
                        </div>
                        @if (_logoError is not null)
                        {
                            <p class="text-xs text-red-600 dark:text-red-400">@_logoError</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="flex items-center gap-3">
                    <span class="text-[10px] font-bold tracking-wider uppercase text-primary-700 dark:text-primary-300 bg-primary-100 dark:bg-primary-900/50 px-1.5 py-0.5 rounded">Pro</span>
                    <p class="text-sm text-gray-600 dark:text-slate-400">
                        Put your own logo on every invoice and estimate.
                        <a href="settings/billing" class="text-primary-600 dark:text-primary-400 hover:underline font-medium">Upgrade to Pro</a>.
                    </p>
                </div>
            }
        </Card>
    }
</div>

<ErrorAlert Message="@_errorMessage" />

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _statusMessage;
    private string? _errorMessage;
    private bool _isError;

    // Store the full profile so we can preserve invoice settings when saving
    private BusinessProfileDto? _fullProfile;

    private InputModel Input { get; init; } = new();

    // --- Logo -------------------------------------------------------------
    private bool _logoEntitled;              // Pro — CustomTemplates covers branding
    private string? _logoDataUrl;            // current logo as a data: URL, or null
    private bool _logoBusy;
    private string? _logoError;

    // Client-side mirror of the server's limits, so most bad files are caught
    // before an upload. The handler enforces the same rules regardless.
    private const long MaxLogoBytes = 2 * 1024 * 1024;
    private static readonly string[] AllowedLogoTypes =
        ["image/png", "image/jpeg", "image/svg+xml", "image/webp"];

    protected override async Task OnInitializedAsync()
    {
        await Entitlements.EnsureLoadedAsync();
        _logoEntitled = Entitlements.Current?.CustomTemplates ?? false;

        await LoadProfileAsync();

        if (_logoEntitled)
            await LoadLogoAsync();
    }

    private async Task LoadLogoAsync()
    {
        try
        {
            var bytes = await GetBusinessLogoCall.Call(new GetBusinessLogo());
            // The endpoint returns the raw image with no content type, so guess
            // a broadly-safe one for the preview; the real type is stored server
            // side and used on the actual documents.
            _logoDataUrl = bytes is { Length: > 0 }
                ? $"data:image/png;base64,{Convert.ToBase64String(bytes)}"
                : null;
        }
        catch
        {
            // A missing logo is the normal case, not an error worth showing.
            _logoDataUrl = null;
        }
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        _logoError = null;
        var file = e.File;

        if (file is null) return;

        if (!AllowedLogoTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            _logoError = "Please choose a PNG, JPG, SVG or WebP image.";
            return;
        }
        if (file.Size > MaxLogoBytes)
        {
            _logoError = "That image is over 2 MB. Please choose a smaller one.";
            return;
        }

        _logoBusy = true;
        try
        {
            using var stream = file.OpenReadStream(MaxLogoBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            await SaveBusinessLogoCall.Call(new SaveBusinessLogo
            {
                Logo = bytes,
                ContentType = file.ContentType,
            });

            // Preview from what we just uploaded, using the real content type.
            _logoDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception ex)
        {
            _logoError = $"Could not upload the logo: {ex.Message}";
        }
        finally
        {
            _logoBusy = false;
        }
    }

    private async Task RemoveLogoAsync()
    {
        _logoBusy = true;
        _logoError = null;
        try
        {
            await DeleteBusinessLogoCall.Call(new DeleteBusinessLogo());
            _logoDataUrl = null;
        }
        catch (Exception ex)
        {
            _logoError = $"Could not remove the logo: {ex.Message}";
        }
        finally
        {
            _logoBusy = false;
        }
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            _fullProfile = await GetBusinessProfileCall.Call(new GetBusinessProfile());
            if (_fullProfile != null)
            {
                Input.CompanyName = _fullProfile.CompanyName;
                Input.TradingName = _fullProfile.TradingName;
                Input.Email = _fullProfile.Email;
                Input.Phone = _fullProfile.Phone;
                Input.Website = _fullProfile.Website;
                Input.Street = _fullProfile.Street;
                Input.City = _fullProfile.City;
                Input.State = _fullProfile.State;
                Input.PostalCode = _fullProfile.PostalCode;
                Input.Country = _fullProfile.Country;
                Input.TaxNumber = _fullProfile.TaxNumber;
                Input.RegistrationNumber = _fullProfile.RegistrationNumber;
            }
        }
        catch (Exception ex) when (EmptyResponse.IsEmptyOk(ex))
        {
            // A brand-new account has no business profile yet. The endpoint
            // returns HttpResult.Ok(null), which EasyApi surfaces as a 200 with
            // an empty body and throws on — but "not set up yet" is a normal
            // state, so show the blank form rather than an error.
            _fullProfile = null;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load business profile: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnValidSubmitAsync()
    {
        _isSaving = true;
        _statusMessage = null;

        try
        {
            // Preserve invoice settings (bank details, PayPal, etc.) from the full profile
            await SaveBusinessProfileCall.Call(new SaveBusinessProfile
            {
                CompanyName = Input.CompanyName!,
                TradingName = Input.TradingName,
                Email = Input.Email!,
                Phone = Input.Phone,
                Website = Input.Website,
                Street = Input.Street,
                City = Input.City,
                State = Input.State,
                PostalCode = Input.PostalCode,
                Country = Input.Country,
                TaxNumber = Input.TaxNumber,
                RegistrationNumber = Input.RegistrationNumber,
                // Preserve invoice settings from the original profile
                BankName = _fullProfile?.BankName,
                BankAccountName = _fullProfile?.BankAccountName,
                BankAccountNumber = _fullProfile?.BankAccountNumber,
                BankSortCode = _fullProfile?.BankSortCode,
                BankIban = _fullProfile?.BankIban,
                BankSwift = _fullProfile?.BankSwift,
                DefaultCurrency = _fullProfile?.DefaultCurrency ?? "USD",
                DefaultPaymentTermsDays = _fullProfile?.DefaultPaymentTermsDays ?? 30,
                InvoiceNotes = _fullProfile?.InvoiceNotes,
                InvoiceFooter = _fullProfile?.InvoiceFooter,
                InvoiceEmailSubject = _fullProfile?.InvoiceEmailSubject,
                InvoiceEmailBody = _fullProfile?.InvoiceEmailBody,
                PayPalMeUsername = _fullProfile?.PayPalMeUsername,
                WiseEmail = _fullProfile?.WiseEmail,
                VietQrBankCode = _fullProfile?.VietQrBankCode
            });
            _statusMessage = "Your business profile has been saved.";
            _isError = false;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error saving business profile: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Company name is required")]
        [StringLength(200, ErrorMessage = "Company name cannot exceed 200 characters")]
        public string? CompanyName { get; set; }

        public string? TradingName { get; set; }

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string? Email { get; set; }

        public string? Phone { get; set; }
        public string? Website { get; set; }
        public string? Street { get; set; }
        public string? City { get; set; }
        public string? State { get; set; }
        public string? PostalCode { get; set; }
        public string? Country { get; set; }
        public string? TaxNumber { get; set; }
        public string? RegistrationNumber { get; set; }
    }
}
