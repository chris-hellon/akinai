<div class="cpay"><div class="qrwrap"><span class="qrbox"><svg width="60" height="60" viewBox="0 0 80 80" fill="none"><rect x="4" y="4" width="20" height="20" rx="2" stroke="#1a1712" stroke-width="4"/><rect x="12" y="12" width="4" height="4" fill="#1a1712"/><rect x="56" y="4" width="20" height="20" rx="2" stroke="#1a1712" stroke-width="4"/><rect x="64" y="12" width="4" height="4" fill="#1a1712"/><rect x="4" y="56" width="20" height="20" rx="2" stroke="#1a1712" stroke-width="4"/><rect x="12" y="64" width="4" height="4" fill="#1a1712"/><g fill="#1a1712"><rect x="32" y="4" width="6" height="6"/><rect x="42" y="4" width="6" height="6"/><rect x="32" y="14" width="6" height="6"/><rect x="4" y="32" width="6" height="6"/><rect x="14" y="32" width="6" height="6"/><rect x="34" y="32" width="6" height="6"/><rect x="54" y="32" width="6" height="6"/><rect x="70" y="32" width="6" height="6"/><rect x="32" y="52" width="6" height="6"/><rect x="52" y="52" width="6" height="6"/></g></svg><span class="beam"></span></span><div><div class="rname">Scan to pay</div><div class="rsub">VIETQR · OPENS BANKING APP</div></div></div><div class="paidwrap"><span class="seal">済</span><div class="rsub" style="margin-top:9px;letter-spacing:.06em">PAID VIA VIETQR · 27 JUN 2026</div></div></div>
