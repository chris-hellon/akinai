<div class="panel">
<div class="fx ac gap12" style="padding:18px 20px;border-bottom:1px solid var(--line2)"><span class="clogo" style="border-radius:9px">NS</span><div class="f1"><div class="rname" style="font-size:15px">Northwind Studio</div><div class="rsub">CLIENT PORTAL · ACME CO</div></div></div>
