@code {
    // The live catalogue, so the advertised price is whatever billing is
    // actually charging. Falls back to the compiled defaults if the call fails,
    // because a marketing page with no prices is worse than slightly stale ones.
    private IReadOnlyList<PlanDefinition> _plans = Plans.All;
    private PlanDefinition? _free => _plans.FirstOrDefault(p => !p.IsPaid);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Signed-in users land on the dashboard, not the marketing home page.
        if (AuthState is not null)
        {
            var state = await AuthState;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                NavigationManager.NavigateTo("dashboard", replace: true);
                return;
            }
        }

        var plans = await GetPlansCall.Call(new GetPlans());
        if (plans is { Count: > 0 }) _plans = plans;
    }
}
