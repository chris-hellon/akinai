<div class="panel">
<div class="phead"><div class="lab">Imported · statement.csv</div><span class="conf" style="color:var(--shu);background:#e7f2f3">3 auto-matched</span></div>
<div class="txr"><div class="mono rsub" style="width:56px">28 JUN</div><div class="f1" style="font-size:13px;font-weight:500">FASTER PYMT NORTHWIND</div><div class="tnum" style="font-size:13px;font-weight:700;width:60px;text-align:right">£6,800</div><span class="conf" style="color:oklch(.48 .11 155);background:oklch(.93 .05 155)">High → INV-0231</span></div>
<div class="txr"><div class="mono rsub" style="width:56px">24 JUN</div><div class="f1" style="font-size:13px;font-weight:500">STRIPE PAYOUT</div><div class="tnum" style="font-size:13px;font-weight:700;width:60px;text-align:right">£2,200</div><span class="conf" style="color:oklch(.48 .11 155);background:oklch(.93 .05 155)">High → INV-0228</span></div>
<div class="txr"><div class="mono rsub" style="width:56px">21 JUN</div><div class="f1" style="font-size:13px;font-weight:500">GOCARDLESS LTD</div><div class="tnum" style="font-size:13px;font-weight:700;width:60px;text-align:right">£480</div><span class="conf" style="color:var(--ink2);background:var(--sunk)">Medium → INV-0225</span></div>
