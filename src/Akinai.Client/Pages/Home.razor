@page "/"
@using Akinai.Shared.Billing
@using Akinai.Shared.Api.Billing
@inject ICall<GetPlans, List<PlanDefinition>> GetPlansCall
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Akinai — Invoicing for freelancers with clients abroad</PageTitle>

<div class="page washi">

<!-- nav. The drawer/scrim are siblings of .nav, not children: .nav has a
     backdrop-filter, which would make it the containing block for any
     position:fixed descendant and trap the drawer inside the 78px bar. -->
<input type="checkbox" id="navtoggle" class="navtoggle" />
<div class="nav">
<div class="navleft">
<label class="navburger" for="navtoggle" aria-label="Open menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg></label>
<a class="brand" href=""><span class="hanko">商</span><span class="wordmark">Akin<span class="wm-ai">ai</span></span></a>
</div>
<div class="navlinks"><a class="nlink" href="#payments">Payments</a><a class="nlink" href="#reconciliation">Bank import</a><a class="nlink" href="#estimates">Estimates</a><a class="nlink" href="#global">Global</a><a class="nlink" href="#pricing">Pricing</a><a class="nlink" href="#faq">FAQ</a></div>
<div class="navact"><a class="signin" href="account/login">Sign in</a><a class="btn btn-ink" href="account/register">Get started</a></div>
</div>
