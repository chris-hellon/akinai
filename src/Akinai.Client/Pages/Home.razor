<div class="rail"><span class="rico" style="background:#9FE870;border-color:#9FE870;color:#163300"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M6.488 7.469 0 15.05h11.585l1.301-3.576H7.922l3.033-3.507.01-.092L8.993 4.48h8.873l-6.878 18.925h4.706L24 .595H2.543l3.945 6.874Z"></path></svg></span><div class="f1"><div class="rname">Wise</div><div class="rsub">MULTI-CURRENCY</div></div></div>
<div class="rail"><span class="rico" style="background:var(--ink);border-color:var(--ink);color:#fff"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.9133 6.9566C20.9133 3.1208 17.7898 0 13.9503 0H2.424v3.8605h10.9782c1.7376 0 3.177 1.3651 3.2087 3.043.016.84-.2994 1.633-.8878 2.2324-.5886.5998-1.375.9303-2.2144.9303H9.2322a.2756.2756 0 0 0-.2755.2752v3.431c0 .0585.018.1142.052.1612L16.2646 24h5.3114l-7.2727-10.094c3.6625-.1838 6.61-3.2612 6.61-6.9494zM6.8943 5.9229H2.424V24h4.4704z"></path></svg></span><div class="f1"><div class="rname">Revolut</div><div class="rsub">@@akinai</div></div></div>
<div class="rail"><span class="qrtile"><svg width="42" height="42" viewBox="0 0 80 80" fill="none"><rect x="4" y="4" width="20" height="20" rx="2" stroke="#1a1712" stroke-width="4"/><rect x="12" y="12" width="4" height="4" fill="#1a1712"/><rect x="56" y="4" width="20" height="20" rx="2" stroke="#1a1712" stroke-width="4"/><rect x="64" y="12" width="4" height="4" fill="#1a1712"/><rect x="4" y="56" width="20" height="20" rx="2" stroke="#1a1712" stroke-width="4"/><rect x="12" y="64" width="4" height="4" fill="#1a1712"/><g fill="#1a1712"><rect x="32" y="4" width="6" height="6"/><rect x="42" y="4" width="6" height="6"/><rect x="4" y="32" width="6" height="6"/><rect x="34" y="32" width="6" height="6"/><rect x="54" y="32" width="6" height="6"/><rect x="32" y="52" width="6" height="6"/><rect x="52" y="52" width="6" height="6"/></g></svg></span><div class="f1"><div class="rname">VietQR</div><div class="rsub">SCAN TO PAY · VND</div></div><span class="pbadge" style="color:oklch(.48 .11 155);background:oklch(.93 .05 155)"><span class="sd" style="width:6px;height:6px;border-radius:50%;background:oklch(.48 .11 155)"></span>Instant</span></div>
