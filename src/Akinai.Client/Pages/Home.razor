<div class="bullet"><svg class="bk" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7"></path></svg>Separate bank details per currency</div>
<div class="bullet"><svg class="bk" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7"></path></svg>VietQR generated automatically for VND</div>
</div>
<div class="panel">
<div class="rail"><span class="rico"><svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M3 21h18M5 21V9m4 12V9m6 12V9m4 12V9M3 9l9-5 9 5H3z"></path></svg></span><div class="f1"><div class="rname">Bank transfer</div><div class="rsub">IBAN · SWIFT · SORT CODE</div></div></div>
