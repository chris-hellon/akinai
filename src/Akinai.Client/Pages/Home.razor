<div style="padding:16px 18px;border-right:1px solid var(--line2)"><div class="lab">Invoices</div><div class="tnum" style="font-family:var(--serif);font-size:24px;font-weight:700;margin-top:8px">12</div></div>
<div style="padding:16px 18px;border-right:1px solid var(--line2)"><div class="lab">Unpaid</div><div class="tnum" style="font-family:var(--serif);font-size:24px;font-weight:700;margin-top:8px;color:var(--shu)">3</div></div>
<div style="padding:16px 18px"><div class="lab">Paid to date</div><div class="tnum" style="font-family:var(--serif);font-size:24px;font-weight:700;margin-top:8px;color:oklch(.48 .11 155)">£41.9k</div></div>
</div>
<div class="fx ac jb" style="padding:14px 20px;border-top:1px solid var(--line2)"><span class="mono rsub">akinai.app/portal/7f3a…</span><span class="btn btn-ink" style="padding:8px 14px;font-size:12.5px">Open portal</span></div>
</div>
<div>
<span class="seyebrow"><span class="kj">門</span>Client portal</span>
<h2 class="stt">A branded home for every client</h2>
<p class="sdd">Every client gets a private, logo-branded portal on a secure token link. They see every invoice, estimate and payment, download PDFs, and pay — without an account, a password, or an email to you asking "can you resend that?"</p>
<div class="bullet"><svg class="bk" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7"></path></svg>No login — just the link</div>
<div class="bullet"><svg class="bk" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7"></path></svg>Your logo, your business details</div>
</div>
</div></div></div>

<div class="divk"><span class="dl"></span><span class="dk">世</span><span class="dl"></span></div>

<!-- Global -->
<div id="global" class="sec"><div class="wrap" style="text-align:center">
<div class="fx jc"><span class="ficon"><svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5h12M9 3v2m1.048 9.5A18 18 0 016.4 9m6.1 9h7M11 21l5-10 5 10M12.7 5C11.8 10.8 8 15.6 3 18"></path></svg></span></div>
<div class="seyebrow" style="margin-top:16px;justify-content:center"><span class="kj">世</span>Global by default</div>
<h2 class="stt" style="font-size:30px">Speaks eight languages. Bills in any currency.</h2>
<p class="sdd" style="margin:16px auto 0;max-width:540px">Each client sees their invoice in their language and currency — and you choose the look with four ready PDF templates.</p>
<div class="fx ac jc gap8" style="flex-wrap:wrap;margin-top:28px"><span class="langchip">EN English</span><span class="langchip">ES Español</span><span class="langchip">FR Français</span><span class="langchip">DE Deutsch</span><span class="langchip">ZH 中文</span><span class="langchip">VI Tiếng Việt</span></div>
<div class="fx ac jc gap8" style="margin-top:14px;flex-wrap:wrap"><span class="langchip" style="font-family:var(--sans);text-transform:none">£ GBP</span><span class="langchip" style="font-family:var(--sans);text-transform:none">$ USD</span><span class="langchip" style="font-family:var(--sans);text-transform:none">€ EUR</span><span class="langchip" style="font-family:var(--sans);text-transform:none">₫ VND</span><span class="langchip" style="font-family:var(--sans);text-transform:none">¥ JPY</span></div>
<div class="fx gap12" style="margin-top:30px;flex-wrap:wrap"><div class="tmpl"><div class="tmplbar" style="background:var(--ink)"></div><div class="tmplbody"><div class="tmplname">Minimal</div><div class="tmpltag">Clean · mono</div></div></div><div class="tmpl"><div class="tmplbar" style="background:var(--shu)"></div><div class="tmplbody"><div class="tmplname">Professional</div><div class="tmpltag">Default</div></div></div><div class="tmpl"><div class="tmplbar" style="background:var(--ai)"></div><div class="tmplbody"><div class="tmplname">Modern</div><div class="tmpltag">Bold accent</div></div></div><div class="tmpl"><div class="tmplbar" style="background:oklch(.42 .03 60)"></div><div class="tmplbody"><div class="tmplname">Classic</div><div class="tmpltag">Traditional</div></div></div></div>
</div></div>

<!-- Pricing — reads the same catalogue the billing page and the entitlement
     checks use, so what is advertised here cannot drift from what is sold. -->
<div id="pricing" class="sec"><div class="wrap" style="text-align:center">
<div class="seyebrow" style="justify-content:center"><span class="kj">価</span>Pricing</div>
<h2 class="stt" style="font-size:30px">Start free. Upgrade when it pays for itself.</h2>
<p class="sdd" style="margin:16px auto 0;max-width:520px">No card to start. @(_free?.InvoicesPerMonth?.ToString() ?? "5") invoices a month free, forever — cross-border features when you need them.</p>

<div class="fx gap12 jc" style="margin-top:34px;flex-wrap:wrap;align-items:stretch;text-align:left">
@foreach (var plan in _plans)
{
    var isPro = plan.IsPaid;
    <div class="pcard @(isPro ? "pcard-hl" : "")">
        @if (isPro)
        {
            <div class="pbadge">Most popular</div>
        }
        <div class="pname">@plan.Name</div>
        <div class="pprice">
            @if (isPro)
            {
                <span class="pamt">£@plan.MonthlyPrice.ToString("0.##")</span><span class="pper">/month</span>
            }
            else
            {
                <span class="pamt">Free</span>
            }
        </div>
        @if (isPro)
        {
            <div class="pnote">or £@plan.AnnualPrice.ToString("0.##") a year — @plan.AnnualMonthsFree.ToString("0.#") months free</div>
        }
        else
        {
            <div class="pnote">No card required</div>
        }
        <ul class="plist">
            @foreach (var line in plan.Highlights)
            {
                <li>@line</li>
            }
        </ul>
        <a class="btn @(isPro ? "btn-ink" : "btn-ghost") btn-lg" style="width:100%;justify-content:center;margin-top:auto"
           href="account/register">@(isPro ? "Start with Pro" : "Start free")</a>
    </div>
}
</div>
</div></div>

<!-- Security -->
