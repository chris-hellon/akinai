@page "/account/manage/passkeys"

@implements IAsyncDisposable

@inject ICall<GetPasskeys, List<PasskeyDto>> GetPasskeysCall
@inject ICall<RenamePasskey> RenamePasskeyCall
@inject ICall<DeletePasskey> DeletePasskeyCall
@inject IJSRuntime JS

<PageTitle>Passkeys - Akinai</PageTitle>

<div class="space-y-6">
    <PageHeader Title="Passkeys"
                Description="Sign in with your fingerprint, face or device PIN instead of a password."
                Breadcrumbs="@(new List<PageHeader.BreadcrumbItem> { new("Settings", "/settings"), new("Account", "/account/manage"), new("Passkeys") })" />

    <div class="bg-white dark:bg-[#1b1612] rounded-2xl border border-gray-200 dark:border-[#2f2924] p-6 space-y-6">

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="@(_isError ? "bg-red-50 dark:bg-red-900/30 border-red-200 dark:border-red-800 text-red-700 dark:text-red-300" : "bg-emerald-50 dark:bg-emerald-900/30 border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300") p-4 rounded-xl border text-sm">
                @_message
            </div>
        }

        @if (_isLoading)
        {
            <div class="flex justify-center py-12">
                <div class="w-8 h-8 border-2 border-gray-200 dark:border-slate-700 border-t-primary-600 rounded-full animate-spin"></div>
            </div>
        }
        else if (_passkeys.Count == 0)
        {
            <div class="rounded-xl border border-gray-200 dark:border-[#2f2924] p-8 text-center">
                <div class="mx-auto w-12 h-12 rounded-xl bg-gray-100 dark:bg-[#2f2924] flex items-center justify-center mb-4">
                    <svg class="w-6 h-6 text-gray-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                    </svg>
                </div>
                <p class="text-sm text-gray-600 dark:text-slate-300">No passkeys are registered.</p>
                <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">Add one for passwordless sign-in.</p>
            </div>
        }
        else
        {
            <div class="rounded-xl border border-gray-200 dark:border-[#2f2924] divide-y divide-gray-100 dark:divide-[#2f2924]">
                @foreach (var passkey in _passkeys)
                {
                    <div class="p-4 flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-10 h-10 shrink-0 rounded-lg bg-primary-50 dark:bg-primary-900/30 flex items-center justify-center">
                                <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                                </svg>
                            </div>

                            @if (_renamingId == passkey.CredentialId)
                            {
                                <div class="min-w-0">
                                    <input @bind="_renameValue" @bind:event="oninput" @onkeydown="@(e => OnRenameKeyAsync(e, passkey))"
                                           disabled="@_isBusy" maxlength="200" autofocus
                                           class="w-full sm:w-72 px-3 py-2 text-sm rounded-xl"
                                           placeholder="e.g. MacBook Touch ID" />
                                </div>
                            }
                            else
                            {
                                <div class="min-w-0">
                                    <div class="text-sm font-medium text-gray-900 dark:text-slate-100 truncate">
                                        @(string.IsNullOrWhiteSpace(passkey.Name) ? "Unnamed passkey" : passkey.Name)
                                    </div>
                                    <div class="text-xs text-gray-500 dark:text-slate-400">Added @passkey.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</div>
                                </div>
                            }
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                            @if (_renamingId == passkey.CredentialId)
                            {
                                <button type="button" class="btn-secondary text-xs" disabled="@_isBusy" @onclick="() => SaveRenameAsync(passkey)">Save</button>
                                <button type="button" class="btn-secondary text-xs" disabled="@_isBusy" @onclick="CancelRename">Cancel</button>
                            }
                            else if (_confirmingDeleteId == passkey.CredentialId)
                            {
                                <span class="text-xs text-gray-500 dark:text-slate-400">Remove this passkey?</span>
                                <button type="button" class="px-3 py-1.5 text-xs font-medium text-white bg-red-600 rounded-lg" disabled="@_isBusy"
                                        @onclick="() => DeleteAsync(passkey)">Remove</button>
                                <button type="button" class="btn-secondary text-xs" disabled="@_isBusy" @onclick="() => _confirmingDeleteId = null">Cancel</button>
                            }
                            else
                            {
                                <button type="button" class="btn-secondary text-xs" disabled="@_isBusy" @onclick="() => BeginRename(passkey)">Rename</button>
                                <button type="button" class="btn-secondary text-xs" disabled="@_isBusy" @onclick="() => _confirmingDeleteId = passkey.CredentialId">Remove</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (!_isLoading)
        {
            <div>
                <button type="button" disabled="@_isBusy" @onclick="AddAsync"
                        class="inline-flex items-center px-5 py-2.5 text-sm font-medium text-white rounded-xl transition-all duration-200 hover:shadow-lg active:scale-[0.98] brand-mark">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    Add a new passkey
                </button>
            </div>
        }
    </div>
</div>

@code {
    private List<PasskeyDto> _passkeys = [];
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _message;
    private bool _isError;

    private string? _renamingId;
    private string _renameValue = "";
    private string? _confirmingDeleteId;

    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _passkeys = await GetPasskeysCall.Call(new GetPasskeys()) ?? [];
        }
        catch (Exception ex)
        {
            SetError($"Could not load your passkeys: {ex.Message}");
        }
        _isLoading = false;
    }

    private async Task<IJSObjectReference> GetModuleAsync()
        => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/passkeys.js");

    private async Task AddAsync()
    {
        _isBusy = true;
        _message = null;
        CancelRename();
        _confirmingDeleteId = null;

        try
        {
            // Registration runs entirely in the browser module: it fetches the
            // challenge, prompts the authenticator and posts the credential
            // back. Those two requests must be real HTTP requests so the
            // server can set and clear the challenge cookie — see js/passkeys.js.
            var module = await GetModuleAsync();
            var result = await module.InvokeAsync<AddPasskeyResultDto>("addPasskey");

            if (result is null || !result.Succeeded)
            {
                SetError(result?.Error ?? "The passkey could not be added.");
            }
            else
            {
                await LoadAsync();
                SetSuccess("Passkey added. Give it a name so you can recognise it later.");

                // Drop straight into rename — an unnamed passkey is useless
                // once there is more than one.
                if (result.Passkey is not null)
                {
                    _renamingId = result.Passkey.CredentialId;
                    _renameValue = "";
                }
            }
        }
        catch (JSException ex)
        {
            // Cancelled prompt, unsupported browser, or an authenticator refusal.
            SetError(ex.Message);
        }
        catch (Exception ex)
        {
            SetError($"Could not add a passkey: {ex.Message}");
        }

        _isBusy = false;
    }

    private void BeginRename(PasskeyDto passkey)
    {
        _confirmingDeleteId = null;
        _renamingId = passkey.CredentialId;
        _renameValue = passkey.Name ?? "";
    }

    private void CancelRename()
    {
        _renamingId = null;
        _renameValue = "";
    }

    private async Task OnRenameKeyAsync(KeyboardEventArgs e, PasskeyDto passkey)
    {
        if (e.Key == "Enter") await SaveRenameAsync(passkey);
        else if (e.Key == "Escape") CancelRename();
    }

    private async Task SaveRenameAsync(PasskeyDto passkey)
    {
        var name = _renameValue.Trim();
        if (name.Length == 0)
        {
            SetError("Enter a name for this passkey.");
            return;
        }

        _isBusy = true;
        try
        {
            await RenamePasskeyCall.Call(new RenamePasskey { CredentialId = passkey.CredentialId, Name = name });
            CancelRename();
            await LoadAsync();
            SetSuccess("Passkey renamed.");
        }
        catch (Exception ex)
        {
            SetError($"Could not rename the passkey: {ex.Message}");
        }
        _isBusy = false;
    }

    private async Task DeleteAsync(PasskeyDto passkey)
    {
        _isBusy = true;
        try
        {
            await DeletePasskeyCall.Call(new DeletePasskey { CredentialId = passkey.CredentialId });
            _confirmingDeleteId = null;
            await LoadAsync();
            SetSuccess("Passkey removed.");
        }
        catch (Exception ex)
        {
            SetError($"Could not remove the passkey: {ex.Message}");
        }
        _isBusy = false;
    }

    private void SetSuccess(string message) { _message = message; _isError = false; }
    private void SetError(string message) { _message = message; _isError = true; }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
    }
}
