@page "/invoices/{Id:guid}"

@inject ICall<GetInvoice, InvoiceDetailDto?> GetInvoiceCall
@inject ICall<GetInvoicePdf, byte[]> GetInvoicePdfCall
@inject ICall<MarkInvoicePaid> MarkInvoicePaidCall
@inject ICall<MarkInvoiceSent> MarkInvoiceSentCall
@inject ICall<DeleteInvoice> DeleteInvoiceCall
@inject ICall<SendInvoice> SendInvoiceCall
@inject ICall<GetBusinessProfile, BusinessProfileDto?> GetBusinessProfileCall
@inject ICall<GetBusinessLogo, byte[]?> GetBusinessLogoCall
@inject ICall<GetCurrencyPaymentSettings, CurrencyPaymentSettingsDto?> GetCurrencyPaymentSettingsCall
@inject ICall<GetInvoicePaymentTiming, PaymentTimingDto?> GetPaymentTimingCall
@using Akinai.Shared.Dtos.Timing
@inject ICall<GetInvoiceBankTransactions, List<BankTransactionDto>> GetInvoiceBankTransactionsCall
@inject ICall<SaveInvoiceServiceLines> SaveServiceLinesCall
@inject ICall<SummariseTimesheet, TimesheetSummaryDto> SummariseCall
@inject IJSRuntime JS
@inject EntitlementState Entitlements

<PageTitle>@(_invoice != null ? _invoice.InvoiceNumber : "Invoice") - Akinai</PageTitle>

<div class="space-y-6">
    <PageHeader Title="@(_invoice?.InvoiceNumber ?? "Loading...")"
                Description="@(_invoice != null ? $"Invoice for {_invoice.ClientName}" : "")"
                ShowBackButton="true"
                BackUrl="invoices"
                Breadcrumbs="@_breadcrumbs">
        <Actions>
            @if (_invoice != null)
            {
                @* Two actions stay in the row; everything else moves into the menu.
                   Six buttons fitted nobody's screen — on a phone the row either stacked
                   into a wall or scrolled sideways, which hides the last action entirely. *@
                <div class="flex items-center gap-2 sm:gap-3">
                    @if (_invoice.Status == "Draft")
                    {
                        <button @onclick="SendInvoiceAsync" disabled="@_isSending"
                            class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-slate-300 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-600 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-700 transition-all duration-200 disabled:opacity-50">
                            @if (_isSending)
                            {
                                <div class="w-4 h-4 border-2 border-gray-300 border-t-gray-600 rounded-full animate-spin"></div>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            }
                            <span class="hidden sm:inline">Send</span>
                        </button>
                    }

                    @if (_invoice.Status != "Paid" && _invoice.Status != "Void")
                    {
                        <PrimaryButton Text="Mark as Paid" OnClick="MarkAsPaid" IsLoading="_isMarkingPaid" ShowIcon="false" />
                    }

                    <ActionMenu Title="More">
                        <ActionMenuItem OnClick="PreviewAsClient">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            What your client sees
                        </ActionMenuItem>

                        <ActionMenuItem OnClick="DownloadPdf" Disabled="_isDownloading">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            @(_isDownloading ? "Preparing PDF…" : "Download PDF")
                        </ActionMenuItem>

                        @if (_invoice.Status == "Draft")
                        {
                            <ActionMenuItem Href="@($"invoices/{Id}/edit")">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Edit invoice
                            </ActionMenuItem>

                            <ActionMenuItem OnClick="MarkAsSent" Disabled="_isMarkingSent">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                Mark as sent
                            </ActionMenuItem>
                        }
                    </ActionMenu>
                </div>
            }
        </Actions>
    </PageHeader>

    @if (_isLoading)
    {
        <LoadingSpinner Padding="py-20" />
    }
    else if (_invoice == null)
    {
        <EmptyState Title="Invoice not found"
                    Message="The invoice you're looking for doesn't exist or has been deleted."
                    IconType="EmptyState.EmptyStateIcon.Document"
                    ActionUrl="invoices"
                    ActionText="Back to Invoices" />
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content - Invoice View -->
            <div class="lg:col-span-2">
                @* Preview banner. While previewing, the invoice below renders the
                   proposed summary rather than the saved rows, so the user judges
                   the real document — dates and all — before anything is written.
                   Editing a description here updates the invoice live. *@
                @if (IsPreviewing)
                {
                    <div class="mb-4 rounded-lg border border-primary-300 dark:border-primary-700 bg-primary-50 dark:bg-primary-900/25 p-4 space-y-3">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <div class="text-sm font-semibold text-gray-900 dark:text-slate-100">Preview — not saved</div>
                                <p class="text-xs text-gray-600 dark:text-slate-400 mt-0.5">
                                    This is how the invoice below will read. @_previewDescriptions.Count lines in place of @_proposal!.OriginalRowCount tracked rows. The total is unchanged.
                                </p>
                            </div>
                            <div class="flex gap-2 shrink-0">
                                <button @onclick="CancelPreview" disabled="@_isApplying"
                                        class="px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-slate-300 bg-white dark:bg-slate-700 border border-gray-200 dark:border-slate-600 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-600 disabled:opacity-50">
                                    Cancel
                                </button>
                                <button @onclick="ApplyPreview" disabled="@(_isApplying || _previewDescriptions.Any(string.IsNullOrWhiteSpace))"
                                        class="px-3 py-1.5 text-xs font-medium text-white rounded-lg brand-mark disabled:opacity-50">
                                    @(_isApplying ? "Saving…" : "Save to invoice")
                                </button>
                            </div>
                        </div>
                        <div class="space-y-2">
                            @for (var i = 0; i < _previewDescriptions.Count; i++)
                            {
                                var index = i;
                                <input @bind="_previewDescriptions[index]" @bind:event="oninput" @bind:after="RebuildPreview"
                                       class="w-full text-sm rounded-lg border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 px-3 py-2 text-gray-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-primary-500/30" />
                            }
                        </div>

                        @* Tone: pick a voice and regenerate to see it. Each is a
                           fresh call, so the button says so. *@
                        <div class="flex flex-wrap items-center gap-2 pt-1">
                            <span class="text-xs text-gray-500 dark:text-slate-400 mr-1">Tone:</span>
                            @foreach (var tone in Akinai.Shared.Ai.SummaryTone.All)
                            {
                                var t = tone;
                                <button type="button" @onclick="() => RegenerateAsync(t)" disabled="@_isApplying"
                                        class="px-2.5 py-1 text-xs rounded-full border transition-colors disabled:opacity-50 @(t == _previewTone
                                            ? "bg-primary-600 border-primary-600 text-white"
                                            : "border-gray-200 dark:border-slate-600 text-gray-600 dark:text-slate-300 hover:border-primary-400")">
                                    @t
                                </button>
                            }
                        </div>
                    </div>
                }
                <div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl border border-gray-100 dark:border-slate-700 overflow-hidden">
                    <InvoiceViewContent
                        InvoiceNumber="@_invoice.InvoiceNumber"
                        Status="@_invoice.Status"
                        Currency="@_invoice.Currency"
                        Language="@_invoice.Language"
                        ShowBranding="@ShowBranding"
                        IssueDate="@_invoice.IssueDate"
                        DueDate="@_invoice.DueDate"
                        PaidDate="@_invoice.PaidDate"
                        BusinessName="@(string.IsNullOrWhiteSpace(_businessProfile?.TradingName) ? _businessProfile?.CompanyName : _businessProfile.TradingName)"
                        BusinessAddress="@GetFormattedAddress()"
                        BusinessEmail="@_businessProfile?.Email"
                        BusinessPhone="@_businessProfile?.Phone"
                        BusinessLogo="@_businessLogo"
                        TaxNumber="@_businessProfile?.TaxNumber"
                        RegistrationNumber="@_businessProfile?.RegistrationNumber"
                        ClientName="@_invoice.ClientName"
                        ClientCompanyName="@_invoice.ClientCompanyName"
                        ClientAddress="@_invoice.ClientAddress"
                        ClientEmail="@_invoice.ClientEmail"
                        Subtotal="@_invoice.Subtotal"
                        TaxRate="@_invoice.TaxRate"
                        TaxAmount="@_invoice.TaxAmount"
                        Total="@_invoice.Total"
                        Notes="@_invoice.Notes"
                        RequiredStatements="@_invoice.RequiredStatements"
                        ShowScanToPay="@(Entitlements.Current?.ScanToPay ?? false)"
                        LineItems="@(_previewLines ?? _invoice.LineItems)"
                        ExpenseLineItems="@_invoice.ExpenseLineItems"
                        ProductLineItems="@_invoice.ProductLineItems"
                        PrimaryColor="@PrimaryColor"
                        AccentColor="@AccentColor"
                        ShowLogo="@ShowLogo"
                        ShowItemDescriptions="@ShowItemDescriptions"
                        HeaderLayout="@HeaderLayout"
                        ItemsLayout="@ItemsLayout"
                        FooterLayout="@FooterLayout"
                        PayPalMeUsername="@_businessProfile?.PayPalMeUsername"
                        WiseEmail="@_businessProfile?.WiseEmail"
                        RevolutUsername="@_businessProfile?.RevolutUsername"
                        DefaultCurrency="@_businessProfile?.DefaultCurrency"
                        VndToDefaultCurrencyRate="@_businessProfile?.VndToDefaultCurrencyRate"
                        CurrencyPaymentSettings="@_currencyPaymentSettings" />
                </div>
            </div>

            <!-- Sidebar -->
            <div class="space-y-6">
                <!-- Details Card -->
                @* Predicted dates are a paid feature; the invoice is perfectly usable
                   without the card, so it is simply absent on Free rather than replaced
                   by a nag. *@
                @if (Entitlements.Current?.PaymentInsights ?? false)
                {
                <Card Title="Payment journey">
                    <PaymentJourney Status="@_invoice.Status"
                                    SentAtUtc="@_invoice.SentAtUtc"
                                    FirstViewedAtUtc="@_invoice.FirstViewedAtUtc"
                                    LastViewedAtUtc="@_invoice.LastViewedAtUtc"
                                    ViewCount="@_invoice.ViewCount"
                                    PaidDate="@_invoice.PaidDate"
                                    DueDate="@_invoice.DueDate"
                                    Timing="@_paymentTiming" />
                </Card>
                }

                <Card Title="Details">
                    <dl class="space-y-3">
                        <div class="flex justify-between items-center">
                            <dt class="text-sm text-gray-500 dark:text-slate-400">Status</dt>
                            <dd>
                                <StatusBadge Status="@_invoice.Status" Type="StatusBadge.StatusType.Invoice" />
                            </dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-500 dark:text-slate-400">Issue Date</dt>
                            <dd class="text-sm font-medium text-gray-900 dark:text-slate-100">@_invoice.IssueDate.ToString("MMM dd, yyyy")</dd>
                        </div>
                        @* Whether the client has actually opened the link. Deliberately
                           phrased as "opened", not "read" — a link preview or a mail
                           scanner can trigger it, so it is evidence of delivery rather
                           than proof anyone looked. *@
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-500 dark:text-slate-400">Client opened</dt>
                            <dd class="text-sm font-medium @(_invoice.FirstViewedAtUtc.HasValue ? "text-emerald-600 dark:text-emerald-400" : "text-gray-400 dark:text-slate-500")">
                                @if (_invoice.FirstViewedAtUtc is DateTime seen)
                                {
                                    <span title="@($"First opened {seen.ToLocalTime():d MMM yyyy HH:mm} · {_invoice.ViewCount} view{(_invoice.ViewCount == 1 ? "" : "s")}")">
                                        @Ago(_invoice.LastViewedAtUtc ?? seen)
                                        @if (_invoice.ViewCount > 1)
                                        {
                                            <span class="text-gray-400 dark:text-slate-500"> · @_invoice.ViewCount×</span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    @* Say so explicitly. The owner's own visits are
                                       excluded on purpose, and without this the first
                                       thing anyone does — open their own link to test
                                       it — looks like the feature is broken. *@
                                    <span title="Opening the link while signed in doesn't count. Use a private window to test it.">
                                        Not yet
                                        <span class="text-gray-400 dark:text-slate-500 font-normal">· your own visits aren't counted</span>
                                    </span>
                                }
                            </dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-sm text-gray-500 dark:text-slate-400">Due Date</dt>
                            <dd class="text-sm font-medium @(IsOverdue ? "text-red-600 dark:text-red-400" : "text-gray-900 dark:text-slate-100")">@_invoice.DueDate.ToString("MMM dd, yyyy")</dd>
                        </div>
                        @if (_invoice.PaidDate.HasValue)
                        {
                            <div class="flex justify-between">
                                <dt class="text-sm text-gray-500 dark:text-slate-400">Paid On</dt>
                                <dd class="text-sm font-medium text-emerald-600 dark:text-emerald-400">@_invoice.PaidDate.Value.ToString("MMM dd, yyyy")</dd>
                            </div>
                        }
                        <div class="flex justify-between pt-2 border-t border-gray-100 dark:border-slate-700">
                            <dt class="text-sm text-gray-500 dark:text-slate-400">Total</dt>
                            <dd class="text-sm font-bold text-gray-900 dark:text-slate-100">@CurrencyExtensions.GetSymbol(_invoice.Currency)@_invoice.Total.ToString("N2")</dd>
                        </div>
                    </dl>
                </Card>

                <!-- Client Card -->
                <Card Title="Client">
                    <div class="space-y-3">
                        <div>
                            <p class="text-sm font-medium text-gray-900 dark:text-slate-100">@_invoice.ClientName</p>
                            @if (!string.IsNullOrEmpty(_invoice.ClientCompanyName))
                            {
                                <p class="text-sm text-gray-600 dark:text-slate-400">@_invoice.ClientCompanyName</p>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_invoice.ClientEmail))
                        {
                            <p class="text-sm text-gray-600 dark:text-slate-400">@_invoice.ClientEmail</p>
                        }
                        <div class="pt-2">
                            <a href="@($"clients/{_invoice.ClientId}")" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">View Client</a>
                        </div>
                    </div>
                </Card>

                <!-- Bank Payments Card -->
                @if (_bankPayments.Any())
                {
                    <Card Title="Bank payments">
                        <div class="divide-y divide-gray-100 dark:divide-slate-700 -mt-2">
                            @foreach (var tx in _bankPayments)
                            {
                                <div class="flex items-center justify-between gap-3 py-3">
                                    <div class="min-w-0">
                                        <div class="text-sm font-medium text-gray-900 dark:text-slate-100 truncate">@tx.Description</div>
                                        <div class="text-xs text-gray-500 dark:text-slate-400">@tx.TransactionDate.ToString("MMM d, yyyy")</div>
                                    </div>
                                    <div class="shrink-0 text-sm font-semibold @(tx.Amount >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                        @(tx.Amount >= 0 ? "+" : "")@CurrencyExtensions.GetSymbol(tx.Currency)@tx.Amount.ToString("N2")
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="mt-3 pt-3 border-t border-gray-100 dark:border-slate-700">
                            <a href="bank-import" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">View in Bank Import &rarr;</a>
                        </div>
                    </Card>
                }

                @* Summarising sits above the other actions because it changes
                   what the document says, where the rest only move or send it.

                   Only shown when the panel would actually offer something: a
                   draft can be summarised, and a summary already applied can be
                   undone. An issued, unsummarised invoice has neither, so the
                   card would otherwise render empty — which is what it did. *@
                @* Hidden while previewing — the preview banner over the invoice
                   is doing the work, and the sidebar trigger would be redundant. *@
                @if (!IsPreviewing && _invoice.TimeEntryCount > 0 && (_invoice.Status == "Draft" || _invoice.IsSummarised))
                {
                    <Card Title="Services">
                        <SummariseTimesheetPanel InvoiceId="@Id"
                                                 IsDraft="@(_invoice.Status == "Draft")"
                                                 EntryCount="@_invoice.TimeEntryCount"
                                                 IsSummarised="@_invoice.IsSummarised"
                                                 LineCount="@(_invoice.LineItems?.Count ?? 0)"
                                                 OnProposed="OnSummaryProposed"
                                                 OnCleared="LoadData" />
                    </Card>
                }

                <!-- Actions Card -->
                <Card Title="Actions">
                    <div class="space-y-3">
                        @if (_invoice.PublicAccessToken.HasValue)
                        {
                            <a href="@($"/invoice/view/{_invoice.PublicAccessToken.Value}")" target="_blank" class="flex items-center gap-2 text-sm text-primary-600 dark:text-primary-400 hover:underline">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                                View Public Link
                            </a>
                            <button @onclick="CopyPublicLinkAsync" class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-200">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                </svg>
                                Copy Link
                            </button>
                        }
                        @if (_invoice.Status == "Draft")
                        {
                            <a href="@($"invoices/{Id}/edit")" class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-slate-200">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Edit Invoice
                            </a>
                        }
                    </div>
                </Card>
            </div>
        </div>

        <DangerZone EntityLabel="Invoice" ItemName="@_invoice.InvoiceNumber"
                    WarningMessage="This permanently deletes the invoice and its line items. This cannot be undone."
                    OnConfirmed="PerformDelete" />
    }
</div>

<ErrorAlert Message="@_errorMessage" />

@code {

    /// <summary>
    /// Whether the preview shows the Akinai footer line.
    ///
    /// Deliberately not EntitlementState.Allows, which fails open: an
    /// unresolved plan here would hide the branding and show the owner a
    /// preview their client will not get. Unknown means show.
    /// </summary>
    private bool ShowBranding => !(Entitlements.Current?.RemoveBranding ?? false);
    [Parameter]
    public Guid Id { get; set; }

    private InvoiceDetailDto? _invoice;

    // --- Summary preview -------------------------------------------------
    // A proposal being reviewed. While set, the invoice above renders these
    // lines instead of the saved ones, and nothing is written until Save.
    private TimesheetSummaryDto? _proposal;
    private List<InvoiceLineItemDto>? _previewLines;
    private List<string> _previewDescriptions = [];
    private List<Guid> _previewKeys = [];
    private string _previewTone = Akinai.Shared.Ai.SummaryTone.Professional;
    private bool _isApplying;

    private bool IsPreviewing => _proposal is not null;

    private List<BankTransactionDto> _bankPayments = new();
    private BusinessProfileDto? _businessProfile;
    private byte[]? _businessLogo;
    private CurrencyPaymentSettingsDto? _currencyPaymentSettings;
    private PaymentTimingDto? _paymentTiming;
    private bool _isLoading = true;
    private bool _isDownloading;
    private bool _isMarkingPaid;
    private bool _isMarkingSent;
    private bool _isSending;
    private string? _errorMessage;
    /// <summary>"2 hours ago" reads better than a timestamp for something you
    /// glance at; the exact time is in the tooltip.</summary>
    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours} hr ago";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays} day{((int)span.TotalDays == 1 ? "" : "s")} ago";
        return utc.ToLocalTime().ToString("d MMM yyyy");
    }

    private List<PageHeader.BreadcrumbItem> _breadcrumbs = [];

    private bool IsOverdue => _invoice != null && _invoice.Status is "Sent" or "Overdue" && _invoice.DueDate < DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        // Needed before the preview renders, or the owner briefly sees a
        // branding line their plan has removed.
        await Entitlements.EnsureLoadedAsync();

        _breadcrumbs =
        [
            new PageHeader.BreadcrumbItem("Time & Billing", "/time-billing"),
            new PageHeader.BreadcrumbItem("Invoices", "/invoices"),
            new PageHeader.BreadcrumbItem("Details")
        ];

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            // Translated: this is the read-only view, so it should show exactly
            // what the client receives. InvoiceEdit deliberately does not.
            _invoice = await GetInvoiceCall.Call(new GetInvoice { Id = Id, Translated = true });
            _bankPayments = await GetInvoiceBankTransactionsCall.Call(new GetInvoiceBankTransactions { InvoiceId = Id }) ?? new();
            _businessProfile = await GetBusinessProfileCall.Call(new GetBusinessProfile());

            if (_businessProfile?.HasLogo == true)
            {
                _businessLogo = await GetBusinessLogoCall.Call(new GetBusinessLogo());
            }

            if (_invoice != null)
            {
                _currencyPaymentSettings = await GetCurrencyPaymentSettingsCall.Call(
                    new GetCurrencyPaymentSettings { CurrencyCode = _invoice.Currency });

                // Best-effort. A prediction is a nicety; failing to fetch one must not stop
                // the invoice rendering.
                try
                {
                    if (Entitlements.Current?.PaymentInsights ?? false)
                    {
                        _paymentTiming = await GetPaymentTimingCall.Call(
                            new GetInvoicePaymentTiming { Id = Id });
                    }
                }
                catch
                {
                    _paymentTiming = null;
                }
                _breadcrumbs =
                [
                    new PageHeader.BreadcrumbItem("Time & Billing", "/time-billing"),
                    new PageHeader.BreadcrumbItem("Invoices", "/invoices"),
                    new PageHeader.BreadcrumbItem(_invoice.InvoiceNumber)
                ];
            }
        }
        catch (Exception ex) when (EmptyResponse.IsEmptyOk(ex))
        {
            // Empty state for a new account, not a failure — see EmptyResponse.
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load invoice: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // --- Summary preview -------------------------------------------------

    /// <summary>
    /// A proposal came back from the summariser. Enter preview: the invoice
    /// above now renders these lines. Nothing is saved yet.
    /// </summary>
    private void OnSummaryProposed(TimesheetSummaryDto summary)
    {
        _previewTone = Akinai.Shared.Ai.SummaryTone.Professional;
        ApplyProposal(summary);
    }

    /// <summary>Loads a proposal into the preview, resetting editable state.</summary>
    private void ApplyProposal(TimesheetSummaryDto summary)
    {
        _proposal = summary;
        _previewDescriptions = summary.Lines.Select(l => l.Description).ToList();
        // Stable keys so editing a description does not remount every row.
        _previewKeys = summary.Lines.Select(_ => Guid.NewGuid()).ToList();
        RebuildPreview();
    }

    /// <summary>
    /// Re-runs the summariser in a different tone and replaces the preview.
    ///
    /// A fresh model call — grouping may shift with the tone, so the entry ids
    /// are taken from the new proposal, never carried over. Any wording the user
    /// had edited is discarded, which is the point: they asked for a new voice.
    /// </summary>
    private async Task RegenerateAsync(string tone)
    {
        if (_isApplying || tone == _previewTone) return;

        _isApplying = true;
        _errorMessage = null;

        try
        {
            var summary = await SummariseCall.Call(new SummariseTimesheet { Id = Id, Tone = tone });

            if (summary is { Accepted: true })
            {
                _previewTone = tone;
                ApplyProposal(summary);
            }
            else
            {
                _errorMessage = summary?.Reason ?? "Could not regenerate the summary.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not regenerate: {ex.Message}";
        }
        finally
        {
            _isApplying = false;
        }
    }

    /// <summary>
    /// Rebuilds the previewed line items from the proposal and the current
    /// (possibly edited) descriptions.
    ///
    /// This mirrors the server's ServiceLineProjection exactly — description in
    /// the job-name slot, blank project and date, the blended rate — so the
    /// preview renders identically to what a save will produce. The numbers are
    /// the proposal's, which the server already summed from the entries; editing
    /// wording cannot touch them.
    /// </summary>
    private void RebuildPreview()
    {
        if (_proposal is null) { _previewLines = null; return; }

        _previewLines = _proposal.Lines.Select((l, i) => new InvoiceLineItemDto(
            _previewKeys[i],
            Guid.Empty,
            _previewDescriptions[i],   // JobName — the column the table renders
            string.Empty,              // ProjectName — a group spans projects
            null,                      // SectionName
            null,                      // Date — a group spans dates
            _previewDescriptions[i],
            l.Hours,
            l.Hours == 0 ? 0 : l.Amount / l.Hours,
            l.Amount,
            _invoice!.Currency)).ToList();
    }

    private void CancelPreview()
    {
        _proposal = null;
        _previewLines = null;
        _previewDescriptions = [];
        _previewKeys = [];
    }

    /// <summary>
    /// Persists the previewed summary. Only wording and grouping are sent; the
    /// server re-derives and re-checks every number, so nothing the user did in
    /// the preview can move the total.
    /// </summary>
    private async Task ApplyPreview()
    {
        if (_proposal is null || _previewDescriptions.Any(string.IsNullOrWhiteSpace)) return;

        _isApplying = true;
        _errorMessage = null;

        try
        {
            await SaveServiceLinesCall.Call(new SaveInvoiceServiceLines
            {
                Id = Id,
                Lines = _proposal.Lines
                    .Select((l, i) => new ServiceLineInput
                    {
                        Description = _previewDescriptions[i].Trim(),
                        TimeEntryIds = l.TimeEntryIds,
                    })
                    .ToList(),
            });

            CancelPreview();
            await LoadData();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not save the summary: {ex.Message}";
        }
        finally
        {
            _isApplying = false;
        }
    }

