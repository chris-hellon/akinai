@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject ICall<GetAdminUsers, PaginatedResponse<AdminUserDto>> GetUsersCall
@inject ICall<SetUserLockout> SetLockoutCall
@inject ICall<ConfirmUserEmail> ConfirmEmailCall
@inject ICall<SetUserAdmin> SetAdminCall
@inject ICall<InviteUser, InviteResultDto> InviteUserCall
@inject ICall<SendPasswordResetLink> ResetLinkCall
@inject ICall<ResendConfirmationEmail> ResendConfirmCall
@inject ICall<DeleteUser> DeleteUserCall
@inject ICall<SetUserPlan> SetUserPlanCall
@inject EntitlementState Entitlements

@using Akinai.Shared.Billing

<PageTitle>Users - Akinai admin</PageTitle>

@* The [Authorize] above is convenience only — every /api/admin endpoint
   independently requires the Admin role server-side. *@

<div class="space-y-6">
    <PageHeader Title="Users"
                Description="Everyone registered on Akinai."
                Breadcrumbs="@_breadcrumbs" />

    <div class="card p-4 space-y-3">
        <div class="flex flex-col sm:flex-row gap-3">
            <input class="form-control flex-1" placeholder="Invite by email…"
                   value="@_inviteEmail" @oninput="OnInviteEmailChanged" />
            <button type="button" class="btn-primary" disabled="@(_isBusy || string.IsNullOrWhiteSpace(_inviteEmail))"
                    @onclick="InviteAsync">Send invite</button>
        </div>

        @if (_invite is not null)
        {
            <div class="rounded-lg border border-gray-200 dark:border-[#2f2924] p-3 text-sm space-y-2">
                @if (_invite.EmailSent)
                {
                    <div class="text-gray-900 dark:text-slate-100">Invite emailed to <strong>@_invite.Email</strong>.</div>
                }
                else
                {
                    <div class="text-red-600 dark:text-red-400">
                        Account created, but the email failed: @_invite.EmailError
                    </div>
                }
                <div class="text-gray-500 dark:text-slate-400">
                    Set-password link (treat as a credential — send it over a trusted channel):
                </div>
                <code class="block break-all text-xs bg-gray-50 dark:bg-[#14100c] p-2 rounded">@_invite.SetPasswordLink</code>
            </div>
        }
        @if (_error is not null)
        {
            <div class="text-sm text-red-600 dark:text-red-400">@_error</div>
        }
    </div>

    <div class="card p-4">
        <input class="form-control" placeholder="Search by email…"
               value="@_search" @oninput="OnSearchChanged" />
    </div>

    @if (_isLoading)
    {
        <div class="flex justify-center py-24"><LoadingSpinner /></div>
    }
    else if (_response is null || _response.Items.Count == 0)
    {
        <EmptyState Title="No users found"
                    Message="No account matches that search."
                    IconType="EmptyState.EmptyStateIcon.Users" />
    }
    else
    {
        <div class="bg-white dark:bg-[#1b1612] rounded-2xl border border-gray-200 dark:border-[#2f2924] overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 dark:bg-[#14100c]">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">User</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Plan</th>
                            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Clients</th>
                            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Invoices</th>
                            <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-[#2f2924]">
                        @foreach (var user in _response.Items)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-[#2f2924]">
                                <td class="px-6 py-4">
                                    <div class="text-sm font-medium text-gray-900 dark:text-slate-100">@user.Email</div>
                                    <div class="text-xs text-gray-500 dark:text-slate-400 font-mono">@user.Id</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-wrap items-center gap-1.5">
                                        @if (user.IsAdmin)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-primary-50 text-primary-700 dark:bg-primary-900/40 dark:text-primary-300">Admin</span>
                                        }
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-red-50 text-red-700 dark:bg-red-900/40 dark:text-red-300">Locked</span>
                                        }
                                        @if (!user.EmailConfirmed)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">Unconfirmed</span>
                                        }
                                        @if (user.TwoFactorEnabled)
                                        {
                                            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 dark:bg-[#2f2924] dark:text-slate-300">2FA</span>
                                        }
                                        @if (user is { EmailConfirmed: true, IsLockedOut: false, IsAdmin: false, TwoFactorEnabled: false })
                                        {
                                            <span class="text-xs text-gray-500 dark:text-slate-400">Active</span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium text-gray-900 dark:text-slate-100">@user.PlanName</span>
                                        @if (user.SubscriptionStatus != SubscriptionStatus.None)
                                        {
                                            <SubscriptionStatusPill Status="@user.SubscriptionStatus" />
                                        }
                                    </div>
                                    @if (user.CurrentPeriodEndUtc is DateTime periodEnd)
                                    {
                                        <div class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">
                                            until @periodEnd.ToLocalTime().ToString("d MMM yyyy")
                                        </div>
                                    }
                                </td>
                                <td class="px-6 py-4 text-sm text-right text-gray-900 dark:text-slate-100 tnum">@user.ClientCount</td>
                                <td class="px-6 py-4 text-sm text-right text-gray-900 dark:text-slate-100 tnum">@user.InvoiceCount</td>
                                <td class="px-6 py-4">
                                    @* Icon buttons rather than a row of text buttons: six labels
                                       overflowed the column and cut off Delete. Each carries a
                                       title/aria-label so the action is still named on hover and
                                       to screen readers. *@
                                    <div class="flex items-center justify-end gap-1">
                                        @if (!user.EmailConfirmed)
                                        {
                                            <button type="button" class="icon-btn" title="Resend confirmation email" aria-label="Resend confirmation email"
                                                    disabled="@_isBusy" @onclick="() => ResendConfirmAsync(user)">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                            </button>
                                            <button type="button" class="icon-btn" title="Force-confirm email" aria-label="Force-confirm email"
                                                    disabled="@_isBusy" @onclick="() => ConfirmEmailAsync(user)">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                            </button>
                                        }
                                        <button type="button" class="icon-btn" title="Reset password" aria-label="Reset password"
                                                disabled="@_isBusy" @onclick="() => SendResetAsync(user)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4-2a6 6 0 01-7.743 5.743L11 14H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                                        </button>
                                        @* Always available, including on your own row — granting yourself
                                           a plan is the quickest way to check what a customer sees. *@
                                        <button type="button" class="icon-btn" title="Change plan" aria-label="Change plan"
                                                disabled="@_isBusy" @onclick="() => BeginPlanChange(user)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                                        </button>
                                        @if (!IsSelf(user))
                                        {
                                            <button type="button" class="icon-btn" title="@(user.IsAdmin ? "Revoke admin" : "Make admin")" aria-label="@(user.IsAdmin ? "Revoke admin" : "Make admin")"
                                                    disabled="@_isBusy" @onclick="() => ToggleAdminAsync(user)">
                                                <svg class="w-4 h-4 @(user.IsAdmin ? "text-primary-600 dark:text-primary-400" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                            </button>
                                            <button type="button" class="icon-btn" title="@(user.IsLockedOut ? "Unlock account" : "Lock account")" aria-label="@(user.IsLockedOut ? "Unlock account" : "Lock account")"
                                                    disabled="@_isBusy" @onclick="() => ToggleLockAsync(user)">
                                                @if (user.IsLockedOut)
                                                {
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 018 0m-4 8v-2m-6 6h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/></svg>
                                                }
                                                else
                                                {
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                                }
                                            </button>
                                            <button type="button" class="icon-btn icon-btn-danger" title="Delete user" aria-label="Delete user"
                                                    disabled="@_isBusy" @onclick="() => BeginDelete(user)">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400 dark:text-slate-500 pl-1">You</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-sm text-gray-500 dark:text-slate-400">
            @_response.TotalCount registered @(_response.TotalCount == 1 ? "user" : "users")
        </div>
    }

    @if (_planTarget is not null)
    {
        <div class="bg-white dark:bg-[#1b1612] rounded-2xl border border-gray-200 dark:border-[#2f2924] p-6 space-y-4">
            <div>
                <div class="font-display text-lg font-bold text-gray-900 dark:text-slate-100">Change plan for @_planTarget.Email</div>
                <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">
                    Sets the plan directly, with no payment taken. Recorded in the account's billing
                    history against your address.
                </p>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Plan</label>
                    <select @bind="_planValue" class="w-full px-3 py-2 text-sm rounded-xl">
                        @foreach (var plan in Plans.All)
                        {
                            <option value="@plan.Plan">@plan.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Billing cycle</label>
                    <select @bind="_planCycle" disabled="@(_planValue == BillingPlan.Free)" class="w-full px-3 py-2 text-sm rounded-xl">
                        <option value="@BillingCycle.Monthly">Monthly</option>
                        <option value="@BillingCycle.Annual">Annual</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Months (optional)</label>
                    <input type="number" min="1" max="120" @bind="_planMonths" disabled="@(_planValue == BillingPlan.Free)"
                           placeholder="One cycle" class="w-full px-3 py-2 text-sm rounded-xl" />
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button type="button" class="px-5 py-2.5 text-sm font-medium text-white rounded-xl brand-mark"
                        disabled="@_isBusy" @onclick="SavePlanAsync">Apply plan</button>
                <button type="button" class="btn-secondary text-xs" disabled="@_isBusy" @onclick="() => _planTarget = null">Cancel</button>
            </div>
        </div>
    }

    @if (_deleteTarget is not null)
    {
        <div class="card p-5 border-red-200 dark:border-red-900/50 space-y-3">
            <div class="font-display text-lg font-bold text-red-700 dark:text-red-400">Permanently delete @_deleteTarget.Email</div>
            <p class="text-sm text-gray-600 dark:text-slate-300">
                This erases the account and everything it owns — clients, projects, invoices,
                time entries, expenses and bank data. It cannot be undone.
            </p>
            <p class="text-sm text-gray-600 dark:text-slate-300">
                Type <strong>@_deleteTarget.Email</strong> to confirm:
            </p>
            <input class="form-control" placeholder="Confirm the email address"
                   value="@_deleteConfirm" @oninput="OnDeleteConfirmChanged" />
            <div class="flex items-center gap-3">
                <button type="button" class="px-4 py-2.5 text-sm font-medium text-white bg-red-600 rounded-xl"
                        disabled="@(_isBusy || _deleteConfirm != _deleteTarget.Email)"
                        @onclick="ConfirmDeleteAsync">Delete permanently</button>
                <button type="button" class="btn-secondary" disabled="@_isBusy" @onclick="CancelDelete">Cancel</button>
            </div>
        </div>
    }
</div>

@code {
    private PaginatedResponse<AdminUserDto>? _response;
    private bool _isLoading = true;
    private bool _isBusy;
    private string _search = "";

    private readonly List<PageHeader.BreadcrumbItem> _breadcrumbs = [new("Admin", "/admin"), new("Users")];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Comes from the server. Reading the id from the auth state would not work
    // once this page runs on WebAssembly: only the name and role claims are
    // serialised to the browser, so NameIdentifier is absent there and every
    // row would look like somebody else — including your own.
    private static bool IsSelf(AdminUserDto user) => user.IsCurrentUser;

    private async Task LoadAsync()
    {
        _isLoading = true;
        _response = await GetUsersCall.Call(new GetAdminUsers { Search = _search, Page = 1, PageSize = 50 });
        _isLoading = false;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        await LoadAsync();
    }

    private async Task ConfirmEmailAsync(AdminUserDto user)
    {
        _isBusy = true;
        await ConfirmEmailCall.Call(new ConfirmUserEmail { UserId = user.Id });
        await LoadAsync();
        _isBusy = false;
    }

    private async Task ToggleAdminAsync(AdminUserDto user)
    {
        _isBusy = true;
        await SetAdminCall.Call(new SetUserAdmin { UserId = user.Id, IsAdmin = !user.IsAdmin });
        await LoadAsync();
        _isBusy = false;
    }

    private string _inviteEmail = "";
    private InviteResultDto? _invite;
    private string? _error;
    private AdminUserDto? _deleteTarget;

    private AdminUserDto? _planTarget;
    private BillingPlan _planValue = BillingPlan.Free;
    private BillingCycle _planCycle = BillingCycle.Monthly;
    private int? _planMonths;
    private string _deleteConfirm = "";

    private void OnInviteEmailChanged(ChangeEventArgs e) => _inviteEmail = e.Value?.ToString() ?? "";
    private void OnDeleteConfirmChanged(ChangeEventArgs e) => _deleteConfirm = e.Value?.ToString() ?? "";

    private async Task InviteAsync()
    {
        _isBusy = true; _error = null; _invite = null;
        try
        {
            _invite = await InviteUserCall.Call(new InviteUser { Email = _inviteEmail.Trim() });
            if (_invite is null)
                _error = "Couldn't invite that address — it may already be registered, or be invalid.";
            else
                _inviteEmail = "";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        _isBusy = false;
    }

    private async Task SendResetAsync(AdminUserDto user)
    {
        _isBusy = true;
        await ResetLinkCall.Call(new SendPasswordResetLink { UserId = user.Id });
        _isBusy = false;
    }

    private async Task ResendConfirmAsync(AdminUserDto user)
    {
        _isBusy = true;
        await ResendConfirmCall.Call(new ResendConfirmationEmail { UserId = user.Id });
        _isBusy = false;
    }

    private void BeginPlanChange(AdminUserDto user)
    {
        _deleteTarget = null;
        _planTarget = user;
        _planValue = user.Plan;
        _planCycle = BillingCycle.Monthly;
        _planMonths = null;
    }

    private async Task SavePlanAsync()
    {
        if (_planTarget is null) return;
        _isBusy = true;
        _error = null;
        try
        {
            await SetUserPlanCall.Call(new SetUserPlan
            {
                UserId = _planTarget.Id,
                Plan = _planValue,
                Cycle = _planValue == BillingPlan.Free ? null : _planCycle,
                Months = _planValue == BillingPlan.Free ? null : _planMonths,
            });
            // If an admin changed their own plan, their cached entitlements are
            // now stale for the rest of the session.
            if (_planTarget.IsCurrentUser) await Entitlements.ReloadAsync();
            _planTarget = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        _isBusy = false;
    }

    private void BeginDelete(AdminUserDto user) { _planTarget = null; _deleteTarget = user; _deleteConfirm = ""; }
    private void CancelDelete() { _deleteTarget = null; _deleteConfirm = ""; }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _isBusy = true;
        await DeleteUserCall.Call(new DeleteUser { UserId = _deleteTarget.Id, ConfirmEmail = _deleteConfirm });
        _deleteTarget = null; _deleteConfirm = "";
        await LoadAsync();
        _isBusy = false;
    }

    private async Task ToggleLockAsync(AdminUserDto user)
    {
        _isBusy = true;
        await SetLockoutCall.Call(new SetUserLockout { UserId = user.Id, LockedOut = !user.IsLockedOut });
        await LoadAsync();
        _isBusy = false;
    }
}
