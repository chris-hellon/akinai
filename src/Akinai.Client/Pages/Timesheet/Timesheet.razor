@page "/timesheet"
@implements IDisposable
@inject ICall<GetTimesheetJobs, List<TimesheetJobDto>> GetTimesheetJobsCall
@inject ICall<GetWeeklyTimeEntries, List<TimeEntryDto>> GetTimeEntriesCall
@inject ICall<LogTimeEntry, Guid> LogTimeEntryCall
@inject TimeTrackingState Tracking
@inject EntitlementState Entitlements
@inject ICall<SummariseWeek, WeekSummaryDto> SummariseWeekCall
@using Akinai.Shared.Api.Timesheet
@using Akinai.Shared.Dtos.Timesheet

<PageTitle>Timesheet - Akinai</PageTitle>

<div class="space-y-6">
    <!-- Header with Breadcrumbs -->
    <PageHeader Title="Weekly Timesheet"
                Description="Track and manage your working hours"
                Breadcrumbs="@(new List<PageHeader.BreadcrumbItem> { new("Time & Billing", "/time-billing"), new("Timesheet") })" />

    <!-- Week Navigation Card -->
    <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            @* w-full with the arrows pushed to the edges on a phone: as a content-width
               group it left a third of the row empty after the forward arrow. From sm up
               it goes back to sitting at its natural width beside the stats. *@
            <div class="w-full sm:w-auto flex items-center justify-between sm:justify-start gap-3">
                <button @onclick="PreviousWeek"
                        class="p-2.5 text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-200 hover:bg-gray-100 dark:hover:bg-[#2f2924] rounded-xl transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <div class="flex-1 sm:flex-none text-center min-w-[180px]">
                    <h2 class="text-base font-semibold text-gray-900 dark:text-slate-100">
                        @_weekStart.ToString("MMM d") - @_weekEnd.ToString("MMM d, yyyy")
                    </h2>
                    <button @onclick="GoToCurrentWeek" class="text-xs text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium mt-0.5">
                        Jump to today
                    </button>
                </div>
                <button @onclick="NextWeek"
                        class="p-2.5 text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-200 hover:bg-gray-100 dark:hover:bg-[#2f2924] rounded-xl transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>

            <!-- Week Summary Stats -->
            @* Same treatment as the nav above: as a content-width group these sat bunched
               to the left of a full-width row. Spread on a phone, natural width from sm. *@
            <div class="w-full sm:w-auto flex items-center justify-around sm:justify-start gap-6">
                <div class="text-center">
                    <div class="text-2xl font-bold text-primary-600 dark:text-primary-400">
                        @GetWeekTotal().ToString("N2")
                    </div>
                    <div class="text-xs text-gray-500 dark:text-slate-400 font-medium">Hours logged</div>
                </div>
                <div class="h-10 w-px bg-gray-200 dark:bg-slate-600"></div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-gray-900 dark:text-slate-100">
                        @(_displayedJobs?.Count ?? 0)
                    </div>
                    <div class="text-xs text-gray-500 dark:text-slate-400 font-medium">Active jobs</div>
                </div>
            </div>

            @* Gated the same way the invoice summariser is: the plan is enforced server-side
               where the money is actually spent, so this is only about not offering a
               button that will refuse. An account with no AI at all sees the upgrade hint;
               a Pro account that has merely spent this month's allowance still gets the
               button, because that is a different message and comes back from the server. *@
            @if (Entitlements.Current?.HasAiFeatures ?? false)
            {
                <SecondaryButton Text="Summarise my week"
                                 LoadingText="Summarising…"
                                 IsLoading="_isSummarising"
                                 Disabled="@(GetWeekTotal() == 0)"
                                 OnClick="SummariseWeekAsync" />
            }
            else
            {
                @* The inline note, not UpgradePrompt: the timesheet still works perfectly
                   without this, so replacing a button with a full upgrade card would
                   overstate what is missing. *@
                <PlanRestrictionNote Message="Summarise your week into something you can send — a Pro feature." />
            }

            <button @onclick="OpenJobPicker"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-medium text-white rounded-xl shadow-md transition-all duration-200 hover:shadow-lg active:scale-[0.98] brand-mark">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Add Jobs
            </button>
        </div>
    </div>

    @* The week, rewritten. Deliberately read-only and unpriced: this is for telling
       somebody what you did, not for billing them. Nothing here is saved. *@
    @if (_weekSummary is { } summary)
    {
        <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 dark:border-slate-700 flex items-start justify-between gap-4">
                <div>
                    <h3 class="text-base font-semibold text-gray-900 dark:text-slate-100">Your week, written up</h3>
                    <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">
                        @if (summary.Available)
                        {
                            <text>@summary.TotalHours.ToString("N2") hours across @summary.Clients.Count client@(summary.Clients.Count == 1 ? "" : "s"). Nothing has been saved.</text>
                        }
                        else
                        {
                            <text>@summary.Reason</text>
                        }
                    </p>
                </div>
                <button type="button" @onclick="@(() => _weekSummary = null)"
                        class="shrink-0 p-1 text-gray-400 hover:text-gray-600 dark:hover:text-slate-200 rounded-lg transition-colors"
                        title="Dismiss">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @if (summary.Available)
            {
                <div class="divide-y divide-gray-100 dark:divide-slate-700">
                    @foreach (var client in summary.Clients)
                    {
                        <div class="px-5 py-4">
                            <div class="flex items-baseline justify-between gap-4 mb-2">
                                <div class="text-sm font-semibold text-gray-900 dark:text-slate-100">@client.ClientName</div>
                                <div class="text-xs text-gray-500 dark:text-slate-400">@client.Hours.ToString("N2") h</div>
                            </div>
                            <ul class="space-y-1.5">
                                @foreach (var line in client.Lines)
                                {
                                    <li class="flex items-baseline justify-between gap-4 text-sm text-gray-600 dark:text-slate-400">
                                        <span>@line.Description</span>
                                        <span class="shrink-0 tabular-nums text-xs">@line.Hours.ToString("N2") h</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- Timesheet Content -->
    @if (_isLoading)
    {
        <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 shadow-sm">
            <div class="flex flex-col items-center justify-center py-20">
                <div class="w-10 h-10 border-2 border-gray-200 dark:border-slate-600 border-t-primary-600 rounded-full animate-spin"></div>
                <p class="mt-4 text-sm text-gray-500 dark:text-slate-400">Loading timesheet...</p>
            </div>
        </div>
    }
    else if (_displayedJobs == null || !_displayedJobs.Any())
    {
        <!-- Empty State -->
        <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 shadow-sm">
            <div class="text-center py-20 px-6">
                <div class="mx-auto w-20 h-20 rounded-lg flex items-center justify-center mb-6 bg-primary-50">
                    <svg class="h-10 w-10 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-slate-100">No jobs on your timesheet</h3>
                <p class="mt-2 text-sm text-gray-500 dark:text-slate-400 max-w-sm mx-auto">
                    Add jobs to start tracking your time. You can select from your active projects and jobs.
                </p>
                <div class="mt-8">
                    <button @onclick="OpenJobPicker"
                            class="inline-flex items-center gap-2 px-6 py-3 text-sm font-medium text-white rounded-xl transition-all duration-200 hover:shadow-lg active:scale-[0.98] brand-mark">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                        Add Your First Job
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        @* The week grid needs roughly 690px before it starts scrolling sideways — a 180px
           job column plus seven days plus a total. On a phone that means seeing two days
           at a time and hunting for the rest, so below lg it is replaced entirely by the
           day-at-a-time layout underneath rather than squeezed. *@
        <!-- Timesheet Grid (lg and up) -->
        <div class="hidden lg:block bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-gray-100 dark:border-slate-700">
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider bg-gray-50/50 dark:bg-slate-700/50 sticky left-0 z-10 min-w-[180px]">
                                Job / Project
                            </th>
                            @foreach (var day in _weekDays)
                            {
                                var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                                var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                                <th class="px-2 py-4 text-center min-w-[64px] @(isWeekend ? "bg-gray-50/80 dark:bg-slate-700/80" : "bg-gray-50/50 dark:bg-slate-700/50")">
                                    <div class="text-xs font-semibold uppercase tracking-wider @(isToday ? "text-primary-600 dark:text-primary-400" : "text-gray-500 dark:text-slate-400")">
                                        @day.ToString("ddd")
                                    </div>
                                    <div class="mt-1 @(isToday ? "inline-flex items-center justify-center w-7 h-7 rounded-full bg-primary-600 text-white text-sm font-semibold" : "text-sm text-gray-400 dark:text-slate-500")">
                                        @day.Day
                                    </div>
                                </th>
                            }
                            <th class="px-5 py-4 text-center text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider bg-gray-50/50 dark:bg-slate-700/50 min-w-[64px]">
                                Total
                            </th>
                            <th class="px-3 py-4 bg-gray-50/50 dark:bg-slate-700/50 w-12"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50 dark:divide-slate-700">
                        @foreach (var job in _displayedJobs)
                        {
                            var jobTotal = GetJobTotal(job.Id);
                            var isInactive = !job.IsActive;
                            <tr class="group hover:bg-primary-50/30 dark:hover:bg-primary-900/20 transition-colors @(isInactive ? "opacity-75" : "")">
                                <td class="px-5 py-4 sticky left-0 z-10 bg-white dark:bg-slate-800 group-hover:bg-primary-50/30 dark:group-hover:bg-primary-900/20 transition-colors">
                                    <div class="flex items-center gap-3">
                                        <div class="w-2 h-10 rounded-full @(isInactive ? "bg-gradient-to-b from-gray-300 to-gray-400 dark:from-slate-500 dark:to-slate-600" : "bg-gradient-to-b from-primary-400 to-primary-600")"></div>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <span class="text-sm font-semibold text-gray-900 dark:text-slate-100 truncate">@job.Name</span>
                                                @if (isInactive)
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium rounded bg-gray-100 dark:bg-slate-700 text-gray-500 dark:text-slate-400">
                                                        Completed
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-xs text-gray-500 dark:text-slate-400 truncate">@job.ProjectName &bull; @job.ClientName</div>
                                        </div>
                                    </div>
                                </td>
                                @foreach (var day in _weekDays)
                                {
                                    var entry = GetTimeEntry(job.Id, day);
                                    var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                                    var isWeekend = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                    var hasHours = entry is { Hours: > 0 };
                                    <td class="px-2 py-3 text-center @(isWeekend ? "bg-gray-50/40 dark:bg-slate-700/30" : "")">
                                        <div class="relative">
                                            @if (isInactive)
                                            {
                                                <!-- Read-only display for completed jobs -->
                                                <div class="w-full max-w-[48px] mx-auto text-center border rounded-lg py-2 px-1 text-sm font-medium @(hasHours ? "bg-gray-100 dark:bg-slate-700 border-gray-200 dark:border-slate-600 text-gray-600 dark:text-slate-300" : "bg-gray-50 dark:bg-slate-800 border-gray-100 dark:border-slate-700 text-gray-400 dark:text-slate-500")">
                                                    @FormatHoursToTime(entry?.Hours ?? 0)
                                                </div>
                                            }
                                            else
                                            {
                                                <input type="text"
                                                       inputmode="decimal"
                                                       placeholder="0:00"
                                                       value="@FormatHoursToTime(entry?.Hours ?? 0)"
                                                       @onchange="@(e => UpdateTimeEntry(job.Id, day, e.Value?.ToString()))"
                                                       onfocus="this.select()"
                                                       class="w-full max-w-[48px] mx-auto text-center border rounded-lg py-2 px-1 text-sm font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-400 @(hasHours ? "bg-primary-100 dark:bg-primary-900/50 border-primary-300 dark:border-primary-700 text-primary-700 dark:text-primary-300" : "bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-600 text-gray-600 dark:text-slate-300 hover:border-gray-300 dark:hover:border-slate-500") @(isToday && !hasHours ? "ring-2 ring-primary-100 dark:ring-primary-900" : "")" />
                                            }
                                        </div>
                                    </td>
                                }
                                <td class="px-5 py-4 text-center">
                                    <span class="inline-flex items-center justify-center min-w-[48px] px-2.5 py-1.5 rounded-lg text-sm font-semibold @(jobTotal > 0 ? (isInactive ? "bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-300" : "bg-primary-100 dark:bg-primary-900/50 text-primary-700 dark:text-primary-300") : "bg-gray-100 dark:bg-slate-700 text-gray-400 dark:text-slate-500")">
                                        @jobTotal.ToString("N2")
                                    </span>
                                </td>
                                <td class="px-3 py-4 text-center">
                                    <button @onclick="() => RemoveJobFromTimesheet(job.Id)"
                                            class="p-2 text-gray-300 dark:text-slate-600 hover:text-red-500 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/50 rounded-lg transition-all opacity-0 group-hover:opacity-100"
                                            title="Remove from timesheet">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="border-t-2 border-gray-100 dark:border-slate-700 bg-gray-50/80 dark:bg-slate-700/50">
                            <td class="px-5 py-4 sticky left-0 z-10 bg-gray-50/80 dark:bg-slate-700/50">
                                <span class="text-sm font-semibold text-gray-700 dark:text-slate-200">Daily Totals</span>
                            </td>
                            @foreach (var day in _weekDays)
                            {
                                var dayTotal = GetDayTotal(day);
                                var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                                <td class="px-2 py-4 text-center @(isWeekend ? "bg-gray-100/50 dark:bg-slate-600/30" : "")">
                                    <span class="text-sm font-semibold @(dayTotal > 0 ? "text-gray-900 dark:text-slate-100" : "text-gray-400 dark:text-slate-500")">
                                        @dayTotal.ToString("N2")
                                    </span>
                                </td>
                            }
                            <td class="px-5 py-4 text-center">
                                <span class="inline-flex items-center justify-center min-w-[56px] px-3 py-2 rounded-xl text-base font-bold text-white bg-primary-600">
                                    @GetWeekTotal().ToString("N2")
                                </span>
                            </td>
                            <td class="bg-gray-50/80 dark:bg-slate-700/50"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        @* Day at a time, for phones. Entering a timesheet on a phone is almost always
           "what did I do today", not "reconcile my whole week", so the day comes first and
           the jobs list under it. *@
        <div class="lg:hidden space-y-3">
            @* Seven equal cells. Every day carries a background, not just the selected
               one — otherwise the grid stretches all cells to the row height and only the
               selected cell paints it, so one black block appears to float among plain
               text. Fixed height keeps the strip compact and the row even. *@
            <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 shadow-sm p-2">
                <div class="grid grid-cols-7 gap-1.5">
                    @foreach (var day in _weekDays)
                    {
                        var isSelected = day == _selectedDay;
                        var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                        var dayTotal = GetDayTotal(day);
                        <button type="button" @onclick="@(() => _selectedDay = day)"
                                class="h-14 flex flex-col items-center justify-center gap-0.5 rounded-lg transition-colors @(isSelected
                                    ? "bg-primary-600 text-white"
                                    : "bg-gray-50 dark:bg-slate-700/40 text-gray-600 dark:text-slate-300 hover:bg-gray-100 dark:hover:bg-slate-700")">
                            <span class="text-[10px] uppercase leading-none @(isSelected ? "text-white/70" : "text-gray-400 dark:text-slate-500")">
                                @day.ToString("ddd")[..1]
                            </span>
                            <span class="text-sm font-semibold leading-none @(isToday && !isSelected ? "text-primary-600 dark:text-primary-400" : "")">
                                @day.Day
                            </span>
                            @* Always rendered so every cell is the same height; invisible
                               when the day is empty. *@
                            <span class="w-1.5 h-1.5 rounded-full @(dayTotal > 0
                                ? (isSelected ? "bg-white" : "bg-primary-500")
                                : "bg-transparent")"></span>
                        </button>
                    }
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 shadow-sm overflow-hidden">
                <div class="px-4 py-3 border-b border-gray-100 dark:border-slate-700 flex items-baseline justify-between">
                    <div class="text-sm font-semibold text-gray-900 dark:text-slate-100">
                        @_selectedDay.ToString("dddd d MMMM")
                    </div>
                    <div class="text-sm font-semibold text-primary-600 dark:text-primary-400">
                        @GetDayTotal(_selectedDay).ToString("N2") h
                    </div>
                </div>

                @if (_displayedJobs is { Count: > 0 })
                {
                    <div class="divide-y divide-gray-100 dark:divide-slate-700">
                        @foreach (var job in _displayedJobs)
                        {
                            var entry = GetTimeEntry(job.Id, _selectedDay);
                            var hasHours = entry is { Hours: > 0 };
                            var isInactive = !job.IsActive;
                            <div class="px-4 py-3 flex items-center gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium text-gray-900 dark:text-slate-100 truncate">@job.Name</div>
                                    <div class="text-xs text-gray-500 dark:text-slate-400 truncate">@job.ProjectName &middot; @job.ClientName</div>
                                </div>
                                @if (isInactive)
                                {
                                    <div class="shrink-0 w-20 text-center border rounded-lg py-2.5 text-sm font-medium bg-gray-50 dark:bg-slate-800 border-gray-100 dark:border-slate-700 text-gray-400 dark:text-slate-500">
                                        @FormatHoursToTime(entry?.Hours ?? 0)
                                    </div>
                                }
                                else
                                {
                                    @* w-20 and py-2.5 give a target comfortably over the 44px
                                       minimum a thumb needs; the 48px cell in the week grid is
                                       fine with a mouse and fiddly without one. *@
                                    <input type="text" inputmode="decimal" placeholder="0:00"
                                           value="@FormatHoursToTime(entry?.Hours ?? 0)"
                                           @onchange="@(e => UpdateTimeEntry(job.Id, _selectedDay, e.Value?.ToString()))"
                                           onfocus="this.select()"
                                           class="shrink-0 w-20 text-center border rounded-lg py-2.5 text-sm font-medium transition-all focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-400 @(hasHours
                                               ? "bg-primary-100 dark:bg-primary-900/50 border-primary-300 dark:border-primary-700 text-primary-700 dark:text-primary-300"
                                               : "bg-white dark:bg-slate-800 border-gray-200 dark:border-slate-600 text-gray-600 dark:text-slate-300")" />
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="px-4 py-8 text-center text-sm text-gray-500 dark:text-slate-400">
                        No jobs on this timesheet yet.
                    </div>
                }
            </div>
        </div>

        <!-- Quick Tips -->
        <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-slate-400">
            <svg class="w-4 h-4 text-gray-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Tip: Enter time as hours:minutes (e.g., 2:30 for 2½ hours). You can also type 2.5 or just 2. Changes are saved automatically.</span>
        </div>
    }
</div>

<!-- Saving Toast -->
@if (_isSaving)
{
    <div class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl shadow-lg text-sm font-medium flex items-center gap-3 text-white animate-fade-in brand-mark">
        <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Saving changes...
    </div>
}

@if (!string.IsNullOrEmpty(_saveMessage))
{
    <div class="fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl shadow-lg text-sm font-medium flex items-center gap-3 bg-emerald-500 text-white animate-fade-in"
         style="box-shadow: 0 10px 40px rgba(16, 185, 129, 0.4);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        @_saveMessage
    </div>
}

<style>
    @@keyframes fade-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fade-in 0.2s ease-out;
    }
</style>

@code {
    private List<TimesheetJobDto>? _allJobs;
    private List<TimesheetJobDto>? _displayedJobs;
    private HashSet<Guid> _selectedJobIds = [];
    private List<TimeEntryDto> _timeEntries = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _saveMessage;
    private WeekSummaryDto? _weekSummary;
    private bool _isSummarising;

    private DateOnly _weekStart;
    private DateOnly _weekEnd;
    private readonly DateOnly[] _weekDays = new DateOnly[7];

    /// <summary>
    /// The day the phone layout is showing. Today when the displayed week contains it,
    /// otherwise the Monday — landing on a day you cannot have worked would be odd.
    /// </summary>
    private DateOnly _selectedDay;

    protected override async Task OnInitializedAsync()
    {
        await Entitlements.EnsureLoadedAsync();
        Tracking.OnEntryLogged += OnEntryLogged;
        GoToCurrentWeek();
        await LoadData();
    }

    // A time entry was logged elsewhere (e.g. the header timer) — refresh the current week.
    private void OnEntryLogged() => _ = InvokeAsync(async () =>
    {
        await LoadDataForWeek();
        StateHasChanged();
    });

    public void Dispose() => Tracking.OnEntryLogged -= OnEntryLogged;

    private void GoToCurrentWeek()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var diff = (7 + ((int)today.DayOfWeek - (int)DayOfWeek.Monday)) % 7;
        _weekStart = today.AddDays(-diff);
        UpdateWeekDays();
    }

    /// <summary>
    /// Asks for the week in readable form. Best-effort: a summariser that is unconfigured,
    /// out of budget or simply unavailable must not break the timesheet, so a failure shows
    /// a reason rather than an error.
    /// </summary>
    private async Task SummariseWeekAsync()
    {
        _isSummarising = true;
        _weekSummary = null;
        try
        {
            _weekSummary = await SummariseWeekCall.Call(new SummariseWeek { WeekStart = _weekStart });
        }
        catch
        {
            _weekSummary = WeekSummaryDto.Unavailable("The summary could not be produced just now.");
        }
        finally
        {
            _isSummarising = false;
        }
    }

    private void PreviousWeek()
    {
        _weekSummary = null;
        _weekStart = _weekStart.AddDays(-7);
        UpdateWeekDays();
        _ = LoadDataForWeek();
    }

    private void NextWeek()
    {
        _weekSummary = null;
        _weekStart = _weekStart.AddDays(7);
        UpdateWeekDays();
        _ = LoadDataForWeek();
    }

    private async Task LoadDataForWeek()
    {
        try
        {
            _allJobs = await GetTimesheetJobsCall.Call(new GetTimesheetJobs { WeekStart = _weekStart });
            _timeEntries = await GetTimeEntriesCall.Call(new GetWeeklyTimeEntries { WeekStart = _weekStart }) ?? [];

            // Only show jobs that have time entries in THIS specific week
            _selectedJobIds = _timeEntries.Select(e => e.JobId).Distinct().ToHashSet();

            UpdateDisplayedJobs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            _timeEntries = [];
        }
        StateHasChanged();
    }

    private void UpdateWeekDays()
    {
        _weekEnd = _weekStart.AddDays(6);
        for (int i = 0; i < 7; i++)
        {
            _weekDays[i] = _weekStart.AddDays(i);
        }

        // Keep the phone layout's day inside the week being shown.
        var today = DateOnly.FromDateTime(DateTime.Today);
        _selectedDay = today >= _weekStart && today <= _weekEnd ? today : _weekStart;
    }

    private async Task LoadData()
    {
        try
        {
            _allJobs = await GetTimesheetJobsCall.Call(new GetTimesheetJobs { WeekStart = _weekStart });
            _timeEntries = await GetTimeEntriesCall.Call(new GetWeeklyTimeEntries { WeekStart = _weekStart }) ?? [];

            // Auto-select jobs that have time entries this week
            var jobsWithEntries = _timeEntries.Select(e => e.JobId).Distinct().ToHashSet();
            _selectedJobIds = jobsWithEntries;

            UpdateDisplayedJobs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            _allJobs = [];
            _displayedJobs = [];
            _timeEntries = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void UpdateDisplayedJobs()
    {
        _displayedJobs = _allJobs != null ? _allJobs.Where(j => _selectedJobIds.Contains(j.Id)).ToList() : [];
    }

    private async Task RefreshTimeEntries()
    {
        try
        {
            _timeEntries = await GetTimeEntriesCall.Call(new GetWeeklyTimeEntries { WeekStart = _weekStart }) ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading time entries: {ex.Message}");
            _timeEntries = [];
        }
        StateHasChanged();
    }

    private async Task OpenJobPicker()
    {
        var parameters = new Dictionary<string, object>
        {
            ["InitialSelection"] = _selectedJobIds
        };

        var options = new ModalOptions
        {
            Size = ModalSize.Large,
            CloseOnBackdropClick = true
        };

        var result = await ModalService.ShowAsync<HashSet<Guid>>(
            typeof(SelectJobsModal),
            "Select Jobs for Timesheet",
            parameters,
            options);

        if (result != null)
        {
            _selectedJobIds = result;
            UpdateDisplayedJobs();
        }
    }

    private void RemoveJobFromTimesheet(Guid jobId)
    {
        _selectedJobIds.Remove(jobId);
        UpdateDisplayedJobs();
    }

    private TimeEntryDto? GetTimeEntry(Guid jobId, DateOnly date)
    {
        return _timeEntries.FirstOrDefault(e => e.JobId == jobId && e.Date == date);
    }

    private decimal GetJobTotal(Guid jobId)
    {
        return _timeEntries.Where(e => e.JobId == jobId).Sum(e => e.Hours);
    }

    private decimal GetDayTotal(DateOnly date)
    {
        return _timeEntries.Where(e => e.Date == date && _selectedJobIds.Contains(e.JobId)).Sum(e => e.Hours);
    }

    private decimal GetWeekTotal()
    {
        return _timeEntries.Where(e => _selectedJobIds.Contains(e.JobId)).Sum(e => e.Hours);
    }

    private async Task UpdateTimeEntry(Guid jobId, DateOnly date, string? value)
    {
        var hours = ParseTimeInput(value);
        hours = Math.Max(0, Math.Min(24, hours));

        var existingEntry = GetTimeEntry(jobId, date);

        if (hours == 0 && existingEntry == null)
        {
            return;
        }

        _isSaving = true;
        _saveMessage = null;
        StateHasChanged();

        try
        {
            await LogTimeEntryCall.Call(new LogTimeEntry
            {
                JobId = jobId,
                Date = date,
                Hours = hours,
                Description = null
            });
            await RefreshTimeEntries();
            _saveMessage = "Changes saved";
            _ = ClearSaveMessage();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving time entry: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task ClearSaveMessage()
    {
        await Task.Delay(2000);
        _saveMessage = null;
        StateHasChanged();
    }

    /// <summary>
    /// Parses various time input formats to decimal hours.
    /// Supports: "2:30" (H:MM), "2.30" (converted to 2:30), "2.5" (decimal), "2" (whole hours)
    /// </summary>
    private static decimal ParseTimeInput(string? input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return 0;

        input = input.Trim();

        // Handle colon format (H:MM or HH:MM)
        if (input.Contains(':'))
        {
            var parts = input.Split(':');
            if (parts.Length == 2 &&
                int.TryParse(parts[0], out var hours) &&
                int.TryParse(parts[1], out var minutes))
            {
                // Clamp minutes to valid range
                minutes = Math.Max(0, Math.Min(59, minutes));
                return hours + (minutes / 60m);
            }
        }

        // Handle period - could be decimal (2.5) or time-like (2.30)
        if (input.Contains('.'))
        {
            var parts = input.Split('.');
            if (parts.Length == 2)
            {
                // If the part after the decimal is 2 digits and looks like minutes (00-59)
                // treat it as H.MM format (e.g., 2.30 = 2:30 = 2.5 hours)
                if (parts[1].Length == 2 &&
                    int.TryParse(parts[0], out var hours) &&
                    int.TryParse(parts[1], out var minutePart) &&
                    minutePart is >= 0 and <= 59)
                {
                    return hours + (minutePart / 60m);
                }

                // Otherwise treat as decimal (e.g., 2.5 = 2.5 hours)
                if (decimal.TryParse(input, out var decimalHours))
                {
                    return decimalHours;
                }
            }
        }

        // Plain number
        if (decimal.TryParse(input, out var plainHours))
        {
            return plainHours;
        }

        return 0;
    }

    /// <summary>
    /// Formats decimal hours to H:MM display format.
    /// Returns null for zero/no hours.
    /// </summary>
    private static string? FormatHoursToTime(decimal hours)
    {
        if (hours == 0)
            return null;

        var totalMinutes = (int)Math.Round(hours * 60);
        var h = totalMinutes / 60;
        var m = totalMinutes % 60;
        return $"{h}:{m:D2}";
    }

}
