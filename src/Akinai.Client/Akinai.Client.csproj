<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>

        <!--
          Ship the full ICU data rather than the default EFIGS subset.

          Blazor WebAssembly normally bundles locale data for English, French,
          Italian, German and Spanish only. Akinai bills in Vietnamese, Chinese
          and Russian too, and without this a Vietnamese invoice silently fell
          back to invariant formatting — "8 August 2026" instead of the local
          date form — which is precisely the detail the product exists to get
          right. Costs roughly 1.5 MB of ICU payload, cached after first load.
        -->
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Akinai.Shared\Akinai.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
        <PackageReference Include="BlazorUtils.EasyApi.Client" Version="2.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0-rc.1.25451.107" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.0-rc.1.25451.107" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0-rc.1.25451.107" />
    </ItemGroup>

</Project>
