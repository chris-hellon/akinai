@* An overflow menu for secondary actions.

   A page header can carry two or three actions before the row stops fitting — sooner on a
   phone, where it either wraps into a stack or scrolls sideways and the last button is
   simply never found. Rather than ration what a page may offer, the primary one or two
   stay as buttons and the rest move in here. *@

<div class="relative inline-block" @ref="_root">
    <ClickOutside Target="_root" Active="_open" OnClose="Close" />

    <button type="button" @onclick="Toggle" @onclick:stopPropagation="true"
            aria-haspopup="menu" aria-expanded="@_open" title="@Title"
            class="inline-flex items-center justify-center gap-2 px-3 py-2.5 text-sm font-medium
                   text-gray-700 dark:text-slate-300 bg-white dark:bg-slate-800
                   border border-gray-200 dark:border-slate-600 rounded-xl
                   hover:bg-gray-50 dark:hover:bg-slate-700 transition-all duration-200">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
        </svg>
        <span class="@(LabelAlwaysVisible ? "" : "hidden sm:inline")">@Title</span>
    </button>

    @if (_open)
    {
        <div role="menu"
             class="absolute right-0 mt-2 w-56 bg-white dark:bg-slate-800 rounded-xl shadow-lg
                    ring-1 ring-black/5 dark:ring-white/10 py-1 z-50"
             @onclick="Close">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = "More";

    /// <summary>Keeps the text label on narrow screens. Off by default: on a phone the
    /// icon alone is the point of moving these actions out of the row.</summary>
    [Parameter] public bool LabelAlwaysVisible { get; set; }

    private ElementReference _root;
    private bool _open;

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;
}
