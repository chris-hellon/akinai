@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

@*
    Renders nothing. Closes its owner when the user clicks outside
    <see cref="Target"/>, or navigates.

    Drop it inside any popover:

        <div @ref="_root">
            ...
            <ClickOutside Target="_root" Active="_open" OnClose="Close" />
        </div>

    Navigation is handled here as well as the outside click, because the two are
    not the same event. A nav link closes the popover *because the location
    changed*, not because it was clicked — which is what makes the link still
    work.
*@

@code {
    /// <summary>The element that counts as "inside". Clicks within it are ignored.</summary>
    [Parameter, EditorRequired] public ElementReference Target { get; set; }

    /// <summary>Only listens while true, so a closed popover costs nothing.</summary>
    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Also close when the user navigates. On by default.</summary>
    [Parameter] public bool CloseOnNavigate { get; set; } = true;

    private IJSObjectReference? _module;
    private DotNetObjectReference<ClickOutside>? _self;
    private int? _registrationId;
    private bool _subscribedToNavigation;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _subscribedToNavigation = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Active && _registrationId is null) await StartListeningAsync();
        else if (!Active && _registrationId is not null) await StopListeningAsync();
    }

    private async Task StartListeningAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/popover.js");
            _self ??= DotNetObjectReference.Create(this);
            _registrationId = await _module.InvokeAsync<int>("register", Target, _self);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Prerendering, or the circuit is gone. Escape and the close button
            // still work, so the popover is never stuck.
        }
    }

    private async Task StopListeningAsync()
    {
        var id = _registrationId;
        _registrationId = null;
        if (_module is null || id is null) return;

        try { await _module.InvokeVoidAsync("unregister", id.Value); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task OnOutsideClick()
    {
        if (!Active) return;
        await OnClose.InvokeAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!CloseOnNavigate || !Active) return;
        InvokeAsync(async () => await OnClose.InvokeAsync());
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribedToNavigation) Nav.LocationChanged -= OnLocationChanged;

        await StopListeningAsync();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException) { }
        }

        _self?.Dispose();
    }
}
