@*
    A landing page for one sidebar group.

    Every group in the nav now has a page of its own, so the breadcrumb that
    names the group is a real destination rather than dead text — a crumb with
    no href used to render as <a href=""> and navigate to the home page.

    Shared rather than copied into each hub: four near-identical pages would
    drift the moment one of them gained a card.
*@

<div class="space-y-6">
    <PageHeader Title="@Title"
                Description="@Description"
                Breadcrumbs="@(new List<PageHeader.BreadcrumbItem> { new(Title) })" />

    <CardGrid Columns="3">
        @foreach (var link in Links)
        {
            <a href="@link.Href"
               class="group block bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 p-6 transition-all duration-150 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-sm">
                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@link.Icon" />
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100 group-hover:text-primary-700 dark:group-hover:text-primary-300 transition-colors">
                            @link.Title
                        </h2>
                        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">@link.Description</p>
                    </div>
                </div>
            </a>
        }
    </CardGrid>
</div>

@code {
    /// <summary>The group's name, as it appears in the sidebar and the breadcrumb.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Description { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<HubLink> Links { get; set; } = [];

    public record HubLink(string Title, string Description, string Href, string Icon);
}
