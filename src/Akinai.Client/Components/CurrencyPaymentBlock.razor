@using Akinai.Shared.Dtos.CurrencyPaymentSettings
@using Akinai.Shared.Localization
@using Akinai.Shared.Payments

@*
    How to be paid one specific amount, in one specific currency: the scan-to-pay
    code for whatever rail settles it, plus the account details in full.

    Extracted from InvoiceViewContent so the invoice's own currency and any
    alternate currency render through the same markup. They used to be the same
    block only by coincidence, and an invoice that shows two ways to pay must not
    describe them two different ways.
*@

@if (HasAnything)
{
    <div class="@WrapperClass">
        @if (!string.IsNullOrEmpty(Heading))
        {
            <div class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-1">@Heading</div>
        }
        @if (!string.IsNullOrEmpty(SubHeading))
        {
            @* The basis for the amount. An alternate currency is a conversion held at the
               rate when the invoice was issued, and saying so is the difference between
               an option and an argument later about which number was owed. *@
            <div class="text-xs text-gray-500 dark:text-slate-400 mb-3">@SubHeading</div>
        }

        @if (ScanToPay is { } scan)
        {
            <div class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-3">
                Scan to pay (@scan.RailName)
            </div>
            <div class="flex flex-col sm:flex-row items-start gap-4">
                <div class="bg-white p-2 rounded-lg shadow-sm border border-gray-100">
                    <img src="@scan.ImageUri" alt="@scan.RailName payment QR code" class="w-48 h-48 object-contain" />
                </div>
                <div class="text-sm text-gray-600 dark:text-slate-400">
                    <p class="font-medium text-gray-700 dark:text-slate-300 mb-2">@L.ScanWithBankingApp</p>
                    <ul class="space-y-1.5">
                        <li>Amount: @Currency @Amount.ToString("N2")</li>
                        @if (!string.IsNullOrEmpty(Settings?.BankAccountName))
                        {
                            <li>To: @Settings.BankAccountName</li>
                        }
                        @if (scan.ShowsReference)
                        {
                            <li>Reference: @InvoiceNumber</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (HasVietQr)
        {
            <div class="@(ScanToPay is not null ? "mt-6" : "")">
                <div class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-3">Vietnamese Bank Transfer (VietQR)</div>
                <div class="flex flex-col sm:flex-row items-start gap-4">
                    <div class="bg-white p-2 rounded-lg shadow-sm border border-gray-100">
                        <img src="@VietQrUrl" alt="VietQR Payment Code" class="w-48 h-48 object-contain" />
                    </div>
                    <div class="text-sm text-gray-600 dark:text-slate-400">
                        <p class="font-medium text-gray-700 dark:text-slate-300 mb-2">@L.ScanWithBankingApp</p>
                        <ul class="space-y-1.5">
                            <li class="flex items-center gap-2">
                                @Tick Amount: @(((long)Amount).ToString("N0")) VND
                            </li>
                            @if (!string.IsNullOrEmpty(Settings?.BankName))
                            {
                                <li class="flex items-center gap-2">@Tick Bank: @Settings.BankName</li>
                            }
                            @if (!string.IsNullOrEmpty(Settings?.BankAccountName))
                            {
                                <li class="flex items-center gap-2">@Tick Account: @Settings.BankAccountName</li>
                            }
                            @if (!string.IsNullOrEmpty(Settings?.BankAccountNumber))
                            {
                                <li class="flex items-center gap-2">@Tick Account No: @Settings.BankAccountNumber</li>
                            }
                            <li class="flex items-center gap-2">@Tick Reference: Invoice @InvoiceNumber</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
        else if (HasBankTransferDetails)
        {
            <div class="@(ScanToPay is not null ? "mt-6" : "")">
                <div class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-3">@L.BankTransfer</div>
                <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 p-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                        @Field("Bank:", Settings?.BankName, wide: false, preserveLines: false)
                        @Field("Account Name:", Settings?.BankAccountName, wide: false, preserveLines: false)
                        @Field("Account No:", Settings?.BankAccountNumber, wide: false, preserveLines: false)
                        @Field("Sort Code:", Settings?.BankSortCode, wide: false, preserveLines: false)
                        @Field("IBAN:", Settings?.BankIban, wide: true, preserveLines: false)
                        @Field("SWIFT/BIC:", Settings?.BankSwift, wide: false, preserveLines: false)
                        @* Only rendered when filled in — an invoice should not carry
                           empty routing rows. Kept next to the direct details because
                           the payer's bank asks for them on the same form. *@
                        @Field("Bank address:", Settings?.BankAddress, wide: true, preserveLines: true)
                        @Field("Correspondent bank:", Settings?.IntermediaryBankName, wide: false, preserveLines: false)
                        @Field("Correspondent SWIFT/BIC:", Settings?.IntermediaryBankSwift, wide: false, preserveLines: false)
                        @Field("Account at correspondent:", Settings?.IntermediaryAccountNumber, wide: false, preserveLines: false)
                        @Field("Payment purpose:", Settings?.PaymentPurposeCode, wide: false, preserveLines: false)
                        <div class="sm:col-span-2 pt-2 border-t border-gray-100 dark:border-slate-700 mt-2">
                            <span class="text-gray-500 dark:text-slate-400">Reference:</span>
                            <span class="font-medium text-gray-900 dark:text-white ml-2">Invoice @InvoiceNumber</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Currency { get; set; } = "";
    [Parameter, EditorRequired] public decimal Amount { get; set; }
    [Parameter] public CurrencyPaymentSettingsDto? Settings { get; set; }
    [Parameter] public string InvoiceNumber { get; set; } = "";
    [Parameter, EditorRequired] public InvoiceLabelSet L { get; set; } = InvoiceLabels.For(SupportedLanguage.English);

    /// <summary>Whether this account's plan includes scan-to-pay QR codes.</summary>
    [Parameter] public bool ShowScanToPay { get; set; } = true;

    [Parameter] public string? Heading { get; set; }
    [Parameter] public string? SubHeading { get; set; }
    [Parameter] public string WrapperClass { get; set; } = "";

    public bool HasAnything => ScanToPay is not null || HasVietQr || HasBankTransferDetails;

    private sealed record ScanToPayQr(string RailName, string ImageUri, bool ShowsReference);

    /// <summary>
    /// The scan-to-pay code for this amount, or null when no rail covers the currency or
    /// the details on file are not good enough to encode.
    ///
    /// Null rather than a broken image on purpose: an unscannable QR on an invoice is worse
    /// than none at all, because the client reaches for it first and only discovers it does
    /// not work after the payment has failed.
    ///
    /// VietQR is deliberately not routed through here — it is still drawn by the existing
    /// image service, because the EMV payload needs the acquirer's six-digit BIN and what
    /// is stored is a short bank code. Guessing that mapping would produce a scannable code
    /// pointing at the wrong bank, which is far worse than an extra network call.
    /// </summary>
    private ScanToPayQr? ScanToPay
    {
        get
        {
            if (Settings is null || !ShowScanToPay) return null;

            var (rail, account, railName, showsReference) = Currency?.ToUpperInvariant() switch
            {
                "EUR" => (PaymentRail.Epc, Settings.BankIban, "SEPA", true),
                "INR" => (PaymentRail.Upi, Settings.UpiVpa, "UPI", true),
                "BRL" => (PaymentRail.Pix, Settings.PixKey, "PIX", true),
                "THB" => (PaymentRail.PromptPay, Settings.PromptPayId, "PromptPay", false),
                _ => default,
            };

            if (string.IsNullOrWhiteSpace(account)) return null;

            var result = PaymentQrPayload.Build(rail, new PaymentQrRequest(
                PayeeName: Settings.BankAccountName,
                AccountIdentifier: account,
                Amount: Amount,
                CurrencyCode: Currency,
                Reference: InvoiceNumber,
                BeneficiaryBic: Settings.BankSwift));

            if (!result.IsAvailable) return null;

            var image = QrImage.DataUri(result.Payload);
            return image is null ? null : new ScanToPayQr(railName, image, showsReference);
        }
    }

    private bool HasVietQr =>
        string.Equals(Currency, "VND", StringComparison.OrdinalIgnoreCase) &&
        !string.IsNullOrEmpty(Settings?.VietQrBankCode) &&
        !string.IsNullOrEmpty(Settings?.BankAccountNumber);

    private bool HasBankTransferDetails =>
        Settings is not null &&
        (!string.IsNullOrEmpty(Settings.BankAccountNumber) || !string.IsNullOrEmpty(Settings.BankIban));

    /// <summary>A green check, repeated down the VietQR details.</summary>
    private RenderFragment Tick => @<svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>;

    /// <summary>One labelled bank detail, rendered only when it is filled in.</summary>
    private RenderFragment Field(string label, string? value, bool wide = false, bool preserveLines = false)
        => string.IsNullOrWhiteSpace(value)
            ? @<text></text>
            : @<div class="@(wide ? "sm:col-span-2" : "")">
                <span class="text-gray-500 dark:text-slate-400">@label</span>
                <span class="font-medium text-gray-900 dark:text-white ml-2 @(preserveLines ? "whitespace-pre-line" : "")">@value</span>
            </div>;

    private string VietQrUrl
    {
        get
        {
            if (Settings is null) return "";
            var description = Uri.EscapeDataString($"Invoice {InvoiceNumber}");
            var accountName = Uri.EscapeDataString(Settings.BankAccountName ?? "");
            return $"https://img.vietqr.io/image/{Settings.VietQrBankCode}-{Settings.BankAccountNumber}-compact.png" +
                   $"?amount={(long)Amount}&addInfo={description}&accountName={accountName}";
        }
    }
}
