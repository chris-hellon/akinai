@inject ICall<GetBusinessProfile, BusinessProfileDto?> GetBusinessProfileCall
@inject ICall<GetInvoicePreflight, InvoicePreflightDto?> GetPreflightCall
@using Akinai.Shared.Dtos.Preflight

<div class="space-y-6">
    @if (_isLoading)
    {
        <div class="flex justify-center py-8">
            <div class="w-8 h-8 border-2 border-gray-200 border-t-primary-600 rounded-full animate-spin"></div>
        </div>
    }
    else
    {
        @* What the checks found. Advisory by design — a blocking finding is styled to
           stop someone scrolling past it, but Send is never disabled. The rules can be
           wrong about a corridor, and being unable to invoice is worse than sending
           something imperfect. *@
        @if (_preflight is { IsClear: false })
        {
            var blocking = _preflight.Findings.Where(f => f.Severity == PreflightSeverity.Blocking).ToList();
            var warnings = _preflight.Findings.Where(f => f.Severity == PreflightSeverity.Warning).ToList();
            var others = _preflight.Findings.Where(f => f.Severity != PreflightSeverity.Blocking).ToList();

            @* Three tiers, because they mean genuinely different things. Something is wrong
               and the invoice will fail; something might go wrong; or nothing is wrong and
               this is just context. Colouring the third like the second cries wolf, and an
               invoice with nothing actually wrong should not show a warning-coloured box. *@
            var tone = blocking.Count > 0 ? "danger" : warnings.Count > 0 ? "warn" : "info";

            <div class="rounded-xl border @(tone switch {
                    "danger" => "border-red-200 bg-red-50 dark:border-red-900 dark:bg-red-950/40",
                    "warn" => "border-amber-200 bg-amber-50 dark:border-amber-900 dark:bg-amber-950/30",
                    _ => "border-gray-200 bg-gray-50 dark:border-slate-700 dark:bg-slate-800/40",
                }) p-4 space-y-3">
                <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 shrink-0 mt-0.5 @(tone switch {
                             "danger" => "text-red-500",
                             "warn" => "text-amber-500",
                             _ => "text-gray-400 dark:text-slate-500",
                         })"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        @if (tone == "info")
                        {
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        }
                        else
                        {
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        }
                    </svg>
                    <div class="min-w-0">
                        <div class="text-sm font-semibold @(tone switch {
                                "danger" => "text-red-800 dark:text-red-200",
                                "warn" => "text-amber-800 dark:text-amber-200",
                                _ => "text-gray-700 dark:text-slate-300",
                            })">
                            @(tone switch {
                                "danger" => "This invoice has problems worth fixing before you send it",
                                "warn" => "Worth a look before you send",
                                _ => "About this invoice",
                            })
                        </div>
                        <ul class="mt-2 space-y-1.5">
                            @foreach (var f in blocking.Concat(others))
                            {
                                <li class="text-sm text-gray-700 dark:text-slate-300 flex gap-2">
                                    <span class="shrink-0 text-xs uppercase tracking-wide font-semibold mt-0.5
                                                 @(f.Severity switch {
                                                     PreflightSeverity.Blocking => "text-red-600",
                                                     PreflightSeverity.Warning => "text-amber-600",
                                                     _ => "text-gray-400 dark:text-slate-500",
                                                 })">
                                        @f.Area
                                    </span>
                                    <span>@f.Message</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
        else if (_preflight is not null && _preflight.RequiredStatements.Count > 0)
        {
            @* Nothing wrong, but the invoice carries required wording — worth confirming
               it is there rather than leaving the user to wonder. *@
            <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
                <div class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-slate-500">
                    Tax treatment: @_preflight.TaxTreatment
                </div>
                @foreach (var s in _preflight.RequiredStatements)
                {
                    <div class="mt-1.5 text-sm text-gray-700 dark:text-slate-300">@s — included on the invoice.</div>
                }
            </div>
        }

        <!-- Email Icon -->
        <div class="flex justify-center">
            <div class="w-16 h-16 rounded-full flex items-center justify-center bg-primary-50">
                <svg class="w-8 h-8 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </div>
        </div>

        <!-- Form Fields -->
        <div class="space-y-4">
            <!-- To Email -->
            <div>
                <label for="email" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1.5">To</label>
                <input type="email" id="email" @bind="Email" @bind:event="oninput"
                    class="form-control" />
            </div>

            <!-- Subject -->
            <div>
                <label for="subject" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1.5">Subject</label>
                <input type="text" id="subject" @bind="Subject" @bind:event="oninput"
                    class="form-control" />
            </div>

            <!-- Body -->
            <div>
                <label for="body" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1.5">Message</label>
                <textarea id="body" @bind="Body" @bind:event="oninput" rows="8"
                    class="form-control resize-none"></textarea>
            </div>

            <!-- Attachment Info -->
            <div class="flex items-center gap-2 p-3 bg-gray-50 dark:bg-[#2f2924]/30 rounded-xl">
                <svg class="w-5 h-5 text-gray-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                </svg>
                <span class="text-sm text-gray-600 dark:text-slate-400">
                    <span class="font-medium">@(InvoiceNumber).pdf</span> will be attached
                </span>
            </div>

            <!-- View HTML Template -->
            <div class="flex items-center justify-between p-3 bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-800/30 rounded-xl">
                <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                    <span class="text-sm text-primary-700 dark:text-primary-300">
                        Preview HTML email template for manual sending
                    </span>
                </div>
                <a href="/invoice/@InvoiceId/email-template" target="_blank"
                   class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-primary-700 dark:text-primary-300 bg-white dark:bg-primary-900/40 border border-primary-200 dark:border-primary-700 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-900/60 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    <span>View Template</span>
                </a>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex justify-end gap-3 pt-2">
            <button @onclick="Cancel"
                    class="px-5 py-2.5 text-sm font-medium text-gray-700 dark:text-slate-300 bg-white dark:bg-slate-700 border border-gray-200 dark:border-slate-600 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-600 transition-colors">
                Cancel
            </button>
            <button @onclick="Send"
                    disabled="@(_isSending || string.IsNullOrWhiteSpace(Email))"
                    class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white rounded-xl transition-all duration-200 hover:shadow-lg active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed brand-mark">
                @if (_isSending)
                {
                    <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                    <span>Sending...</span>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                    <span>Send Invoice</span>
                }
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public Guid InvoiceId { get; set; }
    [Parameter] public string InvoiceNumber { get; set; } = "";
    [Parameter] public string ClientName { get; set; } = "";
    [Parameter] public string ClientEmail { get; set; } = "";
    [Parameter] public string Currency { get; set; } = "USD";
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public DateOnly DueDate { get; set; }
    [Parameter] public Guid? PublicAccessToken { get; set; }

    public string Email { get; set; } = "";
    public string Subject { get; set; } = "";
    public string Body { get; set; } = "";

    private bool _isLoading = true;
    private InvoicePreflightDto? _preflight;
    private bool _isSending;
    private string _companyName = "Your Company";

    protected override async Task OnInitializedAsync()
    {
        Email = ClientEmail;
        await LoadEmailTemplate();
        await LoadPreflight();
        _isLoading = false;
    }

    /// <summary>
    /// Best-effort: the checks are useful, but failing to fetch them must never stop
    /// someone sending an invoice.
    /// </summary>
    private async Task LoadPreflight()
    {
        try
        {
            _preflight = await GetPreflightCall.Call(new GetInvoicePreflight { Id = InvoiceId });
        }
        catch
        {
            _preflight = null;
        }
    }

    private async Task LoadEmailTemplate()
    {
        try
        {
            var profile = await GetBusinessProfileCall.Call(new GetBusinessProfile());

            // Get template or use defaults
            var subjectTemplate = profile?.InvoiceEmailSubject ?? "Invoice {InvoiceNumber} from {CompanyName}";
            var bodyTemplate = profile?.InvoiceEmailBody ?? GetDefaultEmailBody();
            _companyName = profile?.CompanyName ?? "Your Company";

            // Replace placeholders
            var currencySymbol = CurrencyExtensions.GetSymbol(Currency);

            Subject = ReplacePlaceholders(subjectTemplate, _companyName, currencySymbol);
            Body = ReplacePlaceholders(bodyTemplate, _companyName, currencySymbol);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading email template: {ex.Message}");
            Subject = $"Invoice {InvoiceNumber}";
            Body = GetDefaultEmailBody();
        }
    }

    private string ReplacePlaceholders(string template, string companyName, string currencySymbol)
    {
        var viewOnlineLink = GetViewOnlineLink();

        return template
            .Replace("{InvoiceNumber}", InvoiceNumber)
            .Replace("{ClientName}", ClientName)
            .Replace("{Amount}", $"{currencySymbol}{Amount:N2}")
            .Replace("{DueDate}", DueDate.ToString("MMMM d, yyyy"))
            .Replace("{CompanyName}", companyName)
            .Replace("{ViewOnlineLink}", viewOnlineLink);
    }

    private string GetViewOnlineLink()
    {
        if (PublicAccessToken == null)
            return "";

        // Get the base URL from NavigationManager
        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        return $"{baseUri}/invoice/view/{PublicAccessToken}";
    }

    private string GetDefaultEmailBody()
    {
        var viewOnlineLink = GetViewOnlineLink();
        var viewOnlineSection = !string.IsNullOrEmpty(viewOnlineLink)
            ? $"\n\nView this invoice online: {viewOnlineLink}\n"
            : "";

        return $@"Dear {ClientName},

Please find attached invoice {InvoiceNumber} for {CurrencyExtensions.GetSymbol(Currency)}{Amount:N2}.

Payment is due by {DueDate:MMMM d, yyyy}.{viewOnlineSection}
Thank you for your business.";
    }

    private void Cancel()
    {
        ModalService.Close<SendInvoiceResult?>(null);
    }

    private void Send()
    {
        _isSending = true;
        var result = new SendInvoiceResult(Email, Subject, Body);
        ModalService.Close(result);
    }
}
