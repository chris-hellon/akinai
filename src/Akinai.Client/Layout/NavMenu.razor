@implements IDisposable

<div class="flex flex-col h-full">
    <!-- Logo Section -->
    <div class="logo-section flex items-center gap-3 h-16 px-6 border-b border-[#e5e1d7] dark:border-[#2f2924]">
        <span class="app-hanko shrink-0">商</span>
        <span class="logo-text app-wordmark">Akin<span class="wm-ai">ai</span></span>
    </div>

    <!-- Navigation Links -->
    <nav class="flex-1 px-3 py-6 space-y-1.5 overflow-y-auto">
        <!-- Dashboard -->
        <NavLink href="dashboard" Match="NavLinkMatch.All"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
            </svg>
            <span class="nav-text">Dashboard</span>
        </NavLink>

        <!-- Section: Admin — only rendered for admins. This is presentation
             only; /api/admin endpoints enforce the role server-side. -->
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-section-title pt-6 pb-2">
                    <a href="admin" class="px-4 text-[11px] font-semibold text-slate-500 uppercase tracking-wider hover:text-primary-600 transition-colors">Admin</a>
                </div>

                <NavLink href="admin/users"
                         class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                         ActiveClass="active">
                    <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <span class="nav-text">Users</span>
                </NavLink>

                <NavLink href="admin/plans"
                         class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                         ActiveClass="active">
                    <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                    </svg>
                    <span class="nav-text">Plans</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <!-- Section: Management -->
        <div class="nav-section-title pt-6 pb-2">
            <a href="management" class="px-4 text-[11px] font-semibold text-slate-500 uppercase tracking-wider hover:text-primary-600 transition-colors">Management</a>
        </div>

        <NavLink href="clients"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span class="nav-text">Clients</span>
        </NavLink>

        <NavLink href="projects"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
            </svg>
            <span class="nav-text">Projects</span>
        </NavLink>

        <NavLink href="jobs"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
            <span class="nav-text">Jobs</span>
        </NavLink>

        <NavLink href="products"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <span class="nav-text">Products</span>
        </NavLink>

        <!-- Section: Time & Billing -->
        <div class="nav-section-title pt-6 pb-2">
            <a href="time-billing" class="px-4 text-[11px] font-semibold text-slate-500 uppercase tracking-wider hover:text-primary-600 transition-colors">Time & Billing</a>
        </div>

        <NavLink href="timesheet"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="nav-text">Timesheet</span>
        </NavLink>

        <!-- Invoices Submenu -->
        <button @onclick="ToggleInvoices" type="button"
                class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150 w-full">
            <svg class="w-5 h-5 opacity-70 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="nav-text flex-1 text-left">Invoices</span>
            <svg class="w-4 h-4 opacity-60 shrink-0 nav-text transition-transform @(_invoicesExpanded ? "rotate-90" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </button>

        @if (_invoicesExpanded)
        {
            <NavLink href="invoices" Match="NavLinkMatch.All"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">All Invoices</span>
            </NavLink>
            <NavLink href="recurring-invoices"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">Recurring</span>
            </NavLink>
        }

        <NavLink href="estimates"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <span class="nav-text">Estimates</span>
        </NavLink>

        <!-- Expenses -->
        <button @onclick="ToggleExpenses" type="button"
                class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150 w-full">
            <svg class="w-5 h-5 opacity-70 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            <span class="nav-text flex-1 text-left">Expenses</span>
            <svg class="w-4 h-4 opacity-60 shrink-0 nav-text transition-transform @(_expensesExpanded ? "rotate-90" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </button>

        @if (_expensesExpanded)
        {
            <NavLink href="expenses" Match="NavLinkMatch.All"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">Expenses</span>
            </NavLink>
            <NavLink href="recurring-expenses"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">Recurring</span>
            </NavLink>
        }

        <!-- Section: Finance -->
        <div class="nav-section-title pt-6 pb-2">
            <a href="finance" class="px-4 text-[11px] font-semibold text-slate-500 uppercase tracking-wider hover:text-primary-600 transition-colors">Finance</a>
        </div>

        <NavLink href="reports"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span class="nav-text">Reports</span>
        </NavLink>

        <NavLink href="cash-flow"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <span class="nav-text">Cash Flow</span>
        </NavLink>

        <NavLink href="bank-import"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            <span class="nav-text">Bank Import</span>
        </NavLink>



        <!-- Section: Settings -->
        <div class="nav-section-title pt-6 pb-2">
            <a href="settings" class="px-4 text-[11px] font-semibold text-slate-500 uppercase tracking-wider hover:text-primary-600 transition-colors">Settings</a>
        </div>

        <NavLink href="settings/business"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span class="nav-text">Business Profile</span>
        </NavLink>

        <NavLink href="settings/billing"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            <span class="nav-text">Billing</span>
        </NavLink>

        <NavLink href="settings/invoicing"
                 class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150"
                 ActiveClass="active">
            <svg class="w-5 h-5 opacity-70 group-[.active]:opacity-100 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="nav-text">Invoicing</span>
        </NavLink>

        <!-- Account Dropdown -->
        <button @onclick="ToggleAccount" type="button"
                class="nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150 w-full">
            <svg class="w-5 h-5 opacity-70 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="nav-text flex-1 text-left">Account</span>
            <svg class="w-4 h-4 opacity-60 shrink-0 nav-text transition-transform @(_accountExpanded ? "rotate-90" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </button>

        @if (_accountExpanded)
        {
            <NavLink href="account/manage" Match="NavLinkMatch.All"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">Profile</span>
            </NavLink>
            <NavLink href="account/manage/email"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">Email</span>
            </NavLink>
            <NavLink href="account/manage/change-password"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">Password</span>
            </NavLink>
            <NavLink href="account/manage/two-factor-authentication"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">Two-Factor Auth</span>
            </NavLink>
            <NavLink href="account/manage/passkeys"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">Passkeys</span>
            </NavLink>
            <NavLink href="account/manage/personal-data"
                     class="nav-link group relative flex items-center gap-3 pl-12 pr-4 py-2 text-sm font-medium rounded-xl transition-colors duration-150"
                     ActiveClass="active">
                <span class="nav-text">Personal Data</span>
            </NavLink>
        }
    </nav>

    <!-- Sign Out Section -->
    <div class="px-3 pb-6 border-t border-[#e5e1d7] dark:border-[#2f2924] pt-4">
        <AuthorizeView>
            <Authorized>
                <!-- Expanded sign out button -->
                <button @onclick="ShowSignOutConfirmation"
                        class="user-section-expanded nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150 w-full">
                    <svg class="w-5 h-5 opacity-70 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span class="nav-text">Sign Out</span>
                </button>
                <!-- Collapsed sign out button -->
                <button @onclick="ShowSignOutConfirmation"
                        class="user-section-collapsed hidden nav-link group relative flex items-center justify-center px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150 w-full"
                        title="Sign Out">
                    <svg class="w-5 h-5 opacity-70 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                </button>
            </Authorized>
            <NotAuthorized>
                <NavLink href="account/login"
                         class="user-section-expanded nav-link group relative flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150 w-full">
                    <svg class="w-5 h-5 opacity-70 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                    </svg>
                    <span class="nav-text">Sign In</span>
                </NavLink>
                <NavLink href="account/login"
                         class="user-section-collapsed hidden nav-link group relative flex items-center justify-center px-4 py-2.5 text-sm font-medium rounded-xl transition-colors duration-150 w-full"
                         title="Sign In">
                    <svg class="w-5 h-5 opacity-70 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                    </svg>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>


@code {
    private string? _currentUrl;
    private bool _expensesExpanded;
    private bool _invoicesExpanded;
    private bool _accountExpanded;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        // Set initial expanded state based on current URL
        _expensesExpanded = _currentUrl != null &&
            (_currentUrl.StartsWith("expenses", StringComparison.OrdinalIgnoreCase) ||
             _currentUrl.StartsWith("recurring-expenses", StringComparison.OrdinalIgnoreCase));

        _invoicesExpanded = _currentUrl != null &&
            (_currentUrl.StartsWith("invoices", StringComparison.OrdinalIgnoreCase) ||
             _currentUrl.StartsWith("recurring-invoices", StringComparison.OrdinalIgnoreCase));

        _accountExpanded = _currentUrl != null &&
            _currentUrl.StartsWith("account/manage", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);

        // Auto-expand/collapse expenses based on current URL
        var isOnExpensesPage = _currentUrl != null &&
            (_currentUrl.StartsWith("expenses", StringComparison.OrdinalIgnoreCase) ||
             _currentUrl.StartsWith("recurring-expenses", StringComparison.OrdinalIgnoreCase));
        _expensesExpanded = isOnExpensesPage;

        // Auto-expand/collapse invoices based on current URL
        var isOnInvoicesPage = _currentUrl != null &&
            (_currentUrl.StartsWith("invoices", StringComparison.OrdinalIgnoreCase) ||
             _currentUrl.StartsWith("recurring-invoices", StringComparison.OrdinalIgnoreCase));
        _invoicesExpanded = isOnInvoicesPage;

        // Auto-expand/collapse account based on current URL
        var isOnAccountPage = _currentUrl != null &&
            _currentUrl.StartsWith("account/manage", StringComparison.OrdinalIgnoreCase);
        _accountExpanded = isOnAccountPage;

        StateHasChanged();
    }

    private void ToggleExpenses()
    {
        _expensesExpanded = !_expensesExpanded;
    }

    private void ToggleInvoices()
    {
        _invoicesExpanded = !_invoicesExpanded;
    }

    private void ToggleAccount()
    {
        _accountExpanded = !_accountExpanded;
    }

    private async Task ShowSignOutConfirmation()
    {
        var confirmed = await ModalService.ShowAsync<bool>(
            typeof(SignOutConfirmationModal),
            "Sign Out",
            new Dictionary<string, object>
            {
                { "ReturnUrl", _currentUrl ?? "" }
            });

        if (confirmed)
        {
            NavigationManager.NavigateTo("account/logout", forceLoad: true);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
