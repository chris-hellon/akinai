<!DOCTYPE html>
<html lang="en">
<script>
    // Apply dark mode immediately to prevent flash - runs before any content renders
    (function() {
        try {
            var p = location.pathname.toLowerCase().replace(/\/+$/, '');
            var alwaysLight = (p === '') ||
                (p.indexOf('/account/') === 0 && p.indexOf('/account/manage') !== 0);
            if (alwaysLight) return;

            var stored = localStorage.getItem('darkMode');
            // Only apply if user has explicitly set preference, or fall back to system preference
            if (stored === 'true' || (stored === null && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        } catch (e) {}
    })();
</script>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>

    @* Social preview. Without these, the site pasted into Slack, WhatsApp or a
       tweet renders as a bare URL — which matters for a product that spreads by
       one freelancer recommending it to another.

       Static rather than per-page: the pages worth sharing are the public ones,
       and everything behind the login is a private document nobody should be
       generating a preview card for. Suppressed on print routes, where the only
       consumer is headless Chromium. *@
    @if (!IsPrintRoute)
    {
        <meta name="description" content="@MetaDescription"/>

        <meta property="og:type" content="website"/>
        <meta property="og:site_name" content="Akinai"/>
        <meta property="og:title" content="@MetaTitle"/>
        <meta property="og:description" content="@MetaDescription"/>
        <meta property="og:image" content="@AbsoluteUrl("og-image.png")"/>
        <meta property="og:image:width" content="1200"/>
        <meta property="og:image:height" content="630"/>
        <meta property="og:url" content="@CurrentUrl"/>

        @* summary_large_image, not summary: the card art is a 1200x630 banner,
           and the small variant would crop it to a square thumbnail. *@
        <meta name="twitter:card" content="summary_large_image"/>
        <meta name="twitter:title" content="@MetaTitle"/>
        <meta name="twitter:description" content="@MetaDescription"/>
        <meta name="twitter:image" content="@AbsoluteUrl("og-image.png")"/>
    }

    <ResourcePreloader/>
    @if (!IsPrintRoute)
    {
        <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Caveat:wght@500;600&family=Shippori+Mincho:wght@500;600;700;800&family=Noto+Sans:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
    }
    <link rel="stylesheet" href="@Assets["css/shared.css"]"/>
    <link rel="stylesheet" href="@Assets["Akinai.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/svg+xml" href="favicon.svg"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="PageRenderMode"/>
</head>

<body>
<Routes @rendermode="PageRenderMode"/>
@if (!IsPrintRoute)
{
    <ReconnectModal/>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
}
<script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
<script src="@Assets["js/tooltip.js"]"></script>
<script src="@Assets["js/formcontrols.js"]"></script>
<script>
    window.downloadFile = function(fileName, base64, contentType) {
        const link = document.createElement('a');
        link.href = 'data:' + contentType + ';base64,' + base64;
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };
</script>
<script>
    (function () {
        function run() {
            var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var els = document.querySelectorAll('.reveal:not(.in)');
            if (!els.length) return;
            if (reduce || !('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('in'); }); return; }
            if (!window.__revealIO) {
                window.__revealIO = new IntersectionObserver(function (es) {
                    es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); window.__revealIO.unobserve(e.target); } });
                }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
            }
            els.forEach(function (el) { window.__revealIO.observe(el); });
        }
        document.addEventListener('DOMContentLoaded', run);
        var mo = new MutationObserver(run);
        mo.observe(document.documentElement, { childList: true, subtree: true });
        setTimeout(run, 300); setTimeout(run, 1200); setTimeout(function () { mo.disconnect(); }, 4000);
    })();
</script>
<script>
    document.addEventListener('click', function (e) {
        if (e.target.closest && e.target.closest('.mobilemenu a')) {
            var cb = document.getElementById('navtoggle');
            if (cb) cb.checked = false;
        }
    });
</script>
<script>
    document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="#"]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        if (href.length < 2) return;
        var el = document.getElementById(href.slice(1));
        if (!el) return;
        e.preventDefault();
        e.stopPropagation();
        var cb = document.getElementById('navtoggle');
        if (cb) cb.checked = false;
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        if (history.replaceState) history.replaceState(null, '', href);
    }, true);
</script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting()
            ? new InteractiveAutoRenderMode(prerender: IsPublicPage)
            : null;

    /// <summary>
    /// The public marketing and legal pages, which are prerendered so their
    /// content exists in the served HTML.
    ///
    /// Everything else ships an empty body and builds itself in the browser.
    /// That is the right default for the app — those pages are behind a login,
    /// so there is nothing to index, and prerendering them would mean rendering
    /// each one twice and paying for a database round trip whose result the
    /// client immediately re-fetches.
    ///
    /// These four are the opposite case: nobody is signed in, the content is
    /// the product pitch, and a crawler that does not execute JavaScript would
    /// otherwise see a blank page.
    ///
    /// Matched exactly rather than by prefix. A prefix would quietly pull in
    /// anything nested underneath a marketing path later on.
    /// </summary>
    private bool IsPublicPage
    {
        get
        {
            var path = HttpContext.Request.Path.Value?.TrimEnd('/');

            return string.IsNullOrEmpty(path)          // "/" — the landing page
                || string.Equals(path, "/privacy", StringComparison.OrdinalIgnoreCase)
                || string.Equals(path, "/terms", StringComparison.OrdinalIgnoreCase)
                || string.Equals(path, "/contact", StringComparison.OrdinalIgnoreCase);
        }
    }

    /// <summary>
    /// The headless-Chromium print routes. They render static HTML and are
    /// thrown away after one screenshot, so every script on them is wasted work
    /// — and worse, work the renderer blocks on.
    ///
    /// Both document types are listed. Adding a print route without adding it
    /// here silently costs seconds per PDF: blazor.web.js pulls the WebAssembly
    /// runtime onto the page and the renderer waits for it.
    /// </summary>
    private bool IsPrintRoute =>
        HttpContext.Request.Path.StartsWithSegments("/invoice/print")
        || HttpContext.Request.Path.StartsWithSegments("/estimate/print");

    // --- Social preview ---------------------------------------------------

    private const string MetaTitle = "Akinai — Invoicing for freelancers with clients abroad";

    private const string MetaDescription =
        "Invoicing software for people billing clients in more than one country. "
        + "Each client gets an invoice in their own language, priced in their own "
        + "currency, payable by bank transfer, VietQR, PayPal, Wise or Revolut.";

    /// <summary>The URL being served, for og:url.</summary>
    private string CurrentUrl
    {
        get
        {
            var request = HttpContext.Request;
            return $"{request.Scheme}://{request.Host}{request.Path}";
        }
    }

    /// <summary>
    /// Absolute URL for a wwwroot asset. Scrapers do not resolve relative paths,
    /// so a relative og:image is simply no image.
    /// </summary>
    private string AbsoluteUrl(string path)
    {
        var request = HttpContext.Request;
        return $"{request.Scheme}://{request.Host}/{path.TrimStart('/')}";
    }
}