@implements IDisposable
@inject ReportingCurrencyState State

<div class="relative">
    @if (_open)
    {
        <div class="fixed inset-0 z-40" @onclick="Close"></div>
    }

    <button type="button"
            class="inline-flex items-center gap-2 h-9 px-3 rounded-lg border border-gray-200 dark:border-[#2f2924] bg-gray-50 dark:bg-[#0f0b08] text-gray-600 dark:text-slate-300 hover:border-gray-300 dark:hover:border-slate-600 transition-colors"
            @onclick="Toggle" @onclick:stopPropagation="true" title="Reporting currency">
        <span class="text-[11px] font-semibold tracking-wide" style="font-family:'IBM Plex Mono',monospace">REPORTING · @State.Currency</span>
        <svg class="w-3 h-3 text-gray-400 transition-transform @(_open ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M19 9l-7 7-7-7" /></svg>
    </button>

    @if (_open)
    {
        <div class="absolute right-0 mt-2 w-44 bg-white dark:bg-[#1b1612] rounded-xl shadow-lg ring-1 ring-black/5 dark:ring-white/10 py-1 z-50 max-h-72 overflow-y-auto">
            <div class="px-3 py-2 text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500" style="font-family:'IBM Plex Mono',monospace">Report figures in</div>
            @foreach (var cur in State.Available)
            {
                <button type="button"
                        class="w-full flex items-center justify-between px-3 py-2 text-sm text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-[#14100c] transition-colors"
                        @onclick="() => Select(cur)">
                    <span class="font-medium">@cur</span>
                    @if (string.Equals(cur, State.Currency, StringComparison.OrdinalIgnoreCase))
                    {
                        <svg class="w-4 h-4 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M5 13l4 4L19 7" /></svg>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private bool _open;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnChanged;
        await State.InitializeAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private async Task Select(string currency)
    {
        _open = false;
        await State.SetAsync(currency);
    }

    public void Dispose() => State.OnChange -= OnChanged;
}
