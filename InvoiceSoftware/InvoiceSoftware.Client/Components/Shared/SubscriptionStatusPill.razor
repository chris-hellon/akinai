@using InvoiceSoftware.Shared.Billing

@*
    Subscription status as a pill. "Cancelling" is amber rather than red on
    purpose: the account still has everything it paid for until the period ends.
*@

<span class="px-2.5 py-1 text-xs font-medium rounded-full @Classes">@Label</span>

@code {
    [Parameter, EditorRequired] public SubscriptionStatus Status { get; set; }

    private string Label => Status switch
    {
        SubscriptionStatus.None => "Free",
        SubscriptionStatus.Active => "Active",
        SubscriptionStatus.Cancelling => "Cancelling",
        SubscriptionStatus.Expired => "Expired",
        SubscriptionStatus.PastDue => "Past due",
        _ => Status.ToString(),
    };

    private string Classes => Status switch
    {
        SubscriptionStatus.Active =>
            "bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300",
        SubscriptionStatus.Cancelling =>
            "bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300",
        SubscriptionStatus.Expired or SubscriptionStatus.PastDue =>
            "bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300",
        _ => "bg-gray-100 dark:bg-[#2f2924] text-gray-600 dark:text-slate-300",
    };
}
