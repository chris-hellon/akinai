@typeparam TItem

<div class="bg-white dark:bg-[#1a1827] rounded-lg border border-gray-100 dark:border-[#2d2a4a] overflow-hidden">
    <!-- Table view (always shown when no CardTemplate; desktop-only when a CardTemplate is supplied) -->
    <div class="overflow-x-auto overscroll-x-contain @(CardTemplate != null ? "hidden md:block" : "")">
        <table class="min-w-full">
            <thead>
                <tr class="bg-gray-50/80 dark:bg-[#1a1827]/80">
                    @HeaderTemplate
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-[#2d2a4a]">
                @if (Items != null)
                {
                    @foreach (var item in Items)
                    {
                        @RowTemplate(item)
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Card view (mobile only) -->
    @if (CardTemplate != null)
    {
        <div class="md:hidden divide-y divide-gray-100 dark:divide-[#2d2a4a]">
            @if (Items != null)
            {
                @foreach (var item in Items)
                {
                    @CardTemplate(item)
                }
            }
        </div>
    }
</div>

@if (TotalCount > PageSize || OnPageSizeChanged.HasDelegate)
{
    <Pagination CurrentPage="CurrentPage"
                TotalItems="TotalCount"
                PageSize="PageSize"
                ItemName="@ItemName"
                OnPageChanged="OnPageChanged"
                OnPageSizeChanged="OnPageSizeChanged"
                PageSizeOptions="PageSizeOptions" />
}

@code {
    [Parameter, EditorRequired]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? HeaderTemplate { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    /// <summary>Optional per-item card rendered on small screens instead of the table.</summary>
    [Parameter]
    public RenderFragment<TItem>? CardTemplate { get; set; }

    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 15;

    [Parameter]
    public string ItemName { get; set; } = "items";

    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnPageSizeChanged { get; set; }

    [Parameter]
    public int[]? PageSizeOptions { get; set; }
}
