@page "/projects"

@inject ICall<GetProjects, PaginatedResponse<ProjectDto>> GetProjectsCall
@inject ICall<GetClients, PaginatedResponse<ClientDto>> GetClientsCall
@inject ICall<DeleteProject> DeleteProjectCall
@inject NavigationManager NavigationManager

<PageTitle>Projects - InvoicePro</PageTitle>

<ListPageLayout Title="Projects"
                Description="Manage your projects across all clients."
                ActionUrl="projects/new"
                ActionText="New Project"
                SearchPlaceholder="Search projects..."
                SearchValue="@searchTerm"
                SearchValueChanged="OnSearchChanged"
                Breadcrumbs="@(new List<PageHeader.BreadcrumbItem> { new("Projects") })">
    <Filters>
        <Select TValue="string" Value="selectedClientId" ValueChanged="OnClientChanged" Class="w-full sm:w-52"
                Options="@(new[] { new SelectOption<string>("", "All Clients") }.Concat(clientsForFilter?.Select(c => new SelectOption<string>(c.Id.ToString(), c.Name)) ?? []).ToList())" />
        <Select TValue="string" Value="selectedStatus" ValueChanged="OnStatusChanged" Searchable="false" Class="w-full sm:w-44"
                Options="@(new List<SelectOption<string>> { new("", "All Status"), new("Active", "Active"), new("OnHold", "On Hold"), new("Completed", "Completed"), new("Archived", "Archived") })" />
    </Filters>
    <ChildContent>
        @if (isLoading)
        {
            <LoadingTable Rows="5" Columns="6" />
        }
        else if (response == null || !response.Items.Any())
        {
            <EmptyState Title="No projects found"
                        Message="@(HasActiveFilters ? "No projects match your filters. Try adjusting your search." : "Get started by creating your first project.")"
                        IconType="EmptyState.EmptyStateIcon.Folder"
                        ActionUrl="@(HasActiveFilters ? null : "projects/new")"
                        ActionText="@(HasActiveFilters ? null : "New Project")" />
        }
        else
        {
            <DataTable TItem="ProjectDto"
                       Items="response.Items"
                       CurrentPage="response.Page"
                       TotalCount="response.TotalCount"
                       PageSize="response.PageSize"
                       ItemName="projects"
                       OnPageChanged="OnPageChanged"
                       OnPageSizeChanged="OnPageSizeChanged">
                <HeaderTemplate>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Project</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Client</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Jobs</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Rate</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                    <th scope="col" class="relative px-6 py-4"><span class="sr-only">Actions</span></th>
                </HeaderTemplate>
                <RowTemplate Context="project">
                    <tr class="group hover:bg-gray-50/50 dark:hover:bg-[#2d2a4a]/50 transition-colors">
                        <td class="px-6 py-4">
                            <a href="projects/@project.Id" class="text-sm font-medium text-gray-900 dark:text-slate-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors hover:underline">@project.Name</a>
                            @if (!string.IsNullOrEmpty(project.Description))
                            {
                                <div class="text-sm text-gray-500 dark:text-slate-400 truncate max-w-xs">@project.Description</div>
                            }
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm text-gray-900 dark:text-slate-100">@project.ClientName</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-gray-900 dark:text-slate-100">@project.JobCount</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (project.HourlyRateOverride.HasValue)
                            {
                                <div class="text-sm text-gray-900 dark:text-slate-100">$@project.HourlyRateOverride.Value.ToString("N2")/hr</div>
                            }
                            else
                            {
                                <div class="text-sm text-gray-400 dark:text-slate-500">Default</div>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="@ProjectStatusExtensions.Parse(project.Status).GetBadgeClass()">@ProjectStatusExtensions.Parse(project.Status).GetDisplayName()</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            <div class="flex items-center justify-end gap-1">
                                <IconButton Href="@($"projects/{project.Id}")" Title="View">
                                    <ViewIcon />
                                </IconButton>
                                <IconButton Href="@($"projects/{project.Id}/edit")" Title="Edit">
                                    <EditIcon />
                                </IconButton>
                                <IconButton OnClick="() => DeleteProjectAsync(project)" Variant="IconButton.IconButtonVariant.Danger" Title="Delete">
                                    <DeleteIcon />
                                </IconButton>
                            </div>
                        </td>
                    </tr>
                </RowTemplate>
                <CardTemplate Context="project">
                    <div class="p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <a href="projects/@project.Id" class="text-sm font-semibold text-gray-900 dark:text-slate-100 hover:underline">@project.Name</a>
                                    <span class="@ProjectStatusExtensions.Parse(project.Status).GetBadgeClass()">@ProjectStatusExtensions.Parse(project.Status).GetDisplayName()</span>
                                </div>
                                <div class="mt-1 text-sm text-gray-500 dark:text-slate-400 truncate">@project.ClientName</div>
                                <div class="mt-1 text-xs text-gray-500 dark:text-slate-400">
                                    @project.JobCount jobs@(project.HourlyRateOverride.HasValue ? $" • ${project.HourlyRateOverride.Value:N2}/hr" : "")
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-gray-50 dark:border-[#2d2a4a] flex items-center justify-end gap-1">
                            <IconButton Href="@($"projects/{project.Id}")" Title="View">
                                <ViewIcon />
                            </IconButton>
                            <IconButton Href="@($"projects/{project.Id}/edit")" Title="Edit">
                                <EditIcon />
                            </IconButton>
                            <IconButton OnClick="() => DeleteProjectAsync(project)" Variant="IconButton.IconButtonVariant.Danger" Title="Delete">
                                <DeleteIcon />
                            </IconButton>
                        </div>
                    </div>
                </CardTemplate>
            </DataTable>
        }
    </ChildContent>
</ListPageLayout>

@code {
    private PaginatedResponse<ProjectDto>? response;
    private List<ClientDto>? clientsForFilter;
    private bool isLoading = true;
    private string searchTerm = "";
    private string selectedClientId = "";
    private string selectedStatus = "";
    private int currentPage = 1;
    private int pageSize = 50;

    private bool HasActiveFilters => !string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(selectedStatus) || !string.IsNullOrEmpty(selectedClientId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var clientsResponse = await GetClientsCall.Call(new GetClients { PageSize = 1000 });
            clientsForFilter = clientsResponse?.Items ?? [];
            await LoadProjects();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            response = new PaginatedResponse<ProjectDto>();
            clientsForFilter = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadProjects()
    {
        isLoading = true;
        try
        {
            response = await GetProjectsCall.Call(new GetProjects
            {
                ClientId = string.IsNullOrEmpty(selectedClientId) ? null : Guid.Parse(selectedClientId),
                Status = string.IsNullOrEmpty(selectedStatus) ? null : selectedStatus,
                Page = currentPage,
                PageSize = pageSize,
                Search = searchTerm
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading projects: {ex.Message}");
            response = new PaginatedResponse<ProjectDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        currentPage = 1;
        await LoadProjects();
    }

    private async Task OnClientChanged(string value)
    {
        selectedClientId = value;
        await OnFilterChanged();
    }

    private async Task OnStatusChanged(string value)
    {
        selectedStatus = value;
        await OnFilterChanged();
    }

    private async Task OnSearchChanged(string value)
    {
        searchTerm = value;
        currentPage = 1;
        await LoadProjects();
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadProjects();
    }

    private async Task OnPageSizeChanged(int size)
    {
        pageSize = size;
        currentPage = 1;
        await LoadProjects();
    }

    private async Task DeleteProjectAsync(ProjectDto project)
    {
        var confirmed = await ModalService.ShowAsync<bool>(
            typeof(DeleteConfirmationModal),
            "Delete Project",
            new Dictionary<string, object>
            {
                { "ItemName", project.Name },
                { "WarningMessage", "All jobs, tasks, and time entries associated with this project will be permanently deleted." }
            },
            new ModalOptions { Size = ModalSize.Small });

        if (!confirmed) return;

        try
        {
            await DeleteProjectCall.Call(new DeleteProject { Id = project.Id });
            await LoadProjects();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting project: {ex.Message}");
        }
    }
}
