@page "/settings"

@*
    A real destination for the "Settings" breadcrumb.

    Every settings page carried a Settings crumb that pointed nowhere, so it
    rendered as <a href=""> and quietly navigated to the home page. Rather than
    strip the crumb, this gives it somewhere to go — and a landing page is
    genuinely useful for finding an area you only visit occasionally.
*@

<PageTitle>Settings - Akinai</PageTitle>

<div class="space-y-6">
    <PageHeader Title="Settings"
                Description="Your business details, how invoices go out, and your plan."
                Breadcrumbs="@(new List<PageHeader.BreadcrumbItem> { new("Settings") })" />

    <CardGrid Columns="3">
        @foreach (var area in Areas)
        {
            <a href="@area.Href"
               class="group block bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700 p-6 transition-all duration-150 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-sm">
                <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@area.Icon" />
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <h2 class="text-sm font-semibold text-gray-900 dark:text-slate-100 group-hover:text-primary-700 dark:group-hover:text-primary-300 transition-colors">
                            @area.Title
                        </h2>
                        <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">@area.Description</p>
                    </div>
                </div>
            </a>
        }
    </CardGrid>
</div>

@code {
    private record SettingsArea(string Title, string Description, string Href, string Icon);

    private static readonly SettingsArea[] Areas =
    [
        new("Business Profile",
            "Company details, address and logo as they appear on your documents.",
            "settings/business",
            "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"),

        new("Invoicing",
            "Defaults, payment details, templates and the language you invoice in.",
            "settings/invoicing",
            "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"),

        new("Billing",
            "Your plan, what it includes, and your invoice allowance this month.",
            "settings/billing",
            "M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"),

        new("Account",
