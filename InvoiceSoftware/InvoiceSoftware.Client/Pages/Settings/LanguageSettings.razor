@page "/settings/languages"

@inject NavigationManager NavigationManager

@*
    Kept as a redirect, not deleted: these three pages were merged into
    /settings/invoicing, and bookmarks, the nav and any links a user has saved
    should still land somewhere useful rather than on a 404.
*@

@code {
    protected override void OnInitialized()
        => NavigationManager.NavigateTo("settings/invoicing?tab=language", replace: true);
}
