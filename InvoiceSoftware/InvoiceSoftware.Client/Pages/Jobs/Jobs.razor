@page "/jobs"

@inject ICall<GetJobs, PaginatedResponse<JobDto>> GetJobsCall
@inject ICall<DeleteJob> DeleteJobCall
@inject ICall<MarkJobComplete> MarkJobCompleteCall
@inject ICall<ReopenJob> ReopenJobCall

<PageTitle>Jobs - InvoicePro</PageTitle>

<ListPageLayout Title="Jobs"
                Description="Manage tasks and jobs across your projects."
                ActionUrl="jobs/new"
                ActionText="New Job"
                SearchPlaceholder="Search jobs..."
                SearchValue="@_searchTerm"
                SearchValueChanged="OnSearchChanged"
                Breadcrumbs="@(new List<PageHeader.BreadcrumbItem> { new("Jobs") })">
    <Filters>
        <Select TValue="string" Value="_selectedStatus" ValueChanged="OnStatusChanged" Searchable="false" Class="w-full sm:w-44"
                Options="@(new List<SelectOption<string>>
                {
                    new("", "All Status"),
                    new("Active", "Active"),
                    new("OnHold", "On Hold"),
                    new("Completed", "Completed")
                })" />
    </Filters>
    <ChildContent>
        @if (_isLoading)
        {
            <LoadingTable Rows="5" Columns="7" />
        }
        else if (_response == null || !_response.Items.Any())
        {
            <EmptyState Title="No jobs found"
                        Message="@(HasActiveFilters ? "No jobs match your filters. Try adjusting your search." : "Get started by creating your first job.")"
                        IconType="EmptyState.EmptyStateIcon.Clipboard"
                        ActionUrl="@(HasActiveFilters ? null : "jobs/new")"
                        ActionText="@(HasActiveFilters ? null : "New Job")" />
        }
        else
        {
            <DataTable TItem="JobDto"
                       Items="_response.Items"
                       CurrentPage="_response.Page"
                       TotalCount="_response.TotalCount"
                       PageSize="_response.PageSize"
                       ItemName="jobs"
                       OnPageChanged="OnPageChanged"
                       OnPageSizeChanged="OnPageSizeChanged">
                <HeaderTemplate>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Job</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Project</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Client</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Est. Hours</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Rate</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                    <th scope="col" class="relative px-6 py-4"><span class="sr-only">Actions</span></th>
                </HeaderTemplate>
                <RowTemplate Context="job">
                    <tr class="group hover:bg-gray-50/50 dark:hover:bg-[#2d2a4a]/50 transition-colors">
                        <td class="px-6 py-4">
                            <a href="jobs/@job.Id" class="text-sm font-medium text-gray-900 dark:text-slate-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors hover:underline">@job.Name</a>
                            @if (!string.IsNullOrEmpty(job.Description))
                            {
                                <div class="text-sm text-gray-500 dark:text-slate-400 truncate max-w-xs">@job.Description</div>
                            }
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm font-medium text-gray-900 dark:text-slate-100">@job.ProjectName</div>
                            @if (!string.IsNullOrEmpty(job.SectionName))
                            {
                                <div class="text-xs text-gray-500 dark:text-slate-400 mt-0.5 truncate max-w-[200px]">@job.SectionName</div>
                            }
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm text-gray-900 dark:text-slate-100">@job.ClientName</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (job.EstimatedHours.HasValue)
                            {
                                <div class="text-sm text-gray-900 dark:text-slate-100">@job.EstimatedHours.Value.ToString("N1") hrs</div>
                            }
                            else
                            {
                                <div class="text-sm text-gray-400 dark:text-slate-500">-</div>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (job.HourlyRateOverride.HasValue)
                            {
                                <div class="text-sm text-gray-900 dark:text-slate-100">$@job.HourlyRateOverride.Value.ToString("N2")/hr</div>
                            }
                            else
                            {
                                <div class="text-sm text-gray-400 dark:text-slate-500">Default</div>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="@JobStatusExtensions.Parse(job.Status).GetBadgeClass()">@JobStatusExtensions.Parse(job.Status).GetDisplayName()</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            <div class="flex items-center justify-end gap-1">
                                @if (job.Status != "Completed")
                                {
                                    <IconButton OnClick="() => MarkComplete(job.Id)" Disabled="@(_completingId == job.Id)" Title="Mark as complete">
                                        @if (_completingId == job.Id)
                                        {
                                            <div class="w-4 h-4 border-2 border-gray-300 border-t-primary-600 rounded-full animate-spin"></div>
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                        }
                                    </IconButton>
                                }
                                else
                                {
                                    <IconButton OnClick="() => Reopen(job.Id)" Disabled="@(_completingId == job.Id)" Title="Re-open job">
                                        @if (_completingId == job.Id)
                                        {
                                            <div class="w-4 h-4 border-2 border-gray-300 border-t-primary-600 rounded-full animate-spin"></div>
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                            </svg>
                                        }
                                    </IconButton>
                                }
                                <IconButton Href="@($"jobs/{job.Id}")" Title="View">
                                    <ViewIcon />
                                </IconButton>
                                <IconButton Href="@($"jobs/{job.Id}/edit")" Title="Edit">
                                    <EditIcon />
                                </IconButton>
                                <IconButton OnClick="() => DeleteJobAsync(job)" Variant="IconButton.IconButtonVariant.Danger" Title="Delete">
                                    <DeleteIcon />
                                </IconButton>
                            </div>
                        </td>
                    </tr>
                </RowTemplate>
                <CardTemplate Context="job">
                    <div class="p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <a href="jobs/@job.Id" class="text-sm font-semibold text-gray-900 dark:text-slate-100 hover:underline">@job.Name</a>
                                    <span class="@JobStatusExtensions.Parse(job.Status).GetBadgeClass()">@JobStatusExtensions.Parse(job.Status).GetDisplayName()</span>
                                </div>
                                <div class="mt-1 text-sm text-gray-500 dark:text-slate-400 truncate">
                                    @job.ProjectName@(!string.IsNullOrEmpty(job.ClientName) ? $" • {job.ClientName}" : "")
                                </div>
                                @if (!string.IsNullOrEmpty(job.SectionName))
                                {
                                    <div class="mt-0.5 text-xs text-gray-500 dark:text-slate-400 truncate">@job.SectionName</div>
                                }
                                @if (job.EstimatedHours.HasValue || job.HourlyRateOverride.HasValue)
                                {
                                    <div class="mt-1 text-xs text-gray-500 dark:text-slate-400">
                                        @if (job.EstimatedHours.HasValue)
                                        {
                                            <span>@job.EstimatedHours.Value.ToString("N1") hrs</span>
                                        }
                                        @if (job.EstimatedHours.HasValue && job.HourlyRateOverride.HasValue)
                                        {
                                            <span> • </span>
                                        }
                                        @if (job.HourlyRateOverride.HasValue)
                                        {
                                            <span>$@job.HourlyRateOverride.Value.ToString("N2")/hr</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-gray-50 dark:border-[#2d2a4a] flex items-center justify-end gap-1">
                            @if (job.Status != "Completed")
                            {
                                <IconButton OnClick="() => MarkComplete(job.Id)" Disabled="@(_completingId == job.Id)" Title="Mark as complete">
                                    @if (_completingId == job.Id)
                                    {
                                        <div class="w-4 h-4 border-2 border-gray-300 border-t-primary-600 rounded-full animate-spin"></div>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    }
                                </IconButton>
                            }
                            else
                            {
                                <IconButton OnClick="() => Reopen(job.Id)" Disabled="@(_completingId == job.Id)" Title="Re-open job">
                                    @if (_completingId == job.Id)
                                    {
                                        <div class="w-4 h-4 border-2 border-gray-300 border-t-primary-600 rounded-full animate-spin"></div>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                        </svg>
                                    }
                                </IconButton>
                            }
                            <IconButton Href="@($"jobs/{job.Id}")" Title="View">
                                <ViewIcon />
                            </IconButton>
                            <IconButton Href="@($"jobs/{job.Id}/edit")" Title="Edit">
                                <EditIcon />
                            </IconButton>
                            <IconButton OnClick="() => DeleteJobAsync(job)" Variant="IconButton.IconButtonVariant.Danger" Title="Delete">
                                <DeleteIcon />
                            </IconButton>
                        </div>
                    </div>
                </CardTemplate>
            </DataTable>
        }
    </ChildContent>
</ListPageLayout>

@code {
    private PaginatedResponse<JobDto>? _response;
    private bool _isLoading = true;
    private string _searchTerm = "";
    private string _selectedStatus = "";
    private int _currentPage = 1;
    private int PageSize = 50;
    private Guid? _completingId;

    private bool HasActiveFilters => !string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_selectedStatus);

    protected override async Task OnInitializedAsync()
    {
        await LoadJobs();
    }

    private async Task LoadJobs()
    {
        _isLoading = true;
        try
        {
            _response = await GetJobsCall.Call(new GetJobs
            {
                Status = string.IsNullOrEmpty(_selectedStatus) ? null : _selectedStatus,
                Page = _currentPage,
                PageSize = PageSize,
                Search = _searchTerm
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading jobs: {ex.Message}");
            _response = new PaginatedResponse<JobDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        _currentPage = 1;
        await LoadJobs();
    }

    private async Task OnStatusChanged(string value)
    {
        _selectedStatus = value;
        await OnFilterChanged();
    }

    private async Task OnSearchChanged(string value)
    {
        _searchTerm = value;
        _currentPage = 1;
        await LoadJobs();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadJobs();
    }

    private async Task OnPageSizeChanged(int size)
    {
        PageSize = size;
        _currentPage = 1;
        await LoadJobs();
    }

    private async Task MarkComplete(Guid jobId)
    {
        _completingId = jobId;
        try
        {
            await MarkJobCompleteCall.Call(new MarkJobComplete { Id = jobId });
            await LoadJobs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking job complete: {ex.Message}");
        }
        finally
        {
            _completingId = null;
        }
    }

    private async Task Reopen(Guid jobId)
    {
        _completingId = jobId;
        try
        {
            await ReopenJobCall.Call(new ReopenJob { Id = jobId });
            await LoadJobs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error re-opening job: {ex.Message}");
        }
        finally
        {
            _completingId = null;
        }
    }

    private async Task DeleteJobAsync(JobDto job)
    {
        var confirmed = await ModalService.ShowAsync<bool>(
            typeof(DeleteConfirmationModal),
            "Delete Job",
            new Dictionary<string, object>
            {
                { "ItemName", job.Name },
                { "WarningMessage", "All tasks and time entries associated with this job will be permanently deleted." }
            },
            new ModalOptions { Size = ModalSize.Small });

        if (!confirmed) return;

        try
        {
            await DeleteJobCall.Call(new DeleteJob { Id = job.Id });
            await LoadJobs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting job: {ex.Message}");
        }
    }
}
