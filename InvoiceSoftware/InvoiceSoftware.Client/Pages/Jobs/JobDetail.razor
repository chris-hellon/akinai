@page "/jobs/{Id:guid}"

@inject ICall<GetJob, JobDetailDto> GetJobCall
@inject ICall<CreateJobTask, JobTaskDto> CreateJobTaskCall
@inject ICall<UpdateJobTask, JobTaskDto> UpdateJobTaskCall
@inject ICall<DeleteJobTask> DeleteJobTaskCall
@inject ICall<ToggleJobTaskComplete, JobTaskDto> ToggleJobTaskCall
@inject ICall<DeleteJob> DeleteJobCall
@inject ICall<MarkJobComplete> MarkJobCompleteCall
@inject ICall<ReopenJob> ReopenJobCall
@inject NavigationManager NavigationManager

<PageTitle>@(_job != null ? _job.Name : "Job") - InvoicePro</PageTitle>

<div class="space-y-6">
    <!-- Header with Breadcrumbs -->
    <PageHeader Title="@(_job != null ? _job.Name : "Job")"
                Description="@(_job != null ? $"{_job.ProjectName}{(!string.IsNullOrEmpty(_job.SectionName) ? $" / {_job.SectionName}" : "")} • {_job.ClientName}" : "")"
                ShowBackButton="true"
                BackUrl="jobs"
                Breadcrumbs="@_breadcrumbs">
        @if (_job != null)
        {
            <div class="flex items-center gap-3">
                @if (_job.Status != "Completed")
                {
                    <button @onclick="MarkComplete" disabled="@_isUpdatingStatus"
                            class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-white bg-primary-600 rounded-xl hover:bg-primary-700 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
                        @if (_isUpdatingStatus)
                        {
                            <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        }
                        Mark as complete
                    </button>
                }
                else
                {
                    <button @onclick="Reopen" disabled="@_isUpdatingStatus" class="btn-secondary">
                        @if (_isUpdatingStatus)
                        {
                            <div class="w-4 h-4 border-2 border-gray-300 border-t-gray-600 rounded-full animate-spin"></div>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                        }
                        Re-open
                    </button>
                }
                <a href="jobs/@Id/edit" class="btn-secondary">
                    <EditIcon />
                    Edit Job
                </a>
            </div>
        }
    </PageHeader>

    @if (_isLoading)
    {
        <div class="flex justify-center py-20">
            <div class="w-8 h-8 border-2 border-gray-200 border-t-primary-600 rounded-full animate-spin"></div>
        </div>
    }
    else if (_job == null)
    {
        <div class="card">
            <div class="text-center py-16 px-6">
                <div class="mx-auto w-16 h-16 rounded-lg flex items-center justify-center mb-4 bg-red-50">
                    <svg class="h-8 w-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-gray-900">Job not found</h3>
                <p class="mt-1 text-sm text-gray-500">The requested job could not be found.</p>
                <div class="mt-6">
                    <a href="jobs" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white rounded-xl transition-all duration-200 hover:shadow-lg active:scale-[0.98] brand-mark">
                        Back to Jobs
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Status & Priority -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Status -->
            <div class="card px-5 py-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 shrink-0">
                        @if (_job.Status == "Active")
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        }
                        else if (_job.Status == "OnHold")
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        }
                    </div>
                    <div class="min-w-0">
                        <div class="text-xs text-gray-500 dark:text-slate-400 uppercase tracking-wide font-medium">Status</div>
                        <div class="mt-1"><span class="@JobStatusExtensions.Parse(_job.Status).GetBadgeClass()">@JobStatusExtensions.Parse(_job.Status).GetDisplayName()</span></div>
                    </div>
                </div>
            </div>

            <!-- Priority -->
            <div class="card px-5 py-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 shrink-0">
                        @if (_job.Priority == "Urgent")
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                        }
                        else if (_job.Priority == "High")
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" /></svg>
                        }
                        else if (_job.Priority == "Medium")
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" /></svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
                        }
                    </div>
                    <div class="min-w-0">
                        <div class="text-xs text-gray-500 dark:text-slate-400 uppercase tracking-wide font-medium">Priority</div>
                        <div class="mt-1"><span class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-lg bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-300">@_job.Priority</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Job Info -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Details Card -->
                <div class="card overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-primary-50">
                                <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                            </div>
                            <h3 class="text-sm font-semibold text-gray-900">Job Details</h3>
                        </div>
                    </div>
                    <div class="p-6 space-y-4">
                        <!-- Description -->
                        <div>
                            <div class="text-xs text-gray-500 dark:text-slate-400 mb-1">Description</div>
                            @if (!string.IsNullOrEmpty(_job.Description))
                            {
                                <p class="text-sm text-gray-900 dark:text-slate-100">@_job.Description</p>
                            }
                            else
                            {
                                <p class="text-sm text-gray-400 dark:text-slate-500 italic">No description</p>
                            }
                        </div>

                        <!-- Dates -->
                        <div class="grid grid-cols-2 gap-4 pt-3 border-t border-gray-100 dark:border-slate-700">
                            <div>
                                <div class="text-xs text-gray-500 dark:text-slate-400 mb-1">Start Date</div>
                                @if (_job.StartDate.HasValue)
                                {
                                    <div class="text-sm font-medium text-gray-900 dark:text-slate-100">@_job.StartDate.Value.ToString("MMM d, yyyy")</div>
                                }
                                else
                                {
                                    <div class="text-sm text-gray-400 dark:text-slate-500 italic">Not set</div>
                                }
                            </div>
                            <div>
                                <div class="text-xs text-gray-500 dark:text-slate-400 mb-1">Due Date</div>
                                @if (_job.DueDate.HasValue)
                                {
                                    <div class="text-sm font-medium text-gray-900 dark:text-slate-100">@_job.DueDate.Value.ToString("MMM d, yyyy")</div>
                                }
                                else
                                {
                                    <div class="text-sm text-gray-400 dark:text-slate-500 italic">Not set</div>
                                }
                            </div>
                        </div>

                        <!-- Time & Estimates -->
                        <div class="grid grid-cols-2 gap-4 pt-3 border-t border-gray-100 dark:border-slate-700">
                            <div>
                                <div class="text-xs text-gray-500 dark:text-slate-400 mb-1">Estimated Hours</div>
                                @if (_job.EstimatedHours.HasValue)
                                {
                                    <div class="text-sm font-medium text-gray-900 dark:text-slate-100">@_job.EstimatedHours.Value.ToString("N1") hrs</div>
                                }
                                else
                                {
                                    <div class="text-sm text-gray-400 dark:text-slate-500 italic">Not set</div>
                                }
                            </div>
                            <div>
                                <div class="text-xs text-gray-500 dark:text-slate-400 mb-1">Time Tracked</div>
                                <div class="text-sm font-medium text-gray-900 dark:text-slate-100">@_job.TotalHours.ToString("N2") hrs</div>
                                @if (_job.BilledHours > 0)
                                {
                                    <div class="text-xs text-gray-500 dark:text-slate-400">@_job.BilledHours.ToString("N2") hrs billed</div>
                                }
                            </div>
                        </div>

                        <!-- Hourly Rate -->
                        <div class="pt-3 border-t border-gray-100 dark:border-slate-700">
                            <div class="text-xs text-gray-500 dark:text-slate-400 mb-1">Hourly Rate Override</div>
                            @if (_job.HourlyRateOverride.HasValue)
                            {
                                <div class="text-sm font-medium text-gray-900 dark:text-slate-100">$@_job.HourlyRateOverride.Value.ToString("N2")/hr</div>
                            }
                            else
                            {
                                <div class="text-sm text-gray-400 dark:text-slate-500 italic">Using project/client rate</div>
                            }
                        </div>

                        <!-- Project & Client Links -->
                        <div class="grid grid-cols-2 gap-4 pt-3 border-t border-gray-100 dark:border-slate-700">
                            <div>
                                <div class="text-xs text-gray-500 dark:text-slate-400 mb-1">Project</div>
                                <a href="projects/@_job.ProjectId" class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">@_job.ProjectName</a>
                            </div>
                            <div>
                                <div class="text-xs text-gray-500 dark:text-slate-400 mb-1">Client</div>
                                <a href="clients/@_job.ClientId" class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">@_job.ClientName</a>
                            </div>
                        </div>

                        <!-- Section -->
                        @if (!string.IsNullOrEmpty(_job.SectionName))
                        {
                            <div class="pt-3 border-t border-gray-100 dark:border-slate-700">
                                <div class="text-xs text-gray-500 dark:text-slate-400 mb-1">Section</div>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-sm font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300">@_job.SectionName</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Notes Card -->
                <div class="card overflow-hidden">
                    <div class="card-header">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-primary-50 dark:bg-primary-900/30">
                                <svg class="w-4 h-4 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </div>
                            <h3 class="text-sm font-semibold text-gray-900 dark:text-slate-100">Notes</h3>
                        </div>
                    </div>
                    <div class="p-6">
                        @if (!string.IsNullOrEmpty(_job.Notes))
                        {
                            <p class="text-sm text-gray-700 dark:text-slate-300 whitespace-pre-wrap">@_job.Notes</p>
                        }
                        else
                        {
                            <p class="text-sm text-gray-400 dark:text-slate-500 italic">No notes added</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Tasks -->
            <div class="lg:col-span-2">
                <div class="card overflow-hidden">
                    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-emerald-50">
                                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-semibold text-gray-900">Tasks</h3>
                                <p class="text-xs text-gray-500">
                                    @{
                                        var completedCount = _tasks.Count(t => t.IsComplete);
                                        var totalCount = _tasks.Count;
                                    }
                                    @completedCount of @totalCount completed
                                </p>
                            </div>
                        </div>
                        <button type="button" @onclick="ShowAddTaskForm" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-primary-600 hover:text-primary-700 hover:bg-primary-50 rounded-lg transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                            </svg>
                            Add Task
                        </button>
                    </div>

                    <!-- Progress Bar -->
                    @if (_tasks.Any())
                    {
                        <div class="px-6 py-3 bg-gray-50/30 border-b border-gray-100">
                            <div class="flex items-center gap-3">
                                <div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
                                    @{
                                        var progressPercent = _tasks.Count > 0 ? (double)_tasks.Count(t => t.IsComplete) / _tasks.Count * 100 : 0;
                                    }
                                    <div class="h-full bg-emerald-500 rounded-full transition-all duration-300" style="width: @progressPercent.ToString("N0")%"></div>
                                </div>
                                <span class="text-xs font-medium text-gray-500">@progressPercent.ToString("N0")%</span>
                            </div>
                        </div>
                    }

                    <!-- Add Task Form -->
                    @if (_showAddTaskForm)
                    {
                        <div class="px-6 py-4 border-b border-gray-100 bg-primary-50/30">
                            <div class="space-y-3">
                                <div>
                                    <input type="text" @bind="_newTaskTitle" @bind:event="oninput" placeholder="Task title..."
                                           class="form-control" />
                                </div>
                                <div>
                                    <textarea @bind="_newTaskDescription" placeholder="Description (optional)..." rows="2"
                                              class="form-control resize-none"></textarea>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button type="button" @onclick="AddTask" disabled="@(string.IsNullOrWhiteSpace(_newTaskTitle) || _isSavingTask)"
                                            class="inline-flex items-center px-4 py-2 text-sm font-medium text-white rounded-xl disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-200 hover:shadow-lg brand-mark">
                                        @if (_isSavingTask)
                                        {
                                            <svg class="animate-spin -ml-0.5 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24">
                                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                            </svg>
                                        }
                                        Add Task
                                    </button>
                                    <button type="button" @onclick="CancelAddTask"
                                            class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-700 hover:bg-gray-100 rounded-xl transition-colors">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Task List -->
                    @if (!_tasks.Any() && !_showAddTaskForm)
                    {
                        <div class="text-center py-12 px-6">
                            <div class="mx-auto w-14 h-14 rounded-lg flex items-center justify-center mb-4 bg-emerald-50">
                                <svg class="h-7 w-7 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <h3 class="text-base font-semibold text-gray-900">No tasks yet</h3>
                            <p class="mt-1 text-sm text-gray-500">Break down this job into smaller tasks to track progress.</p>
                            <div class="mt-4">
                                <button type="button" @onclick="ShowAddTaskForm" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-primary-600 hover:text-primary-700 hover:bg-primary-50 rounded-lg transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                                    </svg>
                                    Add First Task
                                </button>
                            </div>
                        </div>
                    }
                    else if (_tasks.Any())
                    {
                        <div class="divide-y divide-gray-100">
                            @foreach (var task in _tasks.OrderBy(t => t.IsComplete).ThenBy(t => t.Order))
                            {
                                <div class="flex items-start gap-4 px-6 py-4 hover:bg-gray-50/50 transition-colors group @(task.IsComplete ? "bg-gray-50/30" : "")">
                                    <!-- Checkbox -->
                                    <button type="button" @onclick="() => ToggleTaskComplete(task)"
                                            class="mt-0.5 shrink-0 w-5 h-5 rounded-md border-2 transition-all duration-200 flex items-center justify-center @(task.IsComplete ? "bg-emerald-500 border-emerald-500" : "border-gray-300 hover:border-primary-400")">
                                        @if (task.IsComplete)
                                        {
                                            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                            </svg>
                                        }
                                    </button>

                                    <!-- Task Content -->
                                    @if (_editingTaskId == task.Id)
                                    {
                                        <div class="flex-1 space-y-2">
                                            <input type="text" @bind="_editTaskTitle" @bind:event="oninput"
                                                   class="form-control" />
                                            <textarea @bind="_editTaskDescription" rows="2"
                                                      class="form-control resize-none"></textarea>
                                            <div class="flex items-center gap-2">
                                                <button type="button" @onclick="SaveEditTask" disabled="@(string.IsNullOrWhiteSpace(_editTaskTitle) || _isSavingTask)"
                                                        class="px-3 py-1.5 text-xs font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-lg disabled:opacity-50 transition-colors">
                                                    Save
                                                </button>
                                                <button type="button" @onclick="CancelEditTask"
                                                        class="px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex-1 min-w-0">
                                            <div class="text-sm font-medium @(task.IsComplete ? "text-gray-400 line-through" : "text-gray-900")">@task.Title</div>
                                            @if (!string.IsNullOrEmpty(task.Description))
                                            {
                                                <p class="text-sm @(task.IsComplete ? "text-gray-400" : "text-gray-500") mt-0.5">@task.Description</p>
                                            }
                                            @if (task.CompletedAt.HasValue)
                                            {
                                                <p class="text-xs text-gray-400 mt-1">Completed @task.CompletedAt.Value.ToString("MMM d, yyyy 'at' h:mm tt")</p>
                                            }
                                        </div>
                                    }

                                    <!-- Actions -->
                                    @if (_editingTaskId != task.Id)
                                    {
                                        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                            <button type="button" @onclick="() => StartEditTask(task)"
                                                    class="p-1.5 text-gray-400 hover:text-primary-600 hover:bg-primary-50 rounded-lg transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                            </button>
                                            <button type="button" @onclick="() => DeleteTask(task)"
                                                    class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <DangerZone EntityLabel="Job" ItemName="@_job.Name"
                    WarningMessage="This permanently deletes the job and all its tasks and time entries. This cannot be undone."
                    OnConfirmed="PerformDelete" />
    }
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private JobDetailDto? _job;
    private List<JobTaskDto> _tasks = [];
    private bool _isLoading = true;
    private bool _isDeleting;
    private bool _isUpdatingStatus;
    private List<PageHeader.BreadcrumbItem> _breadcrumbs = [];

    // Add task form
    private bool _showAddTaskForm;
    private string _newTaskTitle = "";
    private string? _newTaskDescription;
    private bool _isSavingTask;

    // Edit task form
    private Guid? _editingTaskId;
    private string _editTaskTitle = "";
    private string? _editTaskDescription;

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs =
        [
            new PageHeader.BreadcrumbItem("Jobs", "/jobs"),
            new PageHeader.BreadcrumbItem("Job Details")
        ];

        await LoadJob();
    }

    private async Task LoadJob()
    {
        try
        {
            _job = await GetJobCall.Call(new GetJob { Id = Id });
            if (_job != null)
            {
                _breadcrumbs[1] = new PageHeader.BreadcrumbItem(_job.Name);
                _tasks = _job.Tasks.ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading job: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowAddTaskForm()
    {
        _showAddTaskForm = true;
        _newTaskTitle = "";
        _newTaskDescription = null;
    }

    private void CancelAddTask()
    {
        _showAddTaskForm = false;
        _newTaskTitle = "";
        _newTaskDescription = null;
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(_newTaskTitle)) return;

        _isSavingTask = true;
        try
        {
            var result = await CreateJobTaskCall.Call(new CreateJobTask
            {
                JobId = Id,
                Title = _newTaskTitle.Trim(),
                Description = _newTaskDescription?.Trim()
            });

            if (result != null)
            {
                _tasks.Add(result);
                _showAddTaskForm = false;
                _newTaskTitle = "";
                _newTaskDescription = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding task: {ex.Message}");
        }
        finally
        {
            _isSavingTask = false;
        }
    }

    private void StartEditTask(JobTaskDto task)
    {
        _editingTaskId = task.Id;
        _editTaskTitle = task.Title;
        _editTaskDescription = task.Description;
    }

    private void CancelEditTask()
    {
        _editingTaskId = null;
        _editTaskTitle = "";
        _editTaskDescription = null;
    }

    private async Task SaveEditTask()
    {
        if (_editingTaskId == null || string.IsNullOrWhiteSpace(_editTaskTitle)) return;

        _isSavingTask = true;
        try
        {
            var result = await UpdateJobTaskCall.Call(new UpdateJobTask
            {
                JobId = Id,
                TaskId = _editingTaskId.Value,
                Title = _editTaskTitle.Trim(),
                Description = _editTaskDescription?.Trim()
            });

            if (result != null)
            {
                var index = _tasks.FindIndex(t => t.Id == _editingTaskId.Value);
                if (index >= 0)
                {
                    _tasks[index] = result;
                }
                _editingTaskId = null;
                _editTaskTitle = "";
                _editTaskDescription = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating task: {ex.Message}");
        }
        finally
        {
            _isSavingTask = false;
        }
    }

    private async Task ToggleTaskComplete(JobTaskDto task)
    {
        try
        {
            var result = await ToggleJobTaskCall.Call(new ToggleJobTaskComplete
            {
                JobId = Id,
                TaskId = task.Id
            });

            if (result != null)
            {
                var index = _tasks.FindIndex(t => t.Id == task.Id);
                if (index >= 0)
                {
                    _tasks[index] = result;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling task: {ex.Message}");
        }
    }

    private async Task DeleteTask(JobTaskDto task)
    {
        try
        {
            await DeleteJobTaskCall.Call(new DeleteJobTask
            {
                JobId = Id,
                TaskId = task.Id
            });

            _tasks.RemoveAll(t => t.Id == task.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting task: {ex.Message}");
        }
    }

    private async Task MarkComplete()
    {
        _isUpdatingStatus = true;
        try
        {
            await MarkJobCompleteCall.Call(new MarkJobComplete { Id = Id });
            await LoadJob();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking job complete: {ex.Message}");
        }
        finally
        {
            _isUpdatingStatus = false;
        }
    }

    private async Task Reopen()
    {
        _isUpdatingStatus = true;
        try
        {
            await ReopenJobCall.Call(new ReopenJob { Id = Id });
            await LoadJob();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error re-opening job: {ex.Message}");
        }
        finally
        {
            _isUpdatingStatus = false;
        }
    }

    private async Task PerformDelete()
    {
        try
        {
            await DeleteJobCall.Call(new DeleteJob { Id = Id });
            NavigationManager.NavigateTo("jobs");
        }
        catch (Exception)
        {
            // ignored
        }
    }
}
