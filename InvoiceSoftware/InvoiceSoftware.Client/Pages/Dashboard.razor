    private static bool IsOverdue(InvoiceSummaryDto i)
        => i.Status is "Sent" or "Overdue" && i.DueDate < DateOnly.FromDateTime(DateTime.Today);

    private static string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "morning";
        if (hour < 17) return "afternoon";
        return "evening";
    }

    private string Money(decimal v)
        => $"{CurrencyExtensions.GetSymbol(Reporting.Currency)}{FormatExact(v)}";

    private string AmountShort(decimal v) => Money(v);

    private static string AmountCur(decimal v, string currency)
        => $"{CurrencyExtensions.GetSymbol(currency)}{FormatExact(v)}";

    // Exact amount, never abbreviated: whole pounds show no decimals, otherwise two.
    private static string FormatExact(decimal v)
        => v == Math.Truncate(v) ? v.ToString("N0") : v.ToString("N2");

    private static string ShortLabel(string label)
        => label.Length >= 3 ? label[..3] : label;

    private static (string color, string label) StatusDisplay(string status, bool isOverdue)
    {
        if (isOverdue) return ("#b23b30", "Overdue");
        return status switch
        {
            "Paid" => ("#0f7a5a", "Paid"),
            "Sent" => ("#2b6d7d", "Sent"),
            "Draft" => ("#9a917f", "Draft"),
            "Overdue" => ("#b23b30", "Overdue"),
            "Void" => ("#9a917f", "Void"),
            _ => ("#57503f", status),
        };
    }

    private static string TimeAgo(DateTime utc)
    {
        var span = DateTime.UtcNow - DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        if (span.TotalSeconds < 60) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("d MMM");
    }

