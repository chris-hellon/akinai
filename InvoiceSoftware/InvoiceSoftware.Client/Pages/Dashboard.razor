    };

    private string BuildRevenueChart()
    {
        var pts = _revenue?.DataPoints;
        if (pts is null || pts.Count < 2) return "";

        double W = 720, H = 200, top = 14;
        var vals = pts.Select(p => (double)p.Revenue).ToList();
        var max = vals.Max() * 1.14;
        if (max <= 0) max = 1;

        double X(int i) => Math.Round(i / (double)(pts.Count - 1) * W, 1);
        double Y(double v) => Math.Round(H - (v / max) * (H - top), 1);
        var P = vals.Select((v, i) => (x: X(i), y: Y(v))).ToList();

        var sb = new System.Text.StringBuilder();
        sb.Append($"M {P[0].x.ToString(Ci)} {P[0].y.ToString(Ci)}");
        for (int i = 0; i < P.Count - 1; i++)
        {
            var p0 = i > 0 ? P[i - 1] : P[i];
            var p1 = P[i];
            var p2 = P[i + 1];
            var p3 = i + 2 < P.Count ? P[i + 2] : p2;
            var c1x = p1.x + (p2.x - p0.x) / 6;
            var c1y = p1.y + (p2.y - p0.y) / 6;
            var c2x = p2.x - (p3.x - p1.x) / 6;
            var c2y = p2.y - (p3.y - p1.y) / 6;
            sb.Append($" C {c1x.ToString("F1", Ci)} {c1y.ToString("F1", Ci)}, {c2x.ToString("F1", Ci)} {c2y.ToString("F1", Ci)}, {p2.x.ToString(Ci)} {p2.y.ToString(Ci)}");
        }
        var line = sb.ToString();
        var area = $"{line} L {W.ToString(Ci)} {H.ToString(Ci)} L 0 {H.ToString(Ci)} Z";
        var last = P[^1];

        var grid = string.Concat(new[] { 1, 2, 3 }.Select(g =>
        {
            var gy = (H - (g / 4.0) * (H - top)).ToString("F1", Ci);
            return $"<line x1='0' y1='{gy}' x2='{W.ToString(Ci)}' y2='{gy}' style='stroke:var(--bds);stroke-width:1'/>";
        }));

        return $@"<svg viewBox='0 0 720 200' preserveAspectRatio='none' style='width:100%;height:200px;display:block'>
<defs><linearGradient id='drevg' x1='0' y1='0' x2='0' y2='1'><stop offset='0%' style='stop-color:var(--acc);stop-opacity:.2'/><stop offset='100%' style='stop-color:var(--acc);stop-opacity:0'/></linearGradient></defs>
{grid}
<path d='{area}' style='fill:url(#drevg)'/>
<path d='{line}' vector-effect='non-scaling-stroke' style='fill:none;stroke:var(--acc);stroke-width:2.5;stroke-linejoin:round;stroke-linecap:round;stroke-dasharray:2400;stroke-dashoffset:2400;animation:ddraw 1.4s ease .2s forwards'/>
<line x1='{last.x.ToString(Ci)}' y1='{last.y.ToString(Ci)}' x2='{last.x.ToString(Ci)}' y2='200' stroke-dasharray='3 3' style='stroke:var(--acc);stroke-width:1;opacity:.35'/>
<circle cx='{last.x.ToString(Ci)}' cy='{last.y.ToString(Ci)}' r='4.5' style='fill:var(--acc);stroke:var(--elev);stroke-width:2'/>
</svg>";
    }

    private string BuildCashBars()
    {
        var pts = _revenue?.DataPoints;
        if (pts is null || pts.Count < 2) return "";
        var vals = pts.Select(p => (double)p.Revenue).ToList();
        var max = vals.Max() * 1.08;
        if (max <= 0) max = 1;

        var sb = new System.Text.StringBuilder();
        sb.Append("<div style='display:flex;align-items:flex-end;gap:8px;height:200px'>");
        for (int i = 0; i < vals.Count; i++)
        {
            var hpct = (vals[i] / max * 100).ToString("F1", Ci);
            var isLast = i == vals.Count - 1;
            var col = isLast ? "var(--acc2)" : "var(--acc)";
            var delay = (0.05 + i * 0.04).ToString("F2", Ci);
            sb.Append($"<div style='flex:1;display:flex;flex-direction:column;justify-content:flex-end;height:100%'><div style='height:{hpct}%;background:{col};border-radius:4px 4px 0 0;transform-origin:bottom;animation:dgrow .6s cubic-bezier(.2,.7,.2,1) {delay}s both'></div></div>");
        }
        sb.Append("</div>");
        return sb.ToString();
    }

