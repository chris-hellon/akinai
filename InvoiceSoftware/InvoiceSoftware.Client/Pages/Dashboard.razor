@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@inject ICall<GetDashboardMetrics, DashboardMetricsDto> GetMetricsCall
@inject ICall<GetRevenueChart, RevenueChartDataDto> GetRevenueChartCall
@inject ICall<GetInvoiceStatusBreakdown, InvoiceStatusBreakdownDto> GetStatusBreakdownCall
@inject ICall<GetCashFlowForecast, CashFlowForecastDto> GetCashFlowCall
@inject ICall<GetInvoices, PaginatedResponse<InvoiceSummaryDto>> GetInvoicesCall
@inject ICall<GetEstimates, PaginatedResponse<EstimateSummaryDto>> GetEstimatesCall
@inject ICall<GetTopClients, List<TopClientDto>> GetTopClientsCall
@inject ICall<GetBusinessProfile, BusinessProfileDto?> GetBusinessProfileCall
@inject NotificationState Activity
@inject ReportingCurrencyState Reporting

<PageTitle>Dashboard - Akinai</PageTitle>

<div class="dash">
    <!-- Header -->
    <div class="fx ac jb fu" style="flex-wrap:wrap;gap:12px">
        <div>
            <div class="eyb">@DateTime.Now.ToString("dddd · d MMMM yyyy")</div>
            <div class="h1">Good @GetGreeting()</div>
        </div>
        <div class="fx ac gap12">
            <a class="btng" href="estimates/new">New estimate</a>
            <a class="btnp" href="invoices/new"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M12 5v14M5 12h14"></path></svg>Create invoice</a>
        </div>
    </div>

    <!-- Stat strip -->
    <div class="strip fu" style="animation-delay:.04s">
        <div class="cell">
            <div class="clab">Paid · this month</div>
            <div class="cnum tnum" style="color:var(--ok)">@Money(_metrics?.PaidRevenue ?? 0)</div>
            <div class="cnote">
                @if (_paidTrendPct is { } pct)
                {
                    <span class="trend @(pct >= 0 ? "tup" : "tdn")">@(pct >= 0 ? "▲" : "▼") @Math.Abs(pct).ToString("0.#")%</span> <span> vs last month</span>
                }
                else
                {
                    <span>Revenue collected</span>
                }
            </div>
        </div>
        <div class="cell">
            <div class="clab">Outstanding</div>
            <div class="cnum tnum">@Money(_metrics?.OutstandingAmount ?? 0)</div>
            <div class="cnote tnum">@(_metrics?.OutstandingInvoices ?? 0) invoices awaiting</div>
        </div>
        <div class="cell">
            <div class="clab">Overdue</div>
            <div class="cnum tnum" style="color:var(--bad)">@Money(_metrics?.OverdueAmount ?? 0)</div>
            <div class="cnote tnum">@(_metrics?.OverdueInvoices ?? 0) past due · chase below</div>
        </div>
        <div class="cell">
            <div class="clab">Unbilled time</div>
            <div class="cnum tnum">@((_metrics?.UnbilledHours ?? 0).ToString("0.#"))<span style="font-size:16px;color:var(--tt)">h</span></div>
            <div class="cnote">≈ @Money(_metrics?.UnbilledAmount ?? 0) ready to bill</div>
        </div>
    </div>

    <!-- Revenue + Collect -->
    <div class="grid16">
        <div class="dcard lift fu" style="animation-delay:.08s">
            <div class="chd">
                <div><div class="ctitle">Revenue</div><div class="clab" style="margin-top:4px">Trailing 12 months</div></div>
                <div class="fx ac gap12">
                    <SegmentedControl Options="_chartViews" Value="@_chartView" ValueChanged="@(v => _chartView = v)" />
                    <span class="tnum" style="font:600 20px 'Shippori Mincho',sans-serif">@Money(_revenueTotal)</span>
                </div>
            </div>
            <div style="padding:10px 12px 6px">
                @if (_revenue is { DataPoints.Count: > 1 })
                {
                    <ApexChart TItem="RevenueDataPoint" @ref="_revenueChart" @key="_chartView"
                               Options="@(_chartView == "pnl" ? _pnlOptions : _chartView == "cash" ? _cashOptions : _chartOptions)" Height="235">
                        @if (_chartView == "pnl")
                        {
                            <ApexPointSeries TItem="RevenueDataPoint" Items="_revenue.DataPoints" Name="Revenue" SeriesType="SeriesType.Bar" XValue="@(p => p.Label)" YValue="@(p => p.Revenue)" />
                            <ApexPointSeries TItem="RevenueDataPoint" Items="_revenue.DataPoints" Name="Expenses" SeriesType="SeriesType.Bar" XValue="@(p => p.Label)" YValue="@(p => p.Expenses)" />
                            <ApexPointSeries TItem="RevenueDataPoint" Items="_revenue.DataPoints" Name="Profit" SeriesType="SeriesType.Bar" XValue="@(p => p.Label)" YValue="@(p => p.Profit)" />
                        }
                        else if (_chartView == "cash")
                        {
                            <ApexPointSeries TItem="RevenueDataPoint" Items="_revenue.DataPoints" Name="Collected" SeriesType="SeriesType.Bar" XValue="@(p => p.Label)" YValue="@(p => p.Revenue)" />
                        }
                        else
                        {
                            <ApexPointSeries TItem="RevenueDataPoint" Items="_revenue.DataPoints" Name="Revenue" SeriesType="SeriesType.Area" XValue="@(p => p.Label)" YValue="@(p => p.Revenue)" />
                        }
                    </ApexChart>
                }
                else
                {
                    <div class="fx ac" style="justify-content:center;height:235px;color:var(--tt);font-size:13px">No revenue data yet</div>
                }
            </div>
        </div>

        <!-- Collect faster — driven by the user's real payment settings -->
        <div class="dcard lift fu" style="animation-delay:.12s;display:flex;flex-direction:column">
            <div class="chd">
                <div class="ctitle">Collect faster</div>
                @if (_hasVietQr)
                {
                    <span class="pill" style="color:var(--acc);background:var(--acc50)"><span class="dot" style="background:var(--acc)"></span>VietQR</span>
                }
                else if (_hasAnyPayment)
                {
                    <span class="pill" style="color:var(--acc);background:var(--acc50)"><span class="dot" style="background:var(--acc)"></span>Enabled</span>
                }
            </div>

            @if (!_paymentsLoaded)
            {
                <div style="padding:16px 18px;height:120px"></div>
            }
            else if (!_hasAnyPayment)
            {
                <div class="setup">
                    <div class="fx ac gap12">
                        <span class="setup-ico"><svg width="19" height="19" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 10h18M3 10l2-5h14l2 5M5 10v9a1 1 0 001 1h12a1 1 0 001-1v-9"></path></svg></span>
                        <div>
                            <div style="font:600 14px 'Zen Kaku Gothic New',sans-serif;color:var(--tp)">No payment methods yet</div>
                            <div style="font:400 12.5px 'Zen Kaku Gothic New',sans-serif;color:var(--ts);margin-top:2px">Add bank details, PayPal, Wise, Revolut or VietQR so clients can pay you.</div>
                        </div>
                    </div>
                    <a class="btnp" href="settings/business" style="margin-top:14px;width:100%;justify-content:center">Set up payments</a>
                </div>
            }
            else if (_hasVietQr)
            {
                <div style="padding:16px 18px;display:flex;gap:15px;align-items:center;flex-wrap:wrap">
                    <span class="qrtile">
                        @if (!string.IsNullOrEmpty(_vietQrImageUrl))
                        {
                            <img src="@_vietQrImageUrl" alt="VietQR" style="width:100%;height:100%;object-fit:contain" />
                        }
                        else
                        {
                            @((MarkupString)QrSvg)
                        }
                    </span>
                    <div style="flex:1;min-width:130px">
                        <div class="clab">Attach to any VND invoice</div>
                        <div style="font:600 14.5px 'Zen Kaku Gothic New',sans-serif;margin-top:7px;line-height:1.35;color:var(--tp)">Scan &amp; pay from any Vietnamese bank</div>
                        @if (!string.IsNullOrWhiteSpace(_vietQrDetail))
                        {
                            <div class="mono" style="font-size:10.5px;margin-top:8px;letter-spacing:.03em;color:var(--tt)">@_vietQrDetail</div>
                        }
                    </div>
                </div>
                @if (_otherRails.Count > 0)
                {
                    <div style="padding:0 18px 12px">
                        <div class="clab">Also enabled</div>
                        <div class="fx ac gap8" style="flex-wrap:wrap;margin-top:9px">
                            @foreach (var rail in _otherRails)
                            {
                                <span class="chip">@rail</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="padding:16px 18px">
                    <div class="clab">Your clients can pay via</div>
                    <div class="fx ac gap8" style="flex-wrap:wrap;margin-top:11px">
                        @foreach (var rail in _enabledRails)
                        {
                            <span class="chip">@rail</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_bankDetail))
                    {
                        <div class="mono" style="font-size:10.5px;margin-top:12px;letter-spacing:.03em;color:var(--tt)">@_bankDetail</div>
                    }
                    <a class="link" href="settings/business" style="display:inline-block;margin-top:12px">Manage payment methods →</a>
                </div>
            }

            <a href="estimates" class="fx ac jb" style="margin-top:auto;border-top:1px solid var(--bds);padding:12px 18px;text-decoration:none">
                <span class="clab">Pending estimates</span>
                <span class="fx ac gap8"><span class="tnum" style="font:600 17px 'Shippori Mincho',sans-serif;color:var(--tp)">@_pendingEstimates.Count</span>@if (_pendingEstimates.Count > 0){<span class="pill" style="color:var(--violet);background:var(--violet50)">@AmountShort(_pendingValue) value</span>}</span>
            </a>
        </div>
    </div>

    <!-- Money charts: invoice status · collection rate · cash-flow forecast -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px">
        <!-- Invoice status donut -->
        <div class="dcard lift fu" style="animation-delay:.10s">
            <div class="chd"><div class="ctitle">Invoice status</div><div class="clab">By amount</div></div>
            <div style="padding:6px 10px 12px">
                @if (_statusSlices.Count > 0)
                {
                    <ApexChart TItem="StatusSlice" Options="_donutOptions" Height="250">
                        <ApexPointSeries TItem="StatusSlice" Items="_statusSlices" Name="Amount" SeriesType="SeriesType.Donut" XValue="@(s => s.Label)" YValue="@(s => s.Amount)" />
                    </ApexChart>
                }
                else
                {
                    <div class="fx ac" style="justify-content:center;height:250px;color:var(--tt);font-size:13px">No invoices yet</div>
                }
            </div>
        </div>

        <!-- Collection rate gauge -->
        <div class="dcard lift fu" style="animation-delay:.12s">
            <div class="chd"><div class="ctitle">Collection rate</div><div class="clab">Paid of billed</div></div>
            <div style="padding:6px 10px 12px">
                @if (_hasBilling)
                {
                    var frac = Math.Clamp(_collectionRate / 100.0, 0, 1);
                    var circ = 2 * Math.PI * 80;
                    var track = circ * 0.75;                       // 270° arc, gap at the bottom
                    var inv = System.Globalization.CultureInfo.InvariantCulture;
                    var trackDash = $"{track.ToString(inv)} {(circ - track).ToString(inv)}";
                    var prog = track * frac;                       // grows from the arc's start tip
                    var progDash = $"{prog.ToString(inv)} {(circ - prog).ToString(inv)}";
                    <div class="fx ac" style="position:relative;justify-content:center;height:250px">
                        <svg viewBox="0 0 200 200" style="width:220px;max-width:100%;height:100%;transform:rotate(135deg)" role="img" aria-label="Collection rate @Math.Round(_collectionRate)%">
                            <circle cx="100" cy="100" r="80" fill="none" stroke="rgba(148,163,184,0.18)" stroke-width="16" stroke-linecap="round"
                                    stroke-dasharray="@trackDash" />
                            <circle cx="100" cy="100" r="80" fill="none" stroke="var(--acc)" stroke-width="16" stroke-linecap="round"
                                    stroke-dasharray="@progDash" style="transition:stroke-dasharray .6s ease" />
                        </svg>
                        <div style="position:absolute;text-align:center;transform:translateY(6px)">
                            <div style="font:700 34px 'Shippori Mincho',sans-serif;color:var(--acc);line-height:1">@Math.Round(_collectionRate)%</div>
                            <div style="font:500 12px 'Zen Kaku Gothic New',sans-serif;color:var(--tt);margin-top:6px;letter-spacing:.04em">COLLECTED</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="fx ac" style="justify-content:center;height:250px;color:var(--tt);font-size:13px">No billing yet</div>
                }
            </div>
        </div>

        <!-- Cash-flow forecast -->
        <div class="dcard lift fu" style="animation-delay:.14s">
            <div class="chd"><div class="ctitle">Cash-flow forecast</div><div class="clab">Expected in · next 6 mo</div></div>
            <div style="padding:6px 10px 12px">
                @if (_cashFlow is { DataPoints.Count: > 0 } && _cashFlow.DataPoints.Any(p => p.ExpectedInflow > 0))
                {
                    <ApexChart TItem="CashFlowPointDto" Options="_cashFlowOptions" Height="250">
                        <ApexPointSeries TItem="CashFlowPointDto" Items="_cashFlow.DataPoints" Name="Expected in" SeriesType="SeriesType.Bar" XValue="@(p => p.Date.ToString("MMM"))" YValue="@(p => p.ExpectedInflow)" />
                    </ApexChart>
                }
                else
                {
                    <div class="fx ac" style="justify-content:center;height:250px;color:var(--tt);font-size:13px">Nothing due soon</div>
                }
            </div>
        </div>
    </div>

    <!-- Chase overdue + Activity -->
    <div class="grid16">
        <div class="dcard lift fu" style="animation-delay:.16s">
            <div class="chd">
                <div class="fx ac gap8"><div class="ctitle">Chase overdue</div>@if (_overdue.Count > 0){<span class="pill" style="color:var(--bad);background:#f7e4e2">@_overdue.Count · @AmountShort(_overdueValue)</span>}</div>
                @if (_overdue.Count > 0){<a class="dlink" href="invoices?status=Overdue">View all</a>}
            </div>
            @if (_overdue.Count == 0)
            {
                <div class="fx ac" style="justify-content:center;padding:34px;color:var(--tt);font-size:13px">Nothing overdue — nicely done.</div>
            }
            else
            {
                @foreach (var inv in _overdue.Take(4))
                {
                    var days = Math.Max(0, DateOnly.FromDateTime(DateTime.Today).DayNumber - inv.DueDate.DayNumber);
                    var initial = string.IsNullOrEmpty(inv.ClientName) ? "?" : inv.ClientName[..1].ToUpper();
                    <div class="chaserow">
                        <span class="cav" style="background:#f7e4e2;color:var(--bad)">@initial</span>
                        <div class="f1">
                            <div style="font:600 13.5px 'Zen Kaku Gothic New',sans-serif;color:var(--tp)">@inv.ClientName</div>
                            <div class="mono" style="font-size:11px;margin-top:2px;color:var(--tt)">@inv.InvoiceNumber · due @inv.DueDate.ToString("d MMM")</div>
                        </div>
                        <span class="od">@days days</span>
                        <div class="tnum" style="font:600 14px 'Zen Kaku Gothic New',sans-serif;width:84px;text-align:right;color:var(--tp)">@AmountCur(inv.Total, inv.Currency)</div>
                        <a class="remind" href="invoices/@inv.Id">Remind</a>
                    </div>
                }
            }
        </div>

        <div class="dcard lift fu" style="animation-delay:.2s">
            <div class="chd"><div class="ctitle">Activity</div>@if (Activity.RealtimeConnected){<span class="clab" style="color:var(--ok)">● Live</span>}else{<span class="clab">Recent</span>}</div>
            @if (_activityLoaded && Activity.Items.Count == 0)
            {
                <div class="fx ac" style="justify-content:center;padding:34px;color:var(--tt);font-size:13px">No activity yet.</div>
            }
            else
            {
                @foreach (var n in Activity.Items.Take(5))
                {
                    var (bg, fg, icon) = ActVisual(n.Type);
                    <div class="actrow">
                        <span class="actico" style="background:@bg;color:@fg">@((MarkupString)icon)</span>
                        <div class="f1">
                            <div class="actt">@n.Title</div>
                            <div class="actm">@n.Message · @TimeAgo(n.CreatedAt)</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Recent invoices + Top clients -->
    <div class="grid16">
        <div class="dcard lift fu" style="animation-delay:.24s">
            <div class="chd"><div class="ctitle">Recent invoices</div><a class="dlink" href="invoices">View all</a></div>
            @if (_recent.Count == 0)
            {
                <div class="fx ac" style="justify-content:center;padding:34px;color:var(--tt);font-size:13px">No invoices yet. <a class="dlink" href="invoices/new" style="margin-left:6px">Create one</a></div>
            }
            else
            {
                @foreach (var inv in _recent.Take(5))
                {
                    var (sc, sl) = StatusDisplay(inv.Status, IsOverdue(inv));
                    <a class="mrow" href="invoices/@inv.Id">
                        <div class="mono" style="font-size:13px;width:92px">@inv.InvoiceNumber</div>
                        <div class="f1" style="font-size:13.5px">@inv.ClientName</div>
                        <span class="badge" style="color:@sc;width:78px"><span class="dot" style="background:@sc"></span>@sl</span>
                        <div class="tnum" style="font:600 13.5px 'Zen Kaku Gothic New',sans-serif;width:90px;text-align:right">@AmountCur(inv.Total, inv.Currency)</div>
                    </a>
                }
            }
        </div>

        <div class="dcard lift fu" style="animation-delay:.28s">
            <div class="chd"><div class="ctitle">Top clients</div><span class="clab">By revenue</span></div>
            @if (_topClients.Count == 0)
            {
                <div class="fx ac" style="justify-content:center;padding:34px;color:var(--tt);font-size:13px">No client revenue yet.</div>
            }
            else
            {
                var top = _topClients.Max(c => c.TotalRevenue);
                @foreach (var c in _topClients.Take(4))
                {
                    var barPct = top > 0 ? (int)Math.Round((double)(c.TotalRevenue / top) * 100) : 0;
                    var initial = string.IsNullOrEmpty(c.ClientName) ? "?" : c.ClientName[..1].ToUpper();
                    <a class="clientrow" href="clients/@c.ClientId">
                        <span class="cav" style="background:var(--acc50);color:var(--acc)">@initial</span>
                        <div class="f1">
                            <div class="fx ac jb"><span style="font:600 13px 'Zen Kaku Gothic New',sans-serif">@c.ClientName</span><span class="tnum" style="font:600 13px 'Zen Kaku Gothic New',sans-serif">@AmountCur(c.TotalRevenue, c.Currency)</span></div>
                            <div class="cbar" style="width:@(Math.Max(6, barPct))%"></div>
                        </div>
                    </a>
                }
            }
        </div>
    </div>
</div>

@code {
    private DashboardMetricsDto? _metrics;
    private RevenueChartDataDto? _revenue;
    private decimal _revenueTotal;
    private double? _paidTrendPct;
    private string _chartView = "trend";
    private readonly (string Value, string Label)[] _chartViews =
    {
        ("trend", "Trend"),
        ("cash", "Cash flow"),
        ("pnl", "P&L")
    };
    private ApexChart<RevenueDataPoint>? _revenueChart;
    private ApexChartOptions<RevenueDataPoint> _chartOptions = new();
    private ApexChartOptions<RevenueDataPoint> _pnlOptions = new();
    private ApexChartOptions<RevenueDataPoint> _cashOptions = new();

    private InvoiceStatusBreakdownDto? _statusBreakdown;
    private CashFlowForecastDto? _cashFlow;
    private ApexChartOptions<StatusSlice> _donutOptions = new();
    private ApexChartOptions<CashFlowPointDto> _cashFlowOptions = new();
    private List<StatusSlice> _statusSlices = new();
    private double _collectionRate;
    private bool _hasBilling;

    public record StatusSlice(string Label, decimal Amount);
    private List<InvoiceSummaryDto> _recent = new();
    private List<InvoiceSummaryDto> _overdue = new();
    private decimal _overdueValue;
    private List<EstimateSummaryDto> _pendingEstimates = new();
    private decimal _pendingValue;
    private List<TopClientDto> _topClients = new();
    private bool _activityLoaded;

    // Payment settings (drive the Collect card)
    private BusinessProfileDto? _profile;
    private bool _paymentsLoaded;
    private bool _hasVietQr;
    private bool _hasAnyPayment;
    private string? _vietQrDetail;
    private string? _vietQrImageUrl;
    private string? _bankDetail;
    private List<string> _enabledRails = new();
    private List<string> _otherRails = new();

    protected override async Task OnInitializedAsync()
    {
        Activity.OnChange += OnActivityChanged;
        Reporting.OnChange += OnReportingChanged;
        await Reporting.InitializeAsync();

        try
        {
            var metricsTask = GetMetricsCall.Call(new GetDashboardMetrics { Period = "month", ReportingCurrency = Reporting.Currency });
            var revenueTask = GetRevenueChartCall.Call(new GetRevenueChart { Period = "month", ReportingCurrency = Reporting.Currency });
            var statusTask = GetStatusBreakdownCall.Call(new GetInvoiceStatusBreakdown { ReportingCurrency = Reporting.Currency });
            var cashFlowTask = GetCashFlowCall.Call(new GetCashFlowForecast { Months = 6, ReportingCurrency = Reporting.Currency });
            var invoicesTask = GetInvoicesCall.Call(new GetInvoices { PageSize = 30 });
            var estimatesTask = GetEstimatesCall.Call(new GetEstimates { PageSize = 20 });
            var topClientsTask = GetTopClientsCall.Call(new GetTopClients { Count = 4 });
            var profileTask = GetBusinessProfileCall.Call(new GetBusinessProfile());

            await Task.WhenAll(metricsTask, revenueTask, statusTask, cashFlowTask, invoicesTask, estimatesTask, topClientsTask, profileTask);

            _metrics = await metricsTask;

            _revenue = await revenueTask;
            _revenueTotal = _revenue?.DataPoints?.Sum(p => p.Revenue) ?? 0;
            RecomputeTrend();
            BuildChartOptions();

            _statusBreakdown = await statusTask;
            _cashFlow = await cashFlowTask;
            BuildAuxCharts();

            var invoices = (await invoicesTask)?.Items?.ToList() ?? new();
            _recent = invoices.OrderByDescending(i => i.IssueDate).ToList();
            _overdue = invoices.Where(IsOverdue).OrderBy(i => i.DueDate).ToList();
            _overdueValue = _overdue.Sum(i => i.Total);

            var estimates = (await estimatesTask)?.Items?.ToList() ?? new();
            _pendingEstimates = estimates
                .Where(e => e.Status is not ("Accepted" or "Declined" or "Expired" or "Converted"))
                .OrderByDescending(e => e.EstimateDate)
                .ToList();
            _pendingValue = _pendingEstimates.Sum(e => e.Total);

            _topClients = await topClientsTask ?? new();

            _profile = await profileTask;
            BuildPaymentState();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard load error: {ex.Message}");
        }

        _paymentsLoaded = true;

        await Activity.InitializeAsync();
        _activityLoaded = true;
    }

    private void BuildPaymentState()
    {
        var p = _profile;
        var hasBank = !string.IsNullOrWhiteSpace(p?.BankAccountNumber) || !string.IsNullOrWhiteSpace(p?.BankIban);
        var hasPaypal = !string.IsNullOrWhiteSpace(p?.PayPalMeUsername);
        var hasWise = !string.IsNullOrWhiteSpace(p?.WiseEmail);
        var hasRevolut = !string.IsNullOrWhiteSpace(p?.RevolutUsername);
        _hasVietQr = !string.IsNullOrWhiteSpace(p?.VietQrBankCode);
        _hasAnyPayment = _hasVietQr || hasBank || hasPaypal || hasWise || hasRevolut;

        _enabledRails = new();
        if (hasBank) _enabledRails.Add("Bank transfer");
        if (hasPaypal) _enabledRails.Add("PayPal");
        if (hasWise) _enabledRails.Add("Wise");
        if (hasRevolut) _enabledRails.Add("Revolut");

        // "Also enabled" list when VietQR is the headline
        _otherRails = new(_enabledRails);

        if (_hasVietQr)
        {
            var acct = p?.BankAccountNumber;
            _vietQrDetail = string.IsNullOrWhiteSpace(acct)
                ? p?.VietQrBankCode
                : $"{p?.VietQrBankCode} · {acct}";

            // Real static VietQR for the user's account (no amount) — the same
            // img.vietqr.io endpoint the invoice view/PDF use.
            if (!string.IsNullOrWhiteSpace(acct))
            {
                var name = Uri.EscapeDataString(p?.BankAccountName ?? p?.CompanyName ?? "");
                _vietQrImageUrl = $"https://img.vietqr.io/image/{p!.VietQrBankCode}-{acct}-compact.png?accountName={name}";
            }
        }

        if (hasBank)
        {
            var bank = p?.BankName;
            var acct = p?.BankAccountNumber ?? p?.BankIban;
            _bankDetail = string.IsNullOrWhiteSpace(bank) ? acct : $"{bank} · {acct}";
        }
    }

    private void OnActivityChanged() => InvokeAsync(StateHasChanged);

    private void OnReportingChanged() => _ = ReloadFinancialsAsync();

    private async Task ReloadFinancialsAsync()
    {
        try
        {
            var metricsTask = GetMetricsCall.Call(new GetDashboardMetrics { Period = "month", ReportingCurrency = Reporting.Currency });
            var revenueTask = GetRevenueChartCall.Call(new GetRevenueChart { Period = "month", ReportingCurrency = Reporting.Currency });
            var statusTask = GetStatusBreakdownCall.Call(new GetInvoiceStatusBreakdown { ReportingCurrency = Reporting.Currency });
            var cashFlowTask = GetCashFlowCall.Call(new GetCashFlowForecast { Months = 6, ReportingCurrency = Reporting.Currency });
            await Task.WhenAll(metricsTask, revenueTask, statusTask, cashFlowTask);
            _metrics = await metricsTask;
            _revenue = await revenueTask;
            _revenueTotal = _revenue?.DataPoints?.Sum(p => p.Revenue) ?? 0;
            RecomputeTrend();
            BuildChartOptions();
            _statusBreakdown = await statusTask;
            _cashFlow = await cashFlowTask;
            BuildAuxCharts();
        }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    private void RecomputeTrend()
    {
        _paidTrendPct = null;
        var points = _revenue?.DataPoints;
        if (points is { Count: >= 2 })
        {
            var last = points[^1].Revenue;
            var prev = points[^2].Revenue;
            if (prev > 0) _paidTrendPct = (double)((last - prev) / prev * 100);
        }
    }

