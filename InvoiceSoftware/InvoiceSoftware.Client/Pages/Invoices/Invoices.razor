@page "/invoices"

@inject ICall<GetInvoices, PaginatedResponse<InvoiceSummaryDto>> GetInvoicesCall
@inject ICall<GetInvoice, InvoiceDetailDto> GetInvoiceCall
@inject ICall<GetInvoicePdf, byte[]> GetInvoicePdfCall
@inject ICall<DeleteInvoice> DeleteInvoiceCall
@inject ICall<MarkInvoicePaid> MarkInvoicePaidCall
@inject ICall<SendInvoice> SendInvoiceCall
@inject NavigationManager Navigation

<PageTitle>Invoices - Akinai</PageTitle>

<InvoiceLimitBanner />

<ListPageLayout Title="Invoices"
                Description="Manage and track your invoices."
                ActionUrl="invoices/new"
                ActionText="New Invoice"
                SearchPlaceholder="Search invoices..."
                SearchValue="@_searchTerm"
                SearchValueChanged="OnSearchChanged"
                Breadcrumbs="@(new List<PageHeader.BreadcrumbItem> { new("Time & Billing", "/time-billing"), new("Invoices") })">
    <Filters>
        <Select TValue="string" Value="_selectedStatus" ValueChanged="OnStatusChanged" Searchable="false" Class="w-full sm:w-44"
                Options="@(new List<SelectOption<string>>
                {
                    new("", "All Status"),
                    new("Draft", "Draft"),
                    new("Sent", "Sent"),
                    new("Paid", "Paid"),
                    new("Overdue", "Overdue"),
                    new("Void", "Void")
                })" />
    </Filters>
    <ChildContent>
        @if (_isLoading)
        {
            <LoadingTable Rows="5" Columns="7" />
        }
        else if (_response == null || !_response.Items.Any())
        {
            <EmptyState Title="No invoices found"
                        Message="@(HasActiveFilters ? "No invoices match your filters. Try adjusting your search." : "Get started by creating your first invoice.")"
                        IconType="EmptyState.EmptyStateIcon.Document"
                        ActionUrl="@(HasActiveFilters ? null : "invoices/new")"
                        ActionText="@(HasActiveFilters ? null : "New Invoice")" />
        }
        else
        {
            <DataTable TItem="InvoiceSummaryDto"
                       Items="_response.Items"
                       CurrentPage="_response.Page"
                       TotalCount="_response.TotalCount"
                       PageSize="_response.PageSize"
                       ItemName="invoices"
                       OnPageChanged="OnPageChanged"
                       OnPageSizeChanged="OnPageSizeChanged">
                <HeaderTemplate>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Invoice</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Client</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Date</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Due</th>
                    <th scope="col" class="px-6 py-4 text-right text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Amount</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                    <th scope="col" class="relative px-6 py-4"><span class="sr-only">Actions</span></th>
                </HeaderTemplate>
                <RowTemplate Context="invoice">
                    @{ var isOverdue = invoice.Status is "Sent" or "Overdue" && invoice.DueDate < DateOnly.FromDateTime(DateTime.Today); }
                    <tr class="group hover:bg-gray-50/50 dark:hover:bg-[#2f2924]/50 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-gray-900 dark:text-slate-100">@invoice.InvoiceNumber</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-gray-900 dark:text-slate-100">@invoice.ClientName</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-gray-900 dark:text-slate-100">@invoice.IssueDate.ToString("MMM d, yyyy")</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm @(isOverdue ? "text-red-600 dark:text-red-400 font-medium" : "text-gray-900 dark:text-slate-100")">
                                @invoice.DueDate.ToString("MMM d, yyyy")
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            <div class="text-sm font-semibold text-gray-900 dark:text-slate-100">@CurrencyExtensions.GetSymbol(invoice.Currency)@invoice.Total.ToString("N2")</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="@InvoiceStatusExtensions.Parse(invoice.Status).GetBadgeClass()">@invoice.Status</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            <div class="flex items-center justify-end gap-2" @onclick:stopPropagation="true">
                                <IconButton Href="@($"invoices/{invoice.Id}")" Title="View">
                                    <ViewIcon />
                                </IconButton>
                                @if (invoice.Status == "Draft")
                                {
                                    <IconButton Href="@($"invoices/{invoice.Id}/edit")" Title="Edit">
                                        <EditIcon />
                                    </IconButton>
                                    <IconButton OnClick="() => SendInvoiceAsync(invoice.Id)" Disabled="@(_sendingId == invoice.Id)" Title="Send invoice">
                                        @if (_sendingId == invoice.Id)
                                        {
                                            <div class="w-4 h-4 border-2 border-gray-300 border-t-primary-600 rounded-full animate-spin"></div>
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                                            </svg>
                                        }
                                    </IconButton>
                                }
                                @if (invoice.Status != "Paid" && invoice.Status != "Void")
                                {
                                    <IconButton OnClick="() => MarkPaid(invoice.Id, invoice.InvoiceNumber)" Disabled="@(_markingPaidId == invoice.Id)" Title="Mark as paid">
                                        @if (_markingPaidId == invoice.Id)
                                        {
                                            <div class="w-4 h-4 border-2 border-gray-300 border-t-primary-600 rounded-full animate-spin"></div>
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                        }
                                    </IconButton>
                                }
                                <IconButton OnClick="() => DownloadPdf(invoice.Id, invoice.InvoiceNumber)" Title="Download PDF">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                </IconButton>
                                <IconButton OnClick="() => DeleteInvoice(invoice.Id, invoice.InvoiceNumber)" Variant="IconButton.IconButtonVariant.Danger" Title="Delete">
                                    <DeleteIcon />
                                </IconButton>
                            </div>
                        </td>
                    </tr>
                </RowTemplate>
                <CardTemplate Context="invoice">
                    @{ var cardOverdue = invoice.Status is "Sent" or "Overdue" && invoice.DueDate < DateOnly.FromDateTime(DateTime.Today); }
                    <div class="p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <a href="invoices/@invoice.Id" class="text-sm font-semibold text-gray-900 dark:text-slate-100 hover:underline">@invoice.InvoiceNumber</a>
                                    <span class="@InvoiceStatusExtensions.Parse(invoice.Status).GetBadgeClass()">@invoice.Status</span>
                                </div>
                                <div class="mt-1 text-sm text-gray-500 dark:text-slate-400 truncate">@invoice.ClientName</div>
                            </div>
                            <div class="text-right shrink-0">
                                <div class="text-base font-semibold text-gray-900 dark:text-slate-100">@CurrencyExtensions.GetSymbol(invoice.Currency)@invoice.Total.ToString("N2")</div>
                                <div class="mt-1 text-xs @(cardOverdue ? "text-red-600 dark:text-red-400 font-medium" : "text-gray-500 dark:text-slate-400")">Due @invoice.DueDate.ToString("MMM d, yyyy")</div>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-gray-50 dark:border-[#2f2924] flex items-center justify-end gap-1">
                            <IconButton Href="@($"invoices/{invoice.Id}")" Title="View">
                                <ViewIcon />
                            </IconButton>
                            @if (invoice.Status == "Draft")
                            {
                                <IconButton Href="@($"invoices/{invoice.Id}/edit")" Title="Edit">
                                    <EditIcon />
                                </IconButton>
                                <IconButton OnClick="() => SendInvoiceAsync(invoice.Id)" Disabled="@(_sendingId == invoice.Id)" Title="Send invoice">
                                    @if (_sendingId == invoice.Id)
                                    {
                                        <div class="w-4 h-4 border-2 border-gray-300 border-t-primary-600 rounded-full animate-spin"></div>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                                        </svg>
                                    }
                                </IconButton>
                            }
                            @if (invoice.Status != "Paid" && invoice.Status != "Void")
                            {
                                <IconButton OnClick="() => MarkPaid(invoice.Id, invoice.InvoiceNumber)" Disabled="@(_markingPaidId == invoice.Id)" Title="Mark as paid">
                                    @if (_markingPaidId == invoice.Id)
                                    {
                                        <div class="w-4 h-4 border-2 border-gray-300 border-t-primary-600 rounded-full animate-spin"></div>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                    }
                                </IconButton>
                            }
                            <IconButton OnClick="() => DownloadPdf(invoice.Id, invoice.InvoiceNumber)" Title="Download PDF">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            </IconButton>
                            <IconButton OnClick="() => DeleteInvoice(invoice.Id, invoice.InvoiceNumber)" Variant="IconButton.IconButtonVariant.Danger" Title="Delete">
                                <DeleteIcon />
                            </IconButton>
                        </div>
                    </div>
                </CardTemplate>
            </DataTable>
        }
    </ChildContent>
</ListPageLayout>

@code {
    private PaginatedResponse<InvoiceSummaryDto>? _response;
    private bool _isLoading = true;
    private string _searchTerm = "";
    private string _selectedStatus = "";
    private int _currentPage = 1;
    private int PageSize = 50;
    private Guid? _markingPaidId;
    private Guid? _sendingId;

    private bool _loadedOnce;

    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchQuery { get; set; }

    private bool HasActiveFilters => !string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_selectedStatus);

    // Runs on first render and whenever the ?search= query changes (e.g. from the header search).
    protected override async Task OnParametersSetAsync()
    {
        var incoming = SearchQuery ?? "";
        if (!_loadedOnce || incoming != _searchTerm)
        {
            _loadedOnce = true;
            _searchTerm = incoming;
            _currentPage = 1;
            await LoadInvoices();
        }
    }

    private async Task LoadInvoices()
    {
        _isLoading = true;
        try
        {
            _response = await GetInvoicesCall.Call(new GetInvoices
            {
                Status = string.IsNullOrEmpty(_selectedStatus) ? null : _selectedStatus,
                Page = _currentPage,
                PageSize = PageSize,
                Search = _searchTerm
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading invoices: {ex.Message}");
            _response = new PaginatedResponse<InvoiceSummaryDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        _currentPage = 1;
        await LoadInvoices();
    }

    private async Task OnStatusChanged(string value)
    {
        _selectedStatus = value;
        await OnFilterChanged();
    }

    private async Task OnSearchChanged(string value)
    {
        _searchTerm = value;
        _currentPage = 1;
        await LoadInvoices();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadInvoices();
    }

    private async Task OnPageSizeChanged(int size)
    {
        PageSize = size;
        _currentPage = 1;
        await LoadInvoices();
    }

    private async Task DownloadPdf(Guid invoiceId, string invoiceNumber)
    {
        try
        {
            var bytes = await GetInvoicePdfCall.Call(new GetInvoicePdf { Id = invoiceId });
            if (bytes is { Length: > 0 })
            {
                var base64 = Convert.ToBase64String(bytes);
                var fileName = $"Invoice-{invoiceNumber}.pdf";
                await Js.InvokeVoidAsync("downloadFile", fileName, base64, "application/pdf");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading PDF: {ex.Message}");
        }
    }

    private async Task SendInvoiceAsync(Guid invoiceId)
    {
        _sendingId = invoiceId;
        try
        {
            // Fetch the full invoice for the client email + public link the send modal needs.
            var invoice = await GetInvoiceCall.Call(new GetInvoice { Id = invoiceId });
            if (invoice == null) return;

            var modalParams = new Dictionary<string, object>
            {
                { "InvoiceId", invoice.Id },
                { "InvoiceNumber", invoice.InvoiceNumber },
                { "ClientName", invoice.ClientName },
                { "ClientEmail", invoice.ClientEmail ?? "" },
                { "Currency", invoice.Currency },
                { "Amount", invoice.Total },
                { "DueDate", invoice.DueDate }
            };
            if (invoice.PublicAccessToken.HasValue)
                modalParams.Add("PublicAccessToken", invoice.PublicAccessToken.Value);

            var result = await ModalService.ShowAsync<SendInvoiceResult?>(
                typeof(SendInvoiceModal),
                "Send Invoice",
                modalParams,
                new ModalOptions { Size = ModalSize.Medium });

            if (result == null) return; // cancelled

            await SendInvoiceCall.Call(new SendInvoice
            {
                Id = invoiceId,
                Email = result.Email,
                Subject = result.Subject,
                Body = result.Body
            });
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending invoice: {ex.Message}");
        }
        finally
        {
            _sendingId = null;
        }
    }

    private async Task MarkPaid(Guid invoiceId, string invoiceNumber)
    {
        _markingPaidId = invoiceId;
        try
        {
            await MarkInvoicePaidCall.Call(new MarkInvoicePaid { Id = invoiceId, PaidDate = DateOnly.FromDateTime(DateTime.Today) });
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking invoice as paid: {ex.Message}");
        }
        finally
        {
            _markingPaidId = null;
        }
    }

    private async Task DeleteInvoice(Guid invoiceId, string invoiceNumber)
    {
        var confirmed = await ModalService.ShowAsync<bool>(
            typeof(DeleteConfirmationModal),
            "Delete Invoice",
            new Dictionary<string, object>
            {
                { "ItemName", $"Invoice {invoiceNumber}" },
                { "WarningMessage", "This will permanently delete this invoice. This action cannot be undone." }
            },
            new ModalOptions { Size = ModalSize.Small });

        if (!confirmed) return;

        try
        {
            await DeleteInvoiceCall.Call(new DeleteInvoice { Id = invoiceId });
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting invoice: {ex.Message}");
        }
    }
}
