@inherits LayoutComponentBase

@layout MainLayout

@*
    Account pages are laid out exactly like the rest of the app: the section nav
    lives in the app sidebar (NavMenu → Account), each page supplies its own
    heading, and each page cards its own content.

    This layout therefore adds nothing but the standard vertical rhythm. In
    particular it sets no max-width — the content area is already inset by
    MainLayout's padding, and constraining it again left a dead band down the
    right-hand side of every account page.
*@

<div class="space-y-6">
    @Body
</div>
