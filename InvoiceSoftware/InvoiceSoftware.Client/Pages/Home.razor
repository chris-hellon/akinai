    private static readonly Step[] Steps =
    {
        new("1", "Create your account", "Sign up in seconds — no credit card needed. Add your business details and you're ready to go."),
        new("2", "Add clients & items", "Set up your clients and reusable products or services once, then reuse them across every invoice."),
        new("3", "Send & get paid", "Send professional invoices, track their status, and watch the payments roll in on time."),
