@page "/"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>InvoicePro - Professional Invoicing for Freelancers & Small Businesses</PageTitle>

<div class="min-h-screen bg-white dark:bg-[#0f0e1a] text-gray-900 dark:text-slate-100 antialiased overflow-x-hidden">

    <!-- ===================== NAVBAR ===================== -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-white/80 dark:bg-[#0f0e1a]/80 border-b border-gray-100 dark:border-[#2d2a4a]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo -->
                <a href="" class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 brand-mark">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <span class="text-lg font-bold tracking-tight">
                        Invoice<span class="text-primary-600 dark:text-primary-400">Pro</span>
                    </span>
                </a>

                <!-- Desktop nav links -->
                <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600 dark:text-slate-300">
                    <a href="#features" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Features</a>
                    <a href="#how" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">How it works</a>
                    <a href="#pricing" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Pricing</a>
                </nav>

                <!-- Actions -->
                <div class="flex items-center gap-2 sm:gap-3">
                    <a href="account/login" class="hidden sm:inline-flex btn-secondary">Sign in</a>
                    <a href="account/register" class="btn-primary">Get started</a>
                </div>
            </div>
        </div>
    </header>

    <!-- ===================== HERO ===================== -->
    <section class="relative">
        <!-- Decorative gradient glows -->
        <div class="pointer-events-none absolute inset-0 overflow-hidden">
            <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-primary-400/20 dark:bg-primary-600/20 blur-3xl"></div>
            <div class="absolute top-10 right-0 w-96 h-96 rounded-full bg-primary-400/20 dark:bg-primary-600/20 blur-3xl"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 sm:pt-28 sm:pb-24 text-center">
            <!-- Badge -->
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium bg-primary-50 dark:bg-primary-950/50 text-primary-700 dark:text-primary-300 border border-primary-100 dark:border-primary-900/50">
                <span class="w-1.5 h-1.5 rounded-full bg-primary-500"></span>
                Invoicing made effortless
            </span>

            <h1 class="mt-6 text-4xl sm:text-6xl font-bold tracking-tight leading-[1.1]">
                Get paid faster with
                <span class="bg-gradient-to-r from-primary-600 to-primary-600 dark:from-primary-400 dark:to-primary-400 bg-clip-text text-transparent">professional invoices</span>
            </h1>

            <p class="mt-6 max-w-2xl mx-auto text-lg sm:text-xl text-gray-600 dark:text-slate-300 leading-relaxed">
                Create polished invoices and estimates, track expenses, and manage clients — all in one place.
                Everything freelancers and small businesses need to run the money side of things.
            </p>

            <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3">
                <a href="account/register" class="btn-primary w-full sm:w-auto text-base px-6 py-3">
                    Start for free
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </a>
                <a href="account/login" class="btn-secondary w-full sm:w-auto text-base px-6 py-3">Sign in</a>
            </div>

            <p class="mt-4 text-sm text-gray-500 dark:text-slate-400">No credit card required · Free to get started</p>

            <!-- Stats band -->
            <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-3xl mx-auto">
                <div>
                    <div class="text-3xl font-bold text-gray-900 dark:text-white">10k+</div>
                    <div class="mt-1 text-sm text-gray-500 dark:text-slate-400">Invoices sent</div>
                </div>
                <div>
                    <div class="text-3xl font-bold text-gray-900 dark:text-white">2 min</div>
                    <div class="mt-1 text-sm text-gray-500 dark:text-slate-400">To first invoice</div>
                </div>
                <div>
                    <div class="text-3xl font-bold text-gray-900 dark:text-white">98%</div>
                    <div class="mt-1 text-sm text-gray-500 dark:text-slate-400">Paid on time</div>
                </div>
                <div>
                    <div class="text-3xl font-bold text-gray-900 dark:text-white">24/7</div>
                    <div class="mt-1 text-sm text-gray-500 dark:text-slate-400">Access anywhere</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================== FEATURES ===================== -->
    <section id="features" class="py-20 sm:py-24 bg-gray-50 dark:bg-[#0a0912] border-y border-gray-100 dark:border-[#2d2a4a]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-2xl mx-auto text-center">
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Everything you need to run your business</h2>
                <p class="mt-4 text-lg text-gray-600 dark:text-slate-300">From the first estimate to the final payment, InvoicePro keeps your finances organized.</p>
            </div>

            <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var feature in Features)
                {
                    <div class="card p-6 hover:shadow-lg transition-shadow duration-200">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center bg-gradient-to-br @feature.IconBg">
                            <svg class="w-6 h-6 @feature.IconColor" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@feature.IconPath" />
                            </svg>
                        </div>
                        <h3 class="mt-5 text-lg font-semibold">@feature.Title</h3>
                        <p class="mt-2 text-gray-600 dark:text-slate-400 leading-relaxed">@feature.Description</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ===================== HOW IT WORKS ===================== -->
    <section id="how" class="py-20 sm:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-2xl mx-auto text-center">
                <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Up and running in minutes</h2>
                <p class="mt-4 text-lg text-gray-600 dark:text-slate-300">Three simple steps from sign-up to getting paid.</p>
            </div>

            <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-8">
                @foreach (var step in Steps)
                {
                    <div class="relative text-center">
                        <div class="mx-auto w-14 h-14 rounded-lg flex items-center justify-center text-white text-xl font-bold brand-mark">
                            @step.Number
                        </div>
                        <h3 class="mt-5 text-lg font-semibold">@step.Title</h3>
                        <p class="mt-2 text-gray-600 dark:text-slate-400 leading-relaxed">@step.Description</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ===================== CTA BAND ===================== -->
    <section id="pricing" class="py-16 sm:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="relative overflow-hidden rounded-xl px-6 py-14 sm:px-16 sm:py-20 text-center"
                 style="background: linear-gradient(135deg, #0a3238 0%, #0c4a53 50%, #0c4a53 100%);">
                <div class="pointer-events-none absolute -top-16 -right-16 w-72 h-72 rounded-full bg-white/10 blur-3xl"></div>
                <div class="pointer-events-none absolute -bottom-20 -left-10 w-72 h-72 rounded-full bg-primary-400/20 blur-3xl"></div>

                <div class="relative">
                    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">Ready to get paid faster?</h2>
                    <p class="mt-4 max-w-xl mx-auto text-lg text-primary-100">Join thousands of freelancers and small businesses who invoice smarter with InvoicePro.</p>
                    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
                        <a href="account/register"
                           class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-base font-semibold text-primary-700 bg-white hover:bg-primary-50 transition-colors shadow-lg">
                            Create your free account
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                            </svg>
                        </a>
                        <a href="account/login"
                           class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl text-base font-semibold text-white border border-white/30 hover:bg-white/10 transition-colors">
                            Sign in
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================== FOOTER ===================== -->
    <footer class="border-t border-gray-100 dark:border-[#2d2a4a]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 bg-primary-600">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <span class="text-base font-bold tracking-tight">
                    Invoice<span class="text-primary-600 dark:text-primary-400">Pro</span>
                </span>
            </div>
            <p class="text-sm text-gray-500 dark:text-slate-400">&copy; @DateTime.Now.Year InvoicePro. All rights reserved.</p>
        </div>
    </footer>
</div>

@code {
