            "from-emerald-50 to-emerald-100 dark:from-emerald-950/50 dark:to-emerald-900/50", "text-emerald-600 dark:text-emerald-400"),
        new("Client Management",
            "Keep all your clients, their details, and their full billing history in one tidy, searchable place.",
            "M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-3-6.65",
            "from-amber-50 to-amber-100 dark:from-amber-950/50 dark:to-amber-900/50", "text-amber-600 dark:text-amber-400"),
        new("Recurring Billing",
