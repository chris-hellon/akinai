@page "/account/lockout"

<PageTitle>Locked Out - Akinai</PageTitle>

<div class="w-full max-w-md">
    <!-- Card -->
    <div class="bg-white rounded-lg shadow-xl border border-gray-100 p-8">
        <!-- Logo & Header -->
        <div class="text-center">
            <div class="mx-auto w-14 h-14 rounded-lg flex items-center justify-center mb-4 bg-red-50 border border-red-100">
                <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-gray-900 tracking-tight mb-1">
                Akinai<span class="text-gray-400 text-sm font-medium ml-1.5">あきない</span>
            </h2>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Account locked</h1>
            <p class="text-gray-500 text-sm mt-2">
                This account has been temporarily locked due to too many failed login attempts.
            </p>
        </div>

        <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded-xl">
            <p class="text-amber-700 text-sm text-center">
                Please try again later, or contact support if you need immediate assistance.
            </p>
        </div>

        <!-- Back to Login -->
        <div class="mt-8 text-center">
            <a href="account/login" class="text-sm font-medium text-primary-600 hover:text-primary-700 inline-flex items-center transition-colors">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Back to sign in
            </a>
        </div>
    </div>
</div>
