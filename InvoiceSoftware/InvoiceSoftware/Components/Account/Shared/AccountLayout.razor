@inherits LayoutComponentBase

<div class="acct">
    <!-- Left: brand panel (hidden on small screens) -->
    <aside class="acct-brand">
        <div class="acct-brand-in">
            <a class="acct-logo" href="/">
                <span class="acct-hanko">商</span>
                <span class="acct-word">Akin<span class="wm-ai">ai</span><span class="jp">あきない</span></span>
            </a>

            <div class="acct-pitch">
                <span class="acct-eyebrow"><span class="kj">請</span>For freelancers &amp; studios</span>
                <h2 class="acct-h">Bill in their language.<br><span class="thin">Get paid on</span> <span class="em">their rail.</span></h2>
                <p class="acct-lead">Eight languages, every payment rail, VietQR built in — and a bank-statement importer that lines each transaction up against your open invoices.</p>
                <ul class="acct-list">
                    <li>Track time and turn it straight into invoices</li>
                    <li>Estimates your clients accept &amp; sign online</li>
                    <li>Statements reconciled against open invoices</li>
                </ul>
            </div>

            <div class="acct-foot">商い · AKINAI — for people who work across borders</div>
        </div>
        <span class="acct-tate">請求</span>
    </aside>

    <!-- Right: form -->
    <main class="acct-main">
        <a class="acct-mobilelogo" href="/">
            <span class="acct-hanko sm">商</span>
            <span class="acct-word sm">Akin<span class="wm-ai">ai</span></span>
        </a>
        <div class="acct-form">
            @Body
        </div>
    </main>
</div>
